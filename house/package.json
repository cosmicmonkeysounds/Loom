    "typecheck": "tsc --noEmit",
    "goldens": "tsx scripts/goldens.ts",
    "sync": "tsx scripts/sync.ts"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "three": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.0"
  }
}
