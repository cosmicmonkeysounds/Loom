{
  // Typecheck only (evening.ts runs as plain TypeScript under Node's
  // --experimental-strip-types): core/node_modules/.bin/tsc -p scripts/sim
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "typeRoots": ["../../core/node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // The specs' Playwright types (playwright.d.ts): the editor's install.
    "paths": { "@playwright/test": ["../../editor/node_modules/@playwright/test"] }
  },
  "include": ["evening.ts", "heart.ts", "trabolta-load.ts", "heart.spec.ts", "browser.spec.ts", "playwright.config.ts", "playwright.d.ts", "lib/*.ts", "test/*.ts"]
}
