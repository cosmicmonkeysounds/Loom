# Copy to `.env` next to docker-compose.yml and fill in. Never commit `.env`.

# Password for the bundled Postgres (any long random string):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs author session cookies — the control plane refuses to boot in
# production without a real one:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The Loom app's public origin, exactly as typed into the browser.
#   No domain yet:  http://YOUR_VPS_IP
#   With a domain:  https://app.mapsandducks.com
LOOM_BASE_URL=http://YOUR_VPS_IP

# The release the stack runs (images loom-server:<tag> + loom-proxy:<tag>).
# Leave it to deploy/release.sh, which sets it per release and keeps the
# previous tag for deploy/rollback.sh. Blank/absent = "latest".
# LOOM_TAG=

# What Caddy listens as for the Loom app (play at /, editor at /edit/).
#   No domain yet:  :80                    (plain HTTP)
#   With a domain:  app.mapsandducks.com   (automatic HTTPS via Let's Encrypt)
SITE_ADDRESS=:80

# What Caddy listens as for the party-invitation page.
#   No domain yet:  :8081                  (unmapped port — effectively off)
#   With a domain:  mapsandducks.com       (automatic HTTPS via Let's Encrypt)
INVITE_ADDRESS=:8081

# --- Email (share invites) ---------------------------------------------
# Sharing a project emails the collaborator a join link. Set ONE transport;
# with neither, invites are logged in `docker compose logs loom` and the
# Share dialog shows the owner a link to pass along by hand.
#   Any SMTP provider (Fastmail, Gmail app password, Mailgun, Postmark, …):
#     LOOM_SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
#   Or Resend (https://resend.com — free tier, verify your domain there):
#     LOOM_RESEND_API_KEY=re_xxxxxxxx
LOOM_SMTP_URL=
LOOM_RESEND_API_KEY=
# The From: address — must be one your provider lets you send as.
LOOM_MAIL_FROM=Loom <no-reply@YOUR_DOMAIN>

# --- The webmaster outbox ------------------------------------------------
# A password-gated page at https://<SITE_ADDRESS>/webmaster/ for sending
# mail as LOOM_WEBMASTER_FROM through Resend (needs LOOM_RESEND_API_KEY).
# Off while the password is blank. Use a long one: `openssl rand -base64 18`.
LOOM_WEBMASTER_PASSWORD=
LOOM_WEBMASTER_FROM=Webmaster <webmaster@YOUR_DOMAIN>
# Where replies go (blank = the From address).
LOOM_WEBMASTER_REPLY_TO=

# --- Door-rush throttles ------------------------------------------------
# Each takes <max> (per the default window) or <max>/<seconds>. Blank keeps
# the default. Per-IP limits: at the party every phone on the house Wi-Fi
# reaches the VPS from ONE public IP, so raise these for the night, e.g.
#   LOOM_RL_RESOLVE=600  LOOM_RL_REGISTER=400  LOOM_RL_LOGIN_FAILURES=100/300
# /api/resolve-code per IP (default 30/60)
LOOM_RL_RESOLVE=
# guest registrations per IP (default 20/60)
LOOM_RL_REGISTER=
# wrong passcodes per IP before the lockout (default 10/300)
LOOM_RL_LOGIN_FAILURES=
# wrong codex codes per GUEST, then 429 + nothing journaled (default 8/60)
LOOM_RL_REDEEM_MISSES=
# widget answers per GUEST (cards, polls, 📝 File a fact), then 429 (default 20/60)
LOOM_RL_WIDGETS=

# --- The wall terminals' voice ------------------------------------------
# `/terminal/` (and the TV, view=tv) speaks Trabolta's lines. The stack
# bundles Kokoro-FastAPI (CPU) as the `kokoro` service, and a blank
# LOOM_TTS_URL points the server at it — nothing to set. Other choices:
#   LOOM_TTS_URL=off                         the tablets' own built-in voices
#   LOOM_TTS_URL=http://<laptop-ip>:8880/v1  a Kokoro on another machine
#   LOOM_TTS_URL=https://api.openai.com/v1  LOOM_TTS_API_KEY=sk-…
#              LOOM_TTS_MODEL=tts-1  LOOM_TTS_VOICE=onyx
LOOM_TTS_URL=
LOOM_TTS_API_KEY=
LOOM_TTS_MODEL=kokoro
LOOM_TTS_VOICE=am_michael
# Cores the bundled Kokoro may use — (VPS cores - 1), so the event server
# always keeps one. Docker refuses a value above the machine's core count.
KOKORO_CPUS=1
# The Kokoro image (multi-arch; the default is pinned in docker-compose.yml).
# KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:v0.9.0

# --- Push notifications (K-31a) ------------------------------------------
# Alerts, a character's DMs and the booths' door alarm on a LOCKED phone
# (Android + performer booths). Generate the pair ONCE:
#     npx web-push generate-vapid-keys
# and paste both here. NEVER rotate them before the show: every phone's
# subscription is bound to the public key, so new keys silently cut them
# all off. Blank = push off (no 🔔 card; in-app alerts still work).
# The subject is a contact for the push services (mailto: or https:);
# blank = LOOM_BASE_URL.
LOOM_VAPID_PUBLIC_KEY=
LOOM_VAPID_PRIVATE_KEY=
LOOM_VAPID_SUBJECT=

# --- The reinstallation games + the house map ----------------------------
# Nothing to set: the image serves the web game at /reinstall/ and the
# house map editor at /reinstall/map, using the show's house.json (a
# director's save from the editor is kept per event in the state volume as
# spatial-house.json). To pin a different default map, bind-mount it
# read-only into the `loom` service (e.g. ./house.json:/config/house.json:ro)
# and set LOOM_HOUSE: /config/house.json there (docker-compose.yml has both
# commented lines). The
# Godot VR game is exported to the headsets separately — see
# reinstall/vr/README.md.
