# Copy to `.env` next to docker-compose.yml and fill in. Never commit `.env`.

# Password for the bundled Postgres (any long random string):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs author session cookies — the control plane refuses to boot in
# production without a real one:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The Loom app's public origin, exactly as typed into the browser.
#   No domain yet:  http://YOUR_VPS_IP
#   With a domain:  https://app.mapsandducks.com
LOOM_BASE_URL=http://YOUR_VPS_IP

# What Caddy listens as for the Loom app (play at /, editor at /edit/).
#   No domain yet:  :80                    (plain HTTP)
#   With a domain:  app.mapsandducks.com   (automatic HTTPS via Let's Encrypt)
SITE_ADDRESS=:80

# What Caddy listens as for the party-invitation page.
#   No domain yet:  :8081                  (unmapped port — effectively off)
#   With a domain:  mapsandducks.com       (automatic HTTPS via Let's Encrypt)
INVITE_ADDRESS=:8081

# --- Email (share invites) ---------------------------------------------
# Sharing a project emails the collaborator a join link. Set ONE transport;
# with neither, invites are logged in `docker compose logs loom` and the
# Share dialog shows the owner a link to pass along by hand.
#   Any SMTP provider (Fastmail, Gmail app password, Mailgun, Postmark, …):
#     LOOM_SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
#   Or Resend (https://resend.com — free tier, verify your domain there):
#     LOOM_RESEND_API_KEY=re_xxxxxxxx
LOOM_SMTP_URL=
LOOM_RESEND_API_KEY=
# The From: address — must be one your provider lets you send as.
LOOM_MAIL_FROM=Loom <no-reply@YOUR_DOMAIN>
