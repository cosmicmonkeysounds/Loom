# Copy to `.env` next to docker-compose.yml and fill in. Never commit `.env`.

# Password for the bundled Postgres (any long random string):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# How long the server waits for Postgres at boot, in whole seconds (blank =
# 60); still down → the container exits and the restart policy tries again.
# `off` (or 0) means one probe and no wait — never a "run without the
# database" switch here: the entrypoint still exits while it's down.
# LOOM_DB_WAIT=60

# Signs author session cookies — the control plane refuses to boot in
# production without a real one:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The Loom app's public origin, exactly as typed into the browser.
#   No domain yet:  http://YOUR_VPS_IP
#   With a domain:  https://app.mapsandducks.com
LOOM_BASE_URL=http://YOUR_VPS_IP

# The release the stack runs (images loom-server:<tag> + loom-proxy:<tag>).
# Leave it to deploy/release.sh, which sets it per release and keeps the
# previous tag for deploy/rollback.sh. Blank/absent = "latest".
# LOOM_TAG=

# What Caddy listens as for the Loom app (play at /, editor at /edit/).
#   No domain yet:  :80                    (plain HTTP)
#   With a domain:  app.mapsandducks.com   (automatic HTTPS via Let's Encrypt)
SITE_ADDRESS=:80

# What Caddy listens as for the party-invitation page.
#   No domain yet:  :8081                  (unmapped port — effectively off)
#   With a domain:  mapsandducks.com       (automatic HTTPS via Let's Encrypt)
INVITE_ADDRESS=:8081

# --- Email (share invites) ---------------------------------------------
# Sharing a project emails the collaborator a join link. Set ONE transport;
# with neither, invites are logged in `docker compose logs loom` and the
# Share dialog shows the owner a link to pass along by hand.
#   Any SMTP provider (Fastmail, Gmail app password, Mailgun, Postmark, …):
#     LOOM_SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
#   Or Resend (https://resend.com — free tier, verify your domain there):
#     LOOM_RESEND_API_KEY=re_xxxxxxxx
LOOM_SMTP_URL=
LOOM_RESEND_API_KEY=
# The From: address — must be one your provider lets you send as.
LOOM_MAIL_FROM=Loom <no-reply@YOUR_DOMAIN>

# --- The webmaster outbox ------------------------------------------------
# A password-gated page at https://<SITE_ADDRESS>/webmaster/ for sending
# mail as LOOM_WEBMASTER_FROM through Resend (needs LOOM_RESEND_API_KEY).
# Off while the password is blank. Use a long one: `openssl rand -base64 18`.
LOOM_WEBMASTER_PASSWORD=
LOOM_WEBMASTER_FROM=Webmaster <webmaster@YOUR_DOMAIN>
# Where replies go (blank = the From address).
LOOM_WEBMASTER_REPLY_TO=

# --- Door-rush throttles ------------------------------------------------
# Each takes <max> (per the default window) or <max>/<seconds>. Blank keeps
# the default. Per-IP limits: at the party every phone on the house Wi-Fi
# reaches the VPS from ONE public IP, so raise these for the night, e.g.
#   LOOM_RL_RESOLVE=600  LOOM_RL_REGISTER=400  LOOM_RL_LOGIN_FAILURES=100/300
# /api/resolve-code per IP (default 30/60)
LOOM_RL_RESOLVE=
# guest registrations per IP (default 20/60)
LOOM_RL_REGISTER=
# wrong passcodes per IP before the lockout (default 10/300)
LOOM_RL_LOGIN_FAILURES=
# wrong codex codes per GUEST, then 429 + nothing journaled (default 8/60)
LOOM_RL_REDEEM_MISSES=
# widget answers per GUEST (cards, polls, 📝 File a fact), then 429 (default 20/60)
LOOM_RL_WIDGETS=
# wallet calls per GUEST (/api/guest/wallet/* — sends, requests, offers, the
# stimulus), then 429 (default 30/60): the only brake on a phone flooding the
# approver's queue with tiny sends
LOOM_RL_WALLET=
# Coalesce the phones' + booths' snapshot frames to at most one per this many
# ms (blank / 0 = off, one per story step). The K-32 contingency (SW-OPS-24):
# set 500 only if the load test's p95 > 1 s or CPU > 70 %.
LOOM_SNAPSHOT_MS=

# --- Trabolta's request extras (wave 12) ----------------------------------
# Each agent request carries which of his thread lines the story posted
# and up to 6 recent things about this guest (gifts, filing ids, the mark,
# the Trust Chart, his last house-wide lines). `off` sends the wave 11b
# request field for field: the kill switch's server rung. The server reads
# it on every request, but a container's environment is fixed when it
# starts, so the change needs `docker compose up -d server`: before doors
# only (a restart re-asks owed DMs but cuts every open stream). Blank = on.
LOOM_AGENT_RECENT=
# (Wave 20) A guest at Trabolta's heart (the server-room terminal) rides
# their night on the request as a dossier (faction, trust rank, filings by
# verdict, non-secret codex titles, rooms, their own lines to him; never a
# secret, an answer, a code or a real name). `off` leaves it out. Same
# restart rule as above. Blank = on.
LOOM_AGENT_DOSSIER=

# --- The wall terminals' voice ------------------------------------------
# `/terminal/` (and the TV, view=tv) speaks Trabolta's lines with each
# DEVICE'S OWN voice — the tablet's speechSynthesis, Fully Kiosk's
# text-to-speech, or the house Mac's macOS voices. Nothing to set, and
# nothing on the night depends on a server voice. Leave this blank / off.
#
# Opt-in, for one consistent neural voice on every terminal (each terminal
# must also be set to "the server's voice" in its ⚙):
#   bundled Kokoro (CPU, needs ~2 GB RAM):
#     COMPOSE_PROFILES=tts
#     LOOM_TTS_URL=http://kokoro:8880/v1
#   a Kokoro on another machine:  LOOM_TTS_URL=http://<laptop-ip>:8880/v1
#   OpenAI:  LOOM_TTS_URL=https://api.openai.com/v1  LOOM_TTS_API_KEY=sk-…
#            LOOM_TTS_MODEL=tts-1  LOOM_TTS_VOICE=onyx
LOOM_TTS_URL=off
LOOM_TTS_API_KEY=
LOOM_TTS_MODEL=kokoro
LOOM_TTS_VOICE=am_michael
# Only with COMPOSE_PROFILES=tts: cores the bundled Kokoro may use —
# (VPS cores - 1), so the event server always keeps one. Docker refuses a
# value above the machine's core count.
KOKORO_CPUS=1
# The Kokoro image (multi-arch; the default is pinned in docker-compose.yml).
# KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:v0.9.0

# --- Push notifications (K-31a) ------------------------------------------
# Alerts, a character's DMs and the booths' door alarm on a LOCKED phone
# (Android + performer booths). Generate the pair ONCE:
#     npx web-push generate-vapid-keys
# and paste both here. NEVER rotate them before the show: every phone's
# subscription is bound to the public key, so new keys silently cut them
# all off. Blank = push off (no 🔔 card; in-app alerts still work).
# The subject is a contact for the push services (mailto: or https:);
# blank = LOOM_BASE_URL.
LOOM_VAPID_PUBLIC_KEY=
LOOM_VAPID_PRIVATE_KEY=
LOOM_VAPID_SUBJECT=
# iPhone Home Screen push (K-31b), default off. `on` = an iPhone (iOS
# 16.4+) gets "Share → Add to Home Screen" on its 🔔 card, and the icon
# opens signed in as the same guest (a single-use, 12 h nonce in the
# manifest's start_url). Off = iPhones are told to keep the app open.
LOOM_HOMESCREEN=

# --- The reinstallation games + the house map ----------------------------
# Nothing to set: the image serves the web game at /reinstall/ and the
# house map editor at /reinstall/map. The map belongs to the project (its
# house.json + house.<variant>.json, pushed by scripts/sync-show.sh and
# snapshotted at launch); a director's save from the editor is kept per
# event in the state volume as spatial-house.json. LOOM_HOUSE is only the
# fallback (default: the show's house.json in the image). To pin a
# different one, bind-mount its directory read-only into the `loom` service
# (e.g. ./show-map:/config:ro) and set LOOM_HOUSE: /config/house.json there
# (docker-compose.yml has both commented lines). The
# Godot VR game is exported to the headsets separately — see
# reinstall/vr/README.md.

# --- The facts judge (the hunt's answer key) -----------------------------
# Nothing to set either: the show's facts.json (the hunt questions + their
# answers, the scannable facts, the truth-or-dare questions — the one file
# the team edits; `pnpm --filter @loom/core titi:facts` writes the story
# files from it) is a PROJECT file beside house.json, pushed by
# scripts/sync-show.sh and snapshotted when the event launches (kept per
# event in the state volume as project-facts.json): that copy is the
# judge's key. LOOM_FACTS is only the fallback for an event with no
# project copy (the LAN default event); default = facts.json beside the
# house map (LOOM_HOUSE's directory, else the show's in the image).
# Deploy the server BEFORE the first sync-show that carries facts.json or
# the king maps: an older server refuses a map with a kind: "king" prop or
# a guarded door, and has no judge.
# LOOM_FACTS=/config/facts.json

# --- The house speakers (audio.json, wave 17) ----------------------------
# Nothing to set either: the speakers, zones, the interface's 16 in / 16 out
# routing matrix and where each story sound plays are the project file
# audio.json (the map editor's Audio panel at /reinstall/map; never named
# house.audio.json, which would read as a map variant), pushed by
# scripts/sync-show.sh (--keep-audio / --replace-audio) and snapshotted at
# launch (kept per event in the state volume as project-audio.json). A
# director's save from the map editor wins over it (audio-save.json). The
# house Mac's stagehand `audio` router reads it from GET /api/mod/audio.
# LOOM_AUDIO is only the fallback for an event with no project copy (the
# LAN default event); unlike LOOM_FACTS it has no default file: unset =
# an empty 16 / 16 interface with nothing placed. Same rule as LOOM_HOUSE:
# bind-mount it read-only and set it in docker-compose.yml, never blank.
# The file is re-read when it changes.
# LOOM_AUDIO=/config/audio.json

# The house lights (wave 20): lights.json is a project file beside the maps
# and audio.json (fixtures, zones, looks), pushed by scripts/sync-show.sh
# and snapshotted at launch; a director's save from the map editor's 💡
# tab wins over it. The house Mac's stagehand `lights` module reads it from
# GET /api/mod/lights. LOOM_LIGHTS is only the fallback for an event with
# no project copy (the LAN default event, a no-DB scratch server); it has
# no default file: unset = no fixtures. Bind-mount it read-only, never blank.
# LOOM_LIGHTS=/config/lights.json
