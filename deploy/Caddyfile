# The public front door. Both addresses come from .env:
#   SITE_ADDRESS   — the Loom app (play at /, editor at /edit/)
#     ":80" (default)          → plain HTTP, join by IP, no domain needed
#     "app.mapsandducks.com"   → automatic HTTPS via Let's Encrypt
#   INVITE_ADDRESS — the party-invitation one-pager (apex domain)
#     ":8081" (default)        → parked on an unmapped port, effectively off
#     "mapsandducks.com"       → automatic HTTPS via Let's Encrypt
{$SITE_ADDRESS::80} {
	# No site-wide `encode`: a compressor holds small writes until it has
	# enough to emit, so an SSE stream's 25 s ping and single-message frames
	# would sit in Caddy's buffer instead of reaching the phone.

	# The author editor — a static SPA built with --base=/edit/.
	handle /edit* {
		encode gzip zstd
		root * /srv
		try_files {path} /edit/index.html
		file_server
	}

	# Everything else — the play app at /, /api/*, /e/:eventId/* —
	# goes to the event server. The play/terminal/reinstall bundles and
	# JSON are compressed; the SSE streams are not:
	#   /events, /e/:id/events                    (guest / booth / mod feeds)
	#   /api/agent/stream, /api/spatial/stream    (+ /e/:id/ forms)
	#   /api/projects/:id/collab/stream           (co-editing)
	# and every proxied write is flushed at once (`flush_interval -1`).
	@compressible not path */events */stream
	handle {
		encode @compressible gzip zstd
		reverse_proxy loom:7000 {
			flush_interval -1
		}
	}
}

# The invitation — a static SPA, no API, nothing to proxy.
{$INVITE_ADDRESS::8081} {
	encode gzip zstd
	root * /srv/invite
	try_files {path} /index.html
	file_server
}
