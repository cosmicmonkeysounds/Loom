{
  "name": "loom-terminal",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "The wall terminal — a kiosk React app for tablets mounted around a live Loom event: scan a guest's pass to pilot a direct line to an agent-voiced character, with an animated face and a synthesised voice.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/vt323": "^5.2.6",
    "@loom/chess": "workspace:*",
    "@loom/house": "workspace:*",
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.20",
    "vitest": "^2.1.0"
  }
}
