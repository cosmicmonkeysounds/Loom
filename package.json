{
  "name": "loom",
  "private": true,
  "license": "MIT",
  "description": "Loom — a scripting language for interactive stories, from branching game dialogue to live immersive events.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "sync-example": "pnpm --filter @loom/core exec tsx scripts/sync-example.ts",
    "house:sync": "pnpm --filter @loom/house goldens && pnpm --filter @loom/house sync",
    "test": "pnpm -r test",
    "test:vr": "bash reinstall/vr/test/run.sh",
    "typecheck": "pnpm -r typecheck"
  }
}
