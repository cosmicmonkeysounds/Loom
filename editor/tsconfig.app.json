{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths */
    "paths": {
      "@loom/core/parser": ["../core/src/parser/index.ts"],
      "@loom/core/lsp": ["../core/src/lsp/index.ts"],
      "@loom/core/sim": ["../core/src/runtime/sim/index.ts"],
      "@loom/core/chat": ["../core/server/chat.ts"],
      "@loom/core/views": ["../core/server/views.ts"],
      "@loom/core/mod-patch": ["../core/server/mod-patch.ts"],
      "@loom/core/cue-sheet": ["../core/src/cue-sheet.ts"],
      "@loom/core/host-board": ["../core/src/host-board.ts"],
      "@loom/core/house-desk": ["../core/src/house-desk.ts"],
      "@loom/core/house-mixer": ["../core/src/house-mixer.ts"],
      "@loom/core/voice-fx": ["../core/src/voice-fx.ts"],
      "@loom/core/link-health": ["../core/src/link-health.ts"],
      "@loom/core/photos": ["../core/src/photos.ts"],
      "@loom/core/credits": ["../core/src/credits.ts"],
      "@loom/core": ["../core/src/index.ts"],
      "@loom/house/three": ["../house/src/three/index.ts"],
      "@loom/house": ["../house/src/index.ts"],
      "@loom/bank": ["../bank/src/index.ts"],
      "@loom/play/embed": ["../play/src/embed.tsx"],
      "@loom/play/*": ["../play/src/*"],
      "@loom/reinstall/map": ["../reinstall/web/src/map/embed.tsx"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
