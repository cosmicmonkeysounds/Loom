{
  "name": "@loom/core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Native TypeScript port of the Loom engine (parser + ecosystem-sim runtime) plus the SSE/REST event server for live LAN events. No WASM, no Prism.",
  "exports": {
    ".": "./src/index.ts",
    "./parser": "./src/parser/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./sim": "./src/runtime/sim/index.ts",
    "./lsp": "./src/lsp/index.ts",
    "./facts": "./src/facts.ts",
    "./chat": "./server/chat.ts",
    "./views": "./server/views.ts",
    "./mod-patch": "./server/mod-patch.ts",
    "./cue-sheet": "./src/cue-sheet.ts",
    "./show-clock": "./src/show-clock.ts",
    "./delivery": "./src/delivery.ts",
    "./host-board": "./src/host-board.ts",
    "./casino": "./src/casino.ts",
    "./house-desk": "./src/house-desk.ts",
    "./house-mixer": "./src/house-mixer.ts",
    "./talk-back": "./src/talk-back.ts",
    "./credits": "./src/credits.ts",
    "./voice-fx": "./src/voice-fx.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx server/migrate.ts",
    "serve": "tsx server/server.ts",
    "loomcheck": "tsx scripts/loomcheck.ts",
    "titi:facts": "tsx scripts/titi-facts.ts",
    "show:page": "tsx scripts/show-page.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "typescript": "~6.0.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@loom/house": "workspace:*",
    "better-auth": "^1.6.23",
    "nodemailer": "^10.0.1",
    "obscenity": "0.4.6",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7",
    "yjs": "^13.6.32"
  }
}
