// Scannable stations around the house. An Antivirus or a host scans a
// program's pass at the station (the station's name is the character a
// performer signs in as on a spare phone taped to it, or a host scans
// "as" it from the Run cockpit). Each is one line: a `Prop(beat)`.
//
//   The Uploader     the Optical Drive voice; a second scan → Re-upload (beats/login.loom)
//   The Router       the kitchen router → The Router (beats/desktop.loom)
//   The Screensaver  the TV above the fireplace → The Screensaver (beats/desktop.loom)
//   The Tablet       the tent tablet station → The Tablet Video (beats/internet.loom)
//
// The QR codes hidden around the house are *not* props: they are CODEX
// entries with a `code:` (codex/), scanned by the guest's own phone.

CHARACTER The Uploader is Prop(Re-upload)
CHARACTER The Router is Prop(The Router)
CHARACTER The Screensaver is Prop(The Screensaver)
CHARACTER The Tablet is Prop(The Tablet Video)

// ── The Kernel: the secret state ────────────────────────────────────
// Not a person, not a prop: a place to keep what Trabolta must never
// know. A character's variables never reach an agent request's world,
// and `secret: true` keeps the Kernel out of the agents' facts document
// (the orchestrator's digest) too, so the patch-bay combinations, the
// per-question verdicts, the lies, what everyone filed per question (read
// aloud at the results), the virus planter, the dossier, the majority and
// the anti-AI program and the server-room keypad code live here as
// `Kernel.<slot>` — never in `Night.*`, which the worker sees whole. The
// door code is seeded by the generated `== Facts Seed` from facts.json
// (`door.code`), so it is set on every boot and lives in one place. Written and read only by main.loom's rules, ROLE hooks and
// beats; directors see and edit them in Run → World. No trait, no hooks,
// no lines, no avatar, not in the directory.
CHARACTER Kernel
  playable: false
  secret: true
  anti_ai: text? = none
  combo_a: text? = none
  combo_b: text? = none
  door_code: text? = none
  q1: text? = none
  q2: text? = none
  q3: text? = none
  q4: text? = none
  q5: text? = none
  q6: text? = none
  q7: text? = none
  q8: text? = none
  q1_hunt: text? = none
  q2_hunt: text? = none
  q3_hunt: text? = none
  q4_hunt: text? = none
  q5_hunt: text? = none
  q6_hunt: text? = none
  q7_hunt: text? = none
  q8_hunt: text? = none
  lies_accepted: 0 to 50 = 0
  all_accurate: bool = false
  // Wave 18b: The Verdict is on the TV; the ending waits for its pages.
  verdict_wait: bool = false
  verdict_end: 0 to 1000000 = 0
  said_1: text? = none
  said_2: text? = none
  said_3: text? = none
  said_4: text? = none
  said_5: text? = none
  said_6: text? = none
  said_7: text? = none
  said_8: text? = none
  ans_1: text? = none
  ans_2: text? = none
  ans_3: text? = none
  ans_4: text? = none
  ans_5: text? = none
  ans_6: text? = none
  ans_7: text? = none
  ans_8: text? = none
  res_filed: 0 to 999 = 0
  res_consensus: 0 to 999 = 0
  res_said: text? = none
  res_answer: text? = none
  // Wave 18b (Q6): a reading's accepted / guess counts (by proposal, like
  // res_consensus), the verdict's per-question truths (accurate | lie |
  // none, published with `do fact_truth`) and its totals.
  res_accepted: 0 to 999 = 0
  res_guesses: 0 to 999 = 0
  t1: text? = none
  t2: text? = none
  t3: text? = none
  t4: text? = none
  t5: text? = none
  t6: text? = none
  t7: text? = none
  t8: text? = none
  v_true: 0 to 8 = 0
  v_lies: 0 to 8 = 0
  v_none: 0 to 8 = 0
  virus_planted: bool = false
  excel_planted: bool = false
  virus_planter: text? = none
  openoffice_dossier: bool = false
  majority_reached: bool = false
  // "stay" | "leave" | "founded" (wave 18b: any faction can win), and the
  // winner's id, display name and founder (a person id), set once.
  majority: text? = none
  majority_id: text? = none
  majority_name: text? = none
  majority_founder: text? = none
  jeeves_reached: 0 to 99 = 0
  // Wave 21: who pressed the game button being settled ("Clippy" | "none"),
  // so a host's press never pays Clippy (cast/hosts.loom). DRAFT w21
  pressed_by: text? = none
  // Wave 26 (B2): who pressed ↩ Not a Bingo (the pressing booths count
  // themselves; one = that part's name, more = the Director's quick-fire).
  undo_n: 0 to 99 = 0
  undo_by: text? = none
