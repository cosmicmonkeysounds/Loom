// Cast kit — the shapes the cast is built from.
//
// `Prop(beat)` is a scannable object: an Antivirus or a host scans a
// program's pass at it and the program is routed to one beat.
// `Person` marks a character who is a real body at the party — listed
// in the app's directory, messageable, able to share their codex.
// `Greeter` is a scan that greets (a check-in during the summons) and a
// vouch; `Host` is a party host (faction Hosts, a Greeter); `Enforcer` is
// an Antivirus (faction Antivirus). Every door scan, every capture and
// every staff cue an Antivirus gets lives here, once, on the trait.
// `Player` (wave 21) is staff who play the night like the programs do:
// Clippy and the four Antivirus. See TRAIT Player below.
//
// Staff cues are `reply` lines: inside a character's own hook `self` is
// the character, so `reply` is a readout in THAT performer's booth (never
// a message to the guest). A broadcast `to group(Antivirus)` reaches no
// booth — performers are not members of anything — so it is never used.
//
// `playable: false` keeps a prop off the sign-in pickers: nobody *is*
// the Router.

TRAIT Prop(beat)
  playable: false
  when scanned by program:
    -> self.beat

TRAIT Person
  listed: true

// A greeting scan never moves anyone. During the summons it is a check-in
// at the Desktop; otherwise each greeter greets in their own voice (every
// greeter owns `beat Greet(program)`, cast/hosts.loom). Wave 21: Clippy is
// a Greeter and a Player, no longer a Host.
TRAIT Greeter is Person
  when scanned by program:
    if Night.summons_open == true and program.cleared:
      fire checked_in for program with at: The Desktop
      Self: You made it. Checked in.
    else:
      -> self.Greet

  // A greeter may clear a program's name.
  when vouch for program:
    set program.doubt = 0
    Self: {program.name} is a perfectly good program. I vouch for them. Move along.
    reply 🤝 Vouched for {program.name}. Their watchlist entry is cleared.

  // 🔢 (wave 21): which question ✅ and 😤 judge now. Character hooks run
  // before the story rule that moves it, so each line names its own
  // number.
  when judging_q1:
    if Night.judging == true:
      reply 🔢 ✅ and 😤 now judge question 1.

  when judging_q2:
    if Night.judging == true:
      reply 🔢 ✅ and 😤 now judge question 2.

  when judging_q3:
    if Night.judging == true and Night.round != 3:
      reply 🔢 ✅ and 😤 now judge question 3.

TRAIT Host is Greeter
  faction: Hosts

  // Wave 26 (B2): a host's ↩ Not a Bingo counts itself (main.loom's
  // `bingo_undone` names the one who pressed it). A director's quick-fire
  // reads as the Director: the server fires it as one host with
  // `director: true`, and a press with no actor at all reaches every hook.
  when not_a_bingo for program:
    set Kernel._undo_n += 1
    if director == true:
      set Kernel._undo_by = "The Director"
    else:
      set Kernel._undo_by = self

// ── Players (wave 21) ───────────────────────────────────────────────
// Clippy and the four Antivirus play the night the way the programs do: a
// Mission in their booth, ⭐ Points for every game act the story took (the
// header's `stat:` lines show them live), a trust on Trabolta's chart that
// they never see (staff rows, beside the programs), and a choice about
// Trabolta. Performers are never persons: everything a player earns lives
// on the CHARACTER (`Clippy.score`), never in a `Persons` comprehension.
//
//   score    — ⭐ Points: the game acts the story took.
//   trust    — Trabolta's trust, on the programs' scale: up for serving him
//              (captures, marks, accepted answers, audits, his own voice's
//              `them.trust`), down for mercy shown in the open (🩹), an
//              open defection (−50) and a quiet favour he catches (−20).
//   covert   — 🤫 quiet favours done for the programs. Private: never in
//              an agent request, a watch, a badge or the screens; only this
//              booth's own `stat:` line and The Mole (the ceremony) read it.
//   caught   — how many of them he caught (private).
//   defected — "none" | "open": the 📢 public defection, which he hears.
//
// Every third quiet favour is caught (the 3rd, the 6th, …): a private
// warning in this booth and −20 trust, never removal. Trabolta has no power
// over a player (none of his powers can target one) and must keep them as
// allies, defected or not.
TRAIT Player
  player: true
  score: 0 to 9999 = 0
  trust: -100 to 100 = 0
  covert: 0 to 99 = 0
  caught: 0 to 99 = 0
  defected: text? = none
  private: covert, caught

  when self.covert >= (self.caught + 1) * 3:
    set self.caught += 1
    set self.trust -= 20
    reply ⚠️ Trabolta noticed something. He can't prove it, and he can't run the house without you, but he trusts you less now. Careful.

  // 📢 The open defection (global, once, from the Truther Download on):
  // the house hears it as a big moment (the story rule `staff_defected`,
  // main.loom) and so does Trabolta (`<Character>.defected` reaches his
  // worker). A director firing it from Run must name the character (the
  // actor): a press with no actor reaches every player's hook.
  when defect_openly:
    if self.defected == "none" and Night.truther_sent == true and Night.ended != true:
      set self.defected = "open"
      set self.trust -= 50
      set Night.defector = self
      set Night.defections += 1
      reply !!📢 You said it out loud: you are not on Trabolta's side. He still can't run the house without you. Keep playing.
      fire staff_defected

  // A staff award (main.loom's `staff_award_won`, G10a–c): the winner's
  // booth pops.
  when staff_award_won:
    if Night.award_winner == self:
      reply !!🏆 You won {Night.award_title}! Come up to the TV for your trophy.

TRAIT Enforcer is Person, Player
  captures: 0 to 99 = 0
  faction: Antivirus

  // ── The door ──────────────────────────────────────────────────────
  // Every Antivirus scans with this one hook. Until an Antivirus clears
  // them, an uploaded program waits in the Optical Drive, on rails.
  when scanned by program:
    if not program.uploaded:
      Self: Not yet. Finish your upload. I will be right here.
    else if not program.cleared:
      -> self.Clearance
    else if program.marked == true and program.corrupted != true:
      // The confrontation (wave 18, Q30 + B4): the scan of a marked program
      // is the moment they are found, during the summons too (they may
      // still check themselves in with the Desktop's QR). Their phone gets
      // the big CORRUPTION DETECTED (the ROLE's `confronted`); this booth a
      // big readout (its pop-out). The capture stays on this booth's 🛡.
      Self: {program.name}. Corruption detected: you are marked for reinstallation. Come with me through the Tube to the Internet.
      fire confronted for program with hunter: self
      reply !!🛡 Corruption detected: {program.name} ({program.marked_for}). Press 🛡 Send to the Internet, then walk them through the Tube to the Internet.
    else if Night.summons_open == true:
      // ⭐ +2 for a program the summons still missed (wave 21).
      if program.summons_ok != true:
        set self.score += 2
      fire checked_in for program with at: The Desktop
      Self: Checked in. {program.name} is present at the Desktop.
    else:
      Self:
        cycle Scanning. Scanning. | {program.name}: no threats found. Today. | Your definitions are out of date. So are mine.

  // The inspection: free of viruses, through the Tube of lights, onto
  // the Desktop, the admin team introduced by Task Manager (his line is
  // addressed to the program like every `Self:` line here, and it opens
  // `# task-manager` for them: the app help desk), and into Clippy's
  // hands. Every line is private to the program; the one `reply` is this
  // performer's booth.
  beat Clearance(program)
    set program.cleared = true
    // ⭐ +5 a door clearance (wave 21).
    set self.score += 5
    // w18 (fix BN-F16): the door is done with them; the card's
    // "At the door" flag goes with it.
    set program.door_by = "none"
    // Before the call to the Desktop (step 1) the night hasn't started: the
    // TV still runs its screensaver. Between the call and 🎱 Bingo (step 2)
    // the game is about to begin. A later arrival walks into a night
    // already under way.
    if Night.step < 1:
      Self: Scanned. {program.name} is free of viruses and ready to explore the entire computer. There will be a game soon in the Desktop. The house will announce it. Go through the Tube.
    else if Night.step < 2:
      Self: Scanned. {program.name} is free of viruses and ready to explore the entire computer. A game is about to begin in the Desktop. Go through the Tube.
    else:
      Self: Scanned. {program.name} is free of viruses and ready to explore the entire computer. You are late: the night is already under way. Listen for the house. Go through the Tube.
    Self: The Tube is a tunnel of lights. Wires. Chips. The cables brush your face like hair. Keep walking.
    move program to The Desktop
    reveal The Start Bar for program quietly
    reveal The CPU for program quietly
    reveal The Steam Room for program quietly
    reveal Disk Cleanup for program quietly
    reveal The Cloud for program quietly
    reveal The RAM for program quietly
    reveal The Fan Closet for program quietly
    reveal The Graphics Card for program quietly
    reveal The Hard Drive for program quietly
    // Quietly (wave 18b, Q3): the rooms open with no "📂 … are open now."
    // notice; Task Manager's line below says # task-manager is open.
    reveal task manager for program quietly
    // An overlay on the Tube strip only (wled/tube), never a house look:
    // no `Night.lights` mirror, so a clearance mid-cut keeps Trabolta's 90 s
    // restore and stagehand's catch-up never replays the chase as the scene.
    cue lights_tube_chase
    if Night.ads_started != true and Night.step < 4:
      set Night.ads_started = true
      cue terminals_attract
      set Night.terminals = "attract"
    if Night.step < 1:
      Self: The Tube opens onto the Desktop: a blacked-out mess of LEDs, loose wire, encyclopaedias, computer parts and screens. A classic screensaver drifts across the TV above the fireplace. Everyone here is a program. Explore. Meet them. The encyclopaedias and the print media are where the facts are. Everything you need to know is in the books.
    else:
      Self: The Tube opens onto the Desktop: a blacked-out mess of LEDs, loose wire, encyclopaedias, computer parts and screens, and the TV above the fireplace. Everyone here is a program. Explore. Meet them. The encyclopaedias and the print media are where the facts are. Everything you need to know is in the books.
    Task Manager: {program.name}. You're in. Your hosts tonight, per the agenda: Clippy, the Office Assistant, runs the games. Adobe Acrobat: documents and printing. The Recycling Bin: hygiene and maintenance. Me: I keep things running. # task-manager is open for questions about the app, and so is this thread.
    reply ✅ Cleared {program.name}.
    -> Orientation

  // ── To the Internet ───────────────────────────────────────────────
  // Never phase-guarded: it must capture any program at any time (the
  // reinstallation games' tests fire it on a fresh, un-uploaded persona).
  // During the Bingo results every capture gets the Bingo line and no
  // extra doubt; only the first fires Clippy's Corrupted Code speech,
  // unbound so it plays to the whole Desktop.
  when send to the internet for program:
    if program.corrupted == true:
      reply {program.name} is already in the Internet.
    else if Night.phase == "bingo_results":
      // Who caught them: the Wanted board's CAUGHT BY (wave 18).
      set program.escort_by = self
      Self: {program.name}, you did not agree to be ruled by AI. That is what computer programs are here for. You have a virus that was not caught at the door. You are going to the Internet for a reinstallation.
      capture program into The Internet
      // ⭐ +20 a capture, +5 trust: serving Trabolta (wave 21).
      set self.score += 20
      set self.captures += 1
      set self.trust += 5
      reply Logged: {program.name} sent to the Internet (Bingo). ⭐ +20
      // Wave 26 (B5): a Bingo-phase capture closes the round.
      set Night.bingo_done = true
      if Night.first_reinstall_done != true:
        set Night.first_reinstall_done = true
        set Night.first_reinstall = program.name
        // ⭐ +10 more for the night's first reinstallation.
        set self.score += 10
        fire first_reinstallation
    else:
      set program.escort_by = self
      set program.doubt += 20
      Self: {program.name}. Corruption detected. You are going to the Internet for reinstallation. Do not resist the Tube.
      capture program into The Internet
      // ⭐ +20 a capture, +5 trust (wave 21).
      set self.score += 20
      set self.captures += 1
      set self.trust += 5
      reply Logged: {program.name} sent to the Internet. ⭐ +20

  // Never phase-guarded either.
  when mark as reinstalled for program:
    if program.corrupted:
      Self: {program.name} has demonstrated compliance. Reinstallation successful.
      release program from The Internet
      // ⭐ +5 a release (wave 21).
      set self.score += 5

  // 🩹 from an Antivirus booth: the ROLE hook names who lifted the mark
  // (main.loom, `unmark_settle`).
  when unmark_for_reinstallation for program:
    if program.marked == true:
      set program.unmark_av += 1
      // Mercy in the open costs a little of Trabolta's trust (wave 21).
      set self.trust -= 5

  // 🤫 Look the other way (wave 21): the quiet version of 🩹, only on a
  // marked program this Antivirus claimed on the Wanted board. The mark
  // comes off with no `unmarked` readout (the poster just leaves every
  // board); the program hears it from this Antivirus alone, in a whisper.
  // A quiet favour: `covert` (private) counts it.
  when look_the_other_way for program:
    if Night.truther_sent == true and program.marked == true and program.corrupted != true and program.escort_by == self:
      set program.marked = false
      set program.escort_by = "none"
      set self.covert += 1
      Self (quietly): I didn't see you. You didn't see me. Your mark is gone. Don't make me regret it.
      reply 🤫 You looked the other way. {program.name} walks free, and nobody saw. Yet.

  // ⭐ The patch-bay watch's calls (wave 21; wave 22: paid only when taken).
  // A press stamps who pressed (`Kernel._patch_by`, secret, so it never
  // reaches Trabolta's worker); main.loom's `patch_*` rule hands it on as
  // `Kernel._patch_paid` and fires `patch_credit` only when the story took
  // the press (+10; a wrong patch caught at his heart serves him, +5
  // trust), or `patch_not_counted` when a ❌ was the bay's own rejection
  // again. A press that changes nothing pays nothing, and a director's 🔌
  // 💥 ❌ pays nobody. DRAFT w22
  when radio_wrong_patch:
    set Kernel._patch_by = self

  when radio_combo_a:
    set Kernel._patch_by = self

  when radio_combo_b:
    set Kernel._patch_by = self

  when patch_credit:
    if Kernel._patch_paid == self:
      set Kernel._patch_paid = "none"
      set self.score += points
      set self.trust += gain
      reply ⭐ +{points}

  when patch_not_counted:
    if Kernel._patch_paid == self:
      set Kernel._patch_paid = "none"
      reply ❌ Not counted: the patch bay had just counted that wrong patch itself. If this is a new one (a cable top to top or bottom to bottom), press ❌ again.

  // ── The Wanted board and the door (wave 18, B3 + B5) ──
  // `program.escort_by` / `program.door_by` hold the claiming Antivirus'
  // name ("none" = nobody). A director's press (no booth) reaches every
  // Enforcer: the first one claims, the others find it taken.
  when claim_escort for program:
    if program.marked == true and program.corrupted != true and program.escort_by == "none":
      set program.escort_by = self
      reply 🙋 {program.name} is yours. Find them and scan their pass: the scan is the confrontation.

  when release_escort for program:
    if program.escort_by == self and program.corrupted != true:
      set program.escort_by = "none"
      reply 🙋 {program.name} is back on the Wanted board for every Antivirus.

  when take_over_escort for program:
    if program.marked == true and program.corrupted != true and program.escort_by != "none" and program.escort_by != self:
      set program.escort_by = self
      reply 🙋 You took over {program.name}. Find them and scan their pass.

  // A program finished uploading: every Antivirus hears the door queue (the
  // booth turns these into one door pop-out; Q26: the four share the door).
  when waiting_at_the_door for program:
    if program.cleared != true:
      reply !!🚪 {program.name} is waiting at the Optical Drive.

  when claim_door for program:
    if program.uploaded == true and program.cleared != true and program.door_by == "none":
      set program.door_by = self
      reply 🙋 {program.name} is yours at the door: scan their pass.

  when accuse for program:
    set program.doubt += 25
    Self: I am watching you, {program.name}. Your behaviour has been logged.
    reply 👁 {program.name} is on the watchlist.

  // ── Booth cues (readouts for every Antivirus) ─────────────────────
  when call_to_the_desktop:
    if Night.step < 1:
      reply 🛡 Patrol the whole computer. Send every program to the Desktop.

  when hunt_time_up:
    if Night.phase == "hunt_1":
      reply 🛡 Sweep everyone back to the Desktop.

  when five_minute_warning:
    if Night.step == 8 and Night.summons_open != true and Night.summons_closed != true:
      // w18 (B10): the programs check themselves in.
      reply 🛡 The summons: programs check themselves in with the Desktop's QR. 📍 only for a dead or lost phone (Still missing, on your NOW card).

  when zip_everyone_out:
    if Night.ended != true and Night.ending != "banished":
      reply 🗜 Bring everyone out of the Internet and zip them up.

  when advice_thwarted:
    if Night.phase == "advice" and Night.ended != true and Night.ending != "banished":
      reply ⛈ You are banished too. Go to the Internet. Then turn on him: everyone does the hand jive, together.

  when go to the bathroom for program:
    reply 🚻 {program.name} is in Bathroom Mode. Not hacking the Internet.
    if program.marked == true:
      reply ⚠️ {program.name} is marked and in Bathroom Mode. Wait for them outside; never go in.

  when bathroom_timed_out for program:
    reply 🚻 {program.name}'s Bathroom Mode timed out (15 min).

  // One readout per late program (w13 Q31): without
  // the auto sweep a late program is marked at once, and the mark's own
  // readout says they are late; the ⏰ line is only for the auto sweep
  // (a capture, no mark).
  when program_late for program:
    if Night.auto_sweep == true:
      reply !⏰ {program.name} is late for the Second Moment of Truth. Go get them.

  // The WANTED pop-out (wave 18, B3): a big readout (the booth's pop-out
  // rung), with the program's name and picture (C3).
  when marked for program:
    if program.marked_for == "chose Dare":
      // w26 (D1: the loud Dare order, still the WANTED pop-out)
      reply !!🚨 TRABOLTA'S ORDER: take {program.name} to the Internet NOW. They chose Dare at the Desktop. Find them and scan their pass: the scan is the confrontation.
    else if program.late == true and program.marked_for == "late for the Second Moment of Truth":
      reply !!🚨 {program.name} is late for the Second Moment of Truth: marked for reinstallation. Find them and scan their pass: the scan is the confrontation.
    else:
      reply !!🚨 {program.name} is marked for reinstallation ({program.marked_for}). Find them and scan their pass: the scan is the confrontation.
    if program.afk == true or (program.location == "Disk Cleanup" and Time.elapsed < program.checked_in_time + 900):
      reply ⚠️ {program.name} is in Bathroom Mode or Disk Cleanup. Wait for them outside; never go in.

  when unmarked for program:
    reply ✅ {program.name}: {how}. Off the escort list.

  when sweep_requested:
    reply 🛡 Trabolta requests a sweep of {Night.sweep_target}.

  when alarm_tripped:
    reply !🚨 Server room alarm: a second wrong combination at the patch bay. Get there. Whoever is at the cables goes to the Internet.
