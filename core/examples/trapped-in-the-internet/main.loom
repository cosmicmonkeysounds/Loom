set Night.facts_accepted = 0
set Night.r1_accepted = 0
set Night.r2_accepted = 0
set Night.r3_accepted = 0
set Night.r2_requested = 3
set Night.collection_complete = false
set Night.tallied = false
set Night.ranking = false
set Night.rank_round = 0
set Night.praised = false
set Night.shamed = false
set Night.most_trusted = "none"
set Night.least_trusted = "none"
set Night.printer_called = false
set Night.printer_vlc = false
set Night.printer_pressed = false
set Night.beans = false
set Night.zip_wave = 0
set Night.livejournal_read = false
set Night.lj_reader = "none"
set Night.scenario = 0
set Night.final_round = false
set Night.y2k_end = 0
set Night.clock_30 = false
set Night.clock_15 = false
set Night.clock_5 = false
set Night.clock_1 = false
set Night.alarms = 0
set Night.alarm_on = false
set Night.alarm_clear_at = 0
set Night.lights_before_alarm = "none"
set Night.wrong_combos = 0
set Night.heart_opened = false
set Night.heart_holder = "none"
set Night.gloat_at = 0
// The King's one shared health bar (the server knocks a point off per
// hit in the reinstallation games; 👑 restores it) and his stakes.
set Night.king_hp_max = 15
set Night.king_hp = 15
set Night.king_armed = 1
set Night.crew_door_until = 0
set Night.present = 0
set Night.stand_down_by = "none"
set Night.talked_down = false
set Night.ended = false
set Night.ending = "none"
set Night.bobber = "none"
set Night.bag_up = false
set Night.line_by = "none"
set Night.pickup_gen = 0
set Night.poll = "none"
set Night.judge_mode = "auto"
set Night.filing_open = false
set Night.filing_close = 0
set Night.r1_closed = false
set Night.r2_closed = false
set Night.r3_closed = false
set Night.card_gen = 0
set Night.results_q = 0
set Night.settle_q = 0
set Night.settle_round = 0
set Night.settle_gen = 0
set Night.bottle_open = false
set Night.bottle_picks = 0
set Night.bottle_q = 0
set Night.bottle_round = 0
set Night.bottle_pick = "none"
set Night.bottle_done = false
set Night.truth_n = 0
set Night.stimulus_n = 0
set Night.help_votes = 0
set Night.thwart_votes = 0
set Night.banish = false
set Night.recount = false
set Night.everyone_free = false
set Night.dark_room = "none"
set Night.dark_scene = "none"
set Night.lit_scene = "none"
set Night.lights_back_at = 0
set Night.dance_at = 0
set Night.takeover = false
set Night.resurrected = false
set Night.ceremony_done = false
set Night._resurrect_ask_at = 0
set Night.painting = false
set Night.signatures = 0
set Night.goals_todo = ""
set Night.sweep_target = "none"
set Night.ceremony = false
set Night.ceremony_host = "none"
set Night.award = "none"
set Night.award_title = "none"
set Night.award_winner = "none"
set Night.award_value = "none"
set Night.awards_given = 0
set Night.award_lines = "template"
// The phones' interrupt ladder (wave 13, D2; header `alerts:`): balloon <
// sticky < dialog < bsod. The story climbs it at the summons, the Y2K clock
// and the final reveal, and comes back down at Truth Pong and the ceremony;
// a host's dial holds until the next of these sets (DRAFT).
set Night.alerts = "sticky"
set Kernel.combo_a = "V2-D5,V4-D1,V6-D8,V7-D3"
set Kernel.combo_b = "V1-D6,V3-D2,V5-D7,V8-D4"
set Kernel.anti_ai = "MS Paint"
// What every program said per question (Clippy reads it at the results):
// a string from the first filing, so it starts empty, never "none".
set Kernel.said_1 = ""
set Kernel.said_2 = ""
set Kernel.said_3 = ""
set Kernel.said_4 = ""
set Kernel.said_5 = ""
set Kernel.said_6 = ""
set Kernel.said_7 = ""
set Kernel.said_8 = ""
cue lights_screensaver
set Night.lights = "screensaver"
cue screens_screensaver
set Night.screen = "screensaver"
set Night.terminals = "screensaver"
// The server-room ESP32's ring shows the real door: red = locked, which it
// always is (a standalone keypad lock the story never drives). Sent on every
// boot so a story restart puts the ring back; nothing ever sends unlocked.
do door server_room, state: locked
The house boots. A screensaver drifts across the TV above the fireplace. Somewhere a modem is waiting to be asked.
-> Facts Seed
