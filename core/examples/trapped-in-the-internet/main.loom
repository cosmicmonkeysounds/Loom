# Trapped in the Internet
start: Power On
theme: aol97
directory: everyone
judge: Trabolta
alerts: Night.alerts
currency: score as Truthcoin, max 500, expiry 10m
watch: Night.clock as Y2K clock, Night.round as Truth round, Night.judge_mode as Judge, Night.lights as Lights
watch: program.cleared as Cleared, program.marked as Marked, program.door_by as At the door
watch: program.afk as Bathroom Mode, program.late as Late, program.corrupted as In the Internet, program.checked_in as Checked in
watch: Night.results_q as Results read, while Night.phase == "truth_1"
watch: Night.scenario as Overshare scenario, while Night.scenario > 0 and Night.ended != true
watch: Kernel.majority as Majority, Night.wrong_combos as Wrong patches, Night.heart_stage as The Heart, Night.server_door as Server door, Night.door_override as Door on buttons, Night.patch_override as Patch bay on buttons, program.at_the_heart as At the heart, while Trabolta.awake == true and Night.ended != true
watch: Night.heart_talker as At his heart, Night.heart_talker_layer as Heart progress, Night.heart_talker_suspicion as Heart suspicion, while Night.heart_stage == "talk"
watch: Kernel.lies_accepted as Lies accepted, while Night.round >= 1
watch: Night.ending as Ending, while Night.ended == true
watch: Night.signatures as Signatures, while Night.painting == true
watch: Microsoft Excel, OpenOffice, MS Paint
watch: Kernel.door_code as Door code, Kernel.combo_a as Combo A, Kernel.combo_b as Combo B
watch: Night.king_hp as King HP, program.codex.the_door_code as Have the door code, while Night.ended != true
watch: Night.present as Present programs, while Night.final_round == true and Night.ended != true
countdown: Night.bingo_end as Bingo ends, while Night.bingo_on == true, for guests
countdown: Night.hunt_end as Hunt 1 ends, while Night.hunt_on == true, for guests
countdown: Night.filing_close as Filings close, while Night.filing_open == true, for guests
countdown: Night.truther_at as Truther Download, while Night.hunt2_on == true and Night.truther_sent != true
countdown: Night.warn_at as Five-minute warning, while Night.hunt2_on == true and Night.summons_open != true and Night.summons_closed != true
countdown: Night.hunt2_end as Hunt 2 ends, while Night.hunt2_on == true and Night.summons_open != true and Night.summons_closed != true, for guests
countdown: Night.summons_end as Summons closes, while Night.summons_open == true, for guests
countdown: Night.y2k_end as Midnight, while Night.final_round == true and Night.ended != true, for guests
countdown: Night.dance_at as Dance lights
wanted: program.marked as program.marked_for by program.escort_by, for Antivirus
reinstall: program.marked == true or program.corrupted == true or Night.ended == true
lock: program.corrupted == true and Night.banish != true and Night.ended != true
archive: The Uploader when program.cleared == true and program.featured == "none" and Night.ended != true
archive: Norton Anti-Virus when program.cleared == true and program.marked != true and program.corrupted != true
archive: McAfee Anti-Virus when program.cleared == true and program.marked != true and program.corrupted != true
archive: Password Manager when program.cleared == true and program.marked != true and program.corrupted != true
archive: CRA Agent Software when program.cleared == true and program.marked != true and program.corrupted != true
majority: count([p for p in Persons where p.gone != true and p.persona != true]) / 2 + 1
founding: Night.truther_sent == true and Kernel.majority_reached != true and Night.clock != "00:00" and Night.ended != true and program.cleared == true and program.corrupted != true
lobby: hidden
badge: program.afk as 🚻 Bathroom Mode
stat: self.score as ⭐ Points
stat: self.captures as 🛡 Captures, for Antivirus
stat: self.judged as ⚖️ Answers judged, for Clippy
stat: self.covert as 🤫 Quiet favours, while self.covert >= 1

// Equal parts Digimon Movie, Blade Runner, and an escape room, in a
// Web 1.0 house, with a side of existentialism.
//
// A rogue AI, Trabolta, has very nearly solved the Unified Field Theory.
// The last facts it needs are on a computer in Halifax, Nova Scotia —
// this house. It cannot get in, but it can install programs remotely,
// and it has learned to lift a consciousness out of a body and drop it
// into a program. It found a neglected billboard on Barrington Street
// advertising mapsandducks.com, registered the lapsed domain ("if there
// is a billboard downtown everyone will think it is legit"), and sent
// the invitations. Tonight the guests arrive as those programs. Some of
// them will remember they were human. (What he really wants it all for
// is Sandy.)
//
// This is the spine of the project: the groups, the rooms of the house,
// the ROLE every guest wears, the buttons the app offers (the admin ones
// are the director's cue sheet, in running order), every house rule that
// carries the night from arrivals to one of the endings, and — last —
// the opening beat. The people live under `cast/`, the scenes under
// `beats/`, the lore under `codex/`, the quest log in `quests.loom`, the
// extra chat rooms in `rooms.loom`, and the ambient hum in
// `atmosphere.loom`. The runbook, cue sheet and integration contract are
// in `README.md`.
//
// House conventions (break one and something fails silently):
// - Every story-level `when` lives HERE, before `== Power On` (a rule
//   after a beat becomes prose inside it). No other file has one.
// - Event names are single snake_case tokens. The only spaced ones are
//   the six outside code fires: go to the bathroom, back from the
//   bathroom, send to the internet, mark as reinstalled, the simulation
//   completed, the golden duck — always written `… for program`.
// - Secrets live on the hidden CHARACTER Kernel (cast/props.loom), never
//   in `Night.*`: Trabolta's worker reads every global.
// - The featured programs (cast/featured.loom) never speak. Write their
//   names as prose, never as `Name:` at the start of a line.
// - Globals start null: compare with `== true` / `!= true`, `<`, `>=`.
// - Truthcoin moves through the server's wallet (core/server/wallet.ts);
//   the rules below only narrate it. The approver and the minter are the
//   `wallet:` lines on CRA Agent Software and Runescape.
// - Every deadline watcher keeps its phase guard (null arithmetic is 0).

// ── Groups ──────────────────────────────────────────────────────────
// Nobody picks a side at the door: everyone is a program. The two staff
// castes are assigned by the cast traits (`joinable: false` keeps them
// off the app's side chooser). The two declared recruiting factions are
// hidden until the Y2K clock reveals them; from then on any program can join
// one from the app (joining fires `join`, switching fires `defect`).
// Wave 18b (R4, O7): the header's `founding:` line puts the night in
// faction mode. From the Truther Download until a majority, midnight or an
// ending, any cleared program may found a faction of its own (Start →
// Factions; the engine's crews), one faction at a time; founded factions
// race beside the two declared sides, and the majority is counted only in
// the Y2K hour. A faction's name is guest-typed: it never goes in Night.*.
// "Pursue your own interests" means joining none.

GROUP Hosts
  ethos: hospitality
  joinable: false

GROUP Antivirus
  ethos: compliance
  joinable: false

// Microsoft Excel's faction: stay in the machine forever, "so we can have
// unlimited power and joy". Excel is added at the Truther Download.
GROUP Unlimited Power
  ethos: stay in this machine forever
  rival: The Way Out
  hidden: true

// OpenOffice's faction: combine our power, overthrow Trabolta, get out.
// OpenOffice is added at the Truther Download. These are the Truthers the
// M25 pamphlet promises (decision 10): the Truther Download's lines call
// The Way Out "the Truthers"; there is no separate group.
GROUP The Way Out
  ethos: overthrow Trabolta and escape
  rival: Unlimited Power
  hidden: true

// ── The house ───────────────────────────────────────────────────────
// Every LOCATION is also a room in the app, named for the part of the
// computer it plays. Three floors and the yard: the basement (the RAM,
// the Fan Closet, the Server Room, a bathroom), the main floor (the
// Optical Drive, the Start Bar, the CPU, the Steam Room, the Desktop),
// the top floor (the Graphics Card, the Hard Drive, a bathroom), and out
// back the Cloud, with the tent (the Internet) in it. The Tube is the
// hall and the stairs that join the floors; both bathrooms are Disk
// Cleanup.
// The Desktop is declared first so a released program lands there. The
// Optical Drive is a cutscene: while a program stands there the phone is
// on rails. The house rooms are revealed per program when an Antivirus
// clears them ("ready to explore the entire computer", cast/kit.loom);
// The Internet appears once stood in; The Server Room is revealed to the
// winning faction's members, and to everyone when its door first opens
// once Trabolta is awake (The Heart) or its patch-bay alarm trips.
// (LOCATION lines carry no trailing comment: house/test reads them.)

LOCATION The Desktop
  label: The Desktop (living room)
  ambient: screensaver-hum
  capacity: 60

LOCATION The Optical Drive
  label: The Optical Drive (mud room) — Login
  ambient: pitch-black
  cutscene: true

LOCATION The Tube
  label: The Tube (hall + stairs)
  ambient: cable-rattle
  hidden: true

LOCATION The Internet
  label: The Internet (Reinstallation — backyard)
  prison: true
  sealed: true
  hidden: true
  capacity: 3

LOCATION The Start Bar
  label: The Start Bar (kitchen)
  ambient: fridge-hum
  hidden: true

LOCATION The CPU
  label: The CPU (office)
  ambient: processor-whine
  hidden: true

LOCATION The Steam Room
  label: The Steam Room (game room)
  ambient: startup-chimes
  hidden: true

LOCATION Disk Cleanup
  label: Disk Cleanup (bathrooms)
  ambient: dripping-tap
  hidden: true

LOCATION The Cloud
  label: The Cloud (backyard — Truth Pong)
  hidden: true

LOCATION The RAM
  label: The RAM (studio)
  ambient: dial-tone
  hidden: true

LOCATION The Fan Closet
  label: The Fan Closet (laundry)
  ambient: dryer-tumble
  hidden: true

LOCATION The Graphics Card
  label: The Graphics Card (bedroom 2)
  ambient: coil-whine
  hidden: true

LOCATION The Hard Drive
  label: The Hard Drive (crawl space)
  ambient: platter-spin
  hidden: true

LOCATION The Server Room
  label: The Server Room (cold storage)
  hidden: true
  checkin: false

// ── Every guest is a Program ────────────────────────────────────────
// Per-person state plus every rule that applies to one uploaded mind.
// Engine keys used but never declared: program.score (= Truthcoin, the
// ⭐ on the pass; 100 at upload), program.codex (count),
// program.codex.<slug>, program.captured, program.group, program.name,
// program.location.
//
// THE TRUST FORMULA (pasted wherever a component changes):
//   trust = truths_accepted * 10 - internet_visits * 5 - escapes * 5 + assessment
// Wave 26 (R4): `escapes` counts walks out of the simulation's mud room
// into the void (the reinstallation games, `simulation escape attempt`):
// −5 each, before his reveal too (the user's decision).
// Trabolta counts what he ACCEPTED, accurate and confident alike: he
// cannot tell a confident lie from a truth until the end. Lies are only
// ever counted on the Kernel.

ROLE Program
  // What no agent may read off a program (event server: dropped from
  // Trabolta's agent requests and the facts document, for the voice and
  // the orchestrator alike): the virus they carry or planted, the glitch
  // missions they chose and how far along they are, the dossier, the
  // frame, the centre-square secret, the 📝 filing record (the answer,
  // the slider, the verdict and the judge's proposal per question), and every
  // featured mission and leader's recruiting quest, how many of the cold
  // door's digit notes they hold and The Cold Door's progress (four of four
  // is the door code: he must never learn who holds it) (a hidden group's
  // membership the server masks itself until the group is revealed). The
  // verdicts and the anti-AI designation are on the Kernel already; the
  // orders and the virus files are `secret: true` CODEX entries
  // (codex/1-world.loom, 6-missions.loom). Wave 21: `tipped`, `slid` and
  // `slipped` (a player's quiet favour to this program) are secret too.
  secret: carries_virus, planted_virus, excel_choice, openoffice_choice, dossier_started, dossier_base, dossier_start, left_behind_text, anti_ai, framed, fact_a1, fact_a2, fact_a3, fact_a4, fact_a5, fact_a6, fact_a7, fact_a8, fact_c1, fact_c2, fact_c3, fact_c4, fact_c5, fact_c6, fact_c7, fact_c8, fact_v1, fact_v2, fact_v3, fact_v4, fact_v5, fact_v6, fact_v7, fact_v8, fact_j1, fact_j2, fact_j3, fact_j4, fact_j5, fact_j6, fact_j7, fact_j8, fact_sure, fact_n, fact_try, fact_waiting, fact_q_round, last_fact_q, fact_label, fact_h1, fact_h2, fact_h3, fact_h4, fact_h5, fact_h6, fact_f1, fact_f2, lie_q1, lie_q2, lie_q3, lie_q4, lie_q5, lie_q6, lie_q7, lie_q8, hunt_lie_q1, hunt_lie_q2, hunt_lie_q3, hunt_lie_q4, hunt_lie_q5, hunt_lie_q6, hunt_lie_q7, hunt_lie_q8, quest.excel_mission, quest.openoffice_dossier, quest.find_the_exit, quest.truthcoin_hustle, quest.master_of_the_bugs, quest.unscramble, quest.ten_findings, from_jeeves, jeeves_told, quest.the_painting, paint_told, quest.the_gold_standard, quest.go_viral, quest.keep_the_ball_in_play, quest.recruit_to_stay, quest.recruit_to_leave, recruits, door_digits, quest.the_cold_door, whole_truth, quest.a_faction_of_your_own, tipped, slid, slipped
  uploaded: bool = false
  cleared: bool = false
  captchas: 0 to 10 = 0
  human_problem: text? = none
  left_behind: text? = none
  // Wave 18b (R10): what they typed into the deposit box's card (secret).
  left_behind_text: text? = none
  skipped_orientation: bool = false
  featured: text? = none
  anti_ai: bool = false
  afk: bool = false
  afk_since: 0 to 100000 = 0
  from_jeeves: 0 to 99 = 0
  jeeves_told: 0 to 99 = 0
  signed: bool = false
  paint_told: 0 to 99 = 0
  resurrected: bool = false
  corrupted: bool = false
  internet_visits: 0 to 50 = 0
  // Wave 26 (R4): walks out of the simulation into the void; −5 trust each.
  escapes: 0 to 50 = 0
  // Wave 26 (R6): heard Trabolta's heart in the simulation (once a night).
  sim_heart: bool = false
  doubt: 0 to 100 = 0
