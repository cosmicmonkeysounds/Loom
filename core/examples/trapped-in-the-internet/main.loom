  // ♟ The King (performer button — for when the door terminal could not:
  // the terminal outside the server room posts `chess won` itself for the
  // program who mated him): the door code itself is the story rule
  // `when chess_won:`.
  when beat_the_machine for program:
    fire chess_won for program

  // ── Truthcoin (the ⭐ score): the hosts' cash bank ──
  // Corrections only: programs move their own coin from the Wallet room
  // (the rules after these narrate it). The program hears its own
  // balance; the bank's readout is in # hosts.
  when pay_truthcoin for program:
    set program.score += 100
    reply 🪙 +100 Truthcoin. Balance: {program.score}.
    broadcast "🪙 Paid {program.name} 100 Truthcoin. Balance: {program.score}." to channel(hosts)

  when charge_truthcoin for program:
    if program.score < 100:
      broadcast "🪙 {program.name} cannot cover 100 Truthcoin. Balance: {program.score}." to channel(hosts)
    else:
      set program.score -= 100
      reply 🪙 −100 Truthcoin. Balance: {program.score}.
      broadcast "🪙 Charged {program.name} 100 Truthcoin. Balance: {program.score}." to channel(hosts)

  // ── Truthcoin wallet (core/server/wallet.ts moves the coin; these narrate) ──
  // The book fires these with person ids as `from` / `to`, so they bind as
  // programs; `tx`, `amount` and `by` (the approver, or Director) are values.
  // Trades (offers) settle through `share`, so the codex rules hear those.
  when transfer_received for program:
    broadcast "~🪙 {from.name} → {program.name}: {amount} Truthcoin" to channel(truthcoin exchange)
  when transfer_denied for program:
    broadcast "🧾 Denied: {program.name} → {to.name}, {amount} Truthcoin. Refunded." to channel(hosts)
    update quest The Audit for CRA Agent Software "Denied {program.name} → {to.name}, {amount}."
    // ⭐ CRA's audit (wave 21): a denial from the CRA booth serves Trabolta.
    if by == "CRA Agent Software":
      set CRA_Agent_Software.score += 3
      set CRA_Agent_Software.trust += 3
  when transfer_approved for program:
    update quest The Audit for CRA Agent Software "Approved {program.name} → {to.name}, {amount}."
    if by == "CRA Agent Software":
      set CRA_Agent_Software.score += 3
  when offer_accepted for program:
    broadcast "~💱 {program.name} ⇄ {to.name}: a fact for {amount} Truthcoin" to channel(truthcoin exchange)
  when stimulus for program:
    broadcast "!💰 Truthcoin stimulus: {program.name} sends every program {amount}." to everyone
    set Night.stimulus_n += 1
  // Runescape's reserve powers (the C24 fact): a grant from her own phone,
  // and a freeze from her phone or the director's (the book's ten minutes).
  when grant for program:
    broadcast "🎁 {program.name} grants {to.name} {amount} Truthcoin from the reserve." to channel(truthcoin exchange)
  when wallet_frozen for program:
    broadcast "🧊 {program.name}'s Truthcoin is frozen for ten minutes. It can come in, not go out." to channel(truthcoin exchange)
  when wallet_thawed for program:
    broadcast "☀️ {program.name}'s Truthcoin moves again." to channel(truthcoin exchange)

  // ── Excel's virus (the tent QRs, and the floppy disk in the game: wave 26 R7) ──
  // Learning either "file" means carrying a virus back from the Internet.
  // On Excel's paranoid path the "antivirus" is a virus anyway.
  when program learns ILOVEYOU:
    if program.carries_virus != true:
      set program.carries_virus = true
      // w26 (R7: true for the tent's QR and the game's disk alike)
      Truther Download: You picked something up in the Internet. It is warm. It wants to be inserted.
      if program.featured == "excel":
        if program.excel_choice == "paranoid":
          update quest Excel Mission for program "You have the antivirus. Install it."
        else:
          update quest Excel Mission for program "You have the virus. Insert the disk."

  when program learns Free Antivirus Trial:
    if program.carries_virus != true:
      set program.carries_virus = true
      // w26 (R7: true for the tent's QR and the game's disk alike)
      Truther Download: You picked something up in the Internet. It is warm. It wants to be inserted.
      if program.featured == "excel":
        if program.excel_choice == "paranoid":
          update quest Excel Mission for program "You have the antivirus. Install it."
        else:
          update quest Excel Mission for program "You have the virus. Insert the disk."

  // Any carrier may plant (it rattles Trabolta and shows in the recount),
  // but only Excel's plant counts as Excel's success: it alone drives
  // overshare scenarios 1/3 and unlocks the stay majority.
  when plant_the_virus for program:
    if program.carries_virus != true:
      reply You have no disk.
    else if program.corrupted:
      reply Not from inside the Internet.
    else if program.planted_virus:
      reply The disk is already in.
    else:
      set program.planted_virus = true
      if Kernel.virus_planted != true:
        set Trabolta.composure -= 10
        set Kernel.virus_planter = program.name
      set Kernel.virus_planted = true
      reply The disk is accepted. Somewhere a fan spins up.
      if program.featured == "excel":
        set Kernel.virus_planter = program.name
        set Kernel.excel_planted = true
        complete quest Excel Mission for program "Virus planted."

  // ── The cold door's digits (wave 11) ──
  // Four secret notes hidden in the house (facts.json `door.clues`,
  // generated into codex/9-facts.loom), one digit each, scannable all
  // night. However a note arrives (a scan, a share, a sale), the story rule
  // `door_digit_found` counts them and assembles the code at four.
  when program learns Cold Door First Digit:
    fire door_digit_found for program

  when program learns Cold Door Second Digit:
    fire door_digit_found for program

  when program learns Cold Door Third Digit:
    fire door_digit_found for program

  when program learns Cold Door Fourth Digit:
    fire door_digit_found for program

  // The code in hand by any road (a checkmate, the majority, the notes)
  // settles the quest the notes started.
  when self.codex.the_door_code == true and self.quest.the_cold_door == "active":
    complete quest The Cold Door for self "The door code is in your Codex. The keypad is by the cold door in the basement."

  // ── The heart's proofs (wave 7; wave 20: the ⟦PROOF⟧ options) ──
  // His worker may share lore as a bargain; a proof he handed over himself
  // can't talk him down (the program must find it: the card, the hunt, a
  // Facts Bundle, another program).
  when program learns What Sandy Says:
    if from == Trabolta:
      set program.sandy_says_from_him = true

  when program learns The Sandy File:
    if from == Trabolta:
      set program.sandy_file_from_him = true

  // ── Trabolta's LiveJournal (TRABOLTA-4EVER, or OpenOffice's 20 facts) ──
  // Only the first real reader counts: The Whole Truth hands the entry to
  // every majority member at once, and that is not anyone reading it.
  when program learns The LiveJournal:
    set program.read_livejournal = true
    if Night.livejournal_read != true and Kernel.majority_reached != true:
      set Night.livejournal_read = true
      set Night.lj_reader = program.name
      set Trabolta.composure -= 10

  // ── Check-in ──
  // `at` must be the EXACT declared LOCATION name. Anything else — no arg,
  // lowercase, a phantom value — falls through and moves nobody. Never
  // `move program to at` (a quoted or inexact value is a phantom room).
  // M27: every room's first check-in has a small surprise. The six rooms
  // with no clue line get a one-time aside (no codex, no coin), once per
  // program per room (`aside_*`).
  when checked_in for program:
    if program.corrupted == true:
      reply You are in the Internet. Finish your reinstallation first.
    else if at == "The Desktop":
      move program to The Desktop
      set program.checked_in = "The Desktop"
      set program.checked_in_time = Time.elapsed
      if Night.summons_open == true:
        set program.summons_ok = true
        reply 📍 Checked in at the Desktop. You will not be swept.
      else:
        reply 📍 Checked in at the Desktop.
      if program.aside_desktop != true:
        set program.aside_desktop = true
        reply 📎 Clippy, from somewhere behind the couch: "It looks like you are checking in! Would you like help with that?"
    else if at == "The Start Bar":
      move program to The Start Bar
      set program.checked_in = "The Start Bar"
      set program.checked_in_time = Time.elapsed
      reply 📍 Checked in at the Start Bar.
      if program.aside_start_bar != true:
        set program.aside_start_bar = true
        reply 📎 A note taped to the microwave, in round handwriting: "Snacks are not facts. Usually. — C."
    else if at == "The CPU":
      move program to The CPU
      set program.checked_in = "The CPU"
      set program.checked_in_time = Time.elapsed
      reply 📍 Checked in at the CPU. A filing box is open on the desk, next to a very thick binder.
    else if at == "The Steam Room":
      move program to The Steam Room
      set program.checked_in = "The Steam Room"
      set program.checked_in_time = Time.elapsed
      reply 📍 Checked in at the Steam Room. Something is rolled up in a cardboard tube behind the games.
    else if at == "The Tube":
      move program to The Tube
      set program.checked_in = "The Tube"
      set program.checked_in_time = Time.elapsed
      reply 📍 Checked in at the Tube.
      if program.aside_tube != true:
        set program.aside_tube = true
        reply 📎 Every light in the Tube blinks once, all together, as if it recognises you.
    else if at == "Disk Cleanup":
      move program to Disk Cleanup
      set program.checked_in = "Disk Cleanup"
      set program.checked_in_time = Time.elapsed
      reply 📍 Checked in at Disk Cleanup.
      if program.aside_disk_cleanup != true:
        set program.aside_disk_cleanup = true
        reply 📎 A laminated sign by the sink: "Deleting temporary files. Please wash your hands."
    else if at == "The Cloud":
      move program to The Cloud
      set program.checked_in = "The Cloud"
      set program.checked_in_time = Time.elapsed
      reply 📍 Checked in at the Cloud.
      if program.aside_cloud != true:
        set program.aside_cloud = true
        reply 📎 Clippy, faintly, from inside the house: "Remember, the Cloud is just someone else's backyard!"
    else if at == "The RAM":
      move program to The RAM
      set program.checked_in = "The RAM"
      set program.checked_in_time = Time.elapsed
      reply 📍 Checked in at the RAM.
      if program.aside_ram != true:
        set program.aside_ram = true
        reply 📎 The RAM hums a little louder when you walk in. It will forget you were here.
    else if at == "The Fan Closet":
      move program to The Fan Closet
      set program.checked_in = "The Fan Closet"
      set program.checked_in_time = Time.elapsed
      reply 📍 Checked in at the Fan Closet. A coat hangs by the dryer, waiting to be washed. Check the pockets.
    else if at == "The Graphics Card":
      move program to The Graphics Card
      set program.checked_in = "The Graphics Card"
      set program.checked_in_time = Time.elapsed
      reply 📍 Checked in at the Graphics Card. A sketchbook lies open on the bed, every drawing in pixels.
    else if at == "The Hard Drive":
      move program to The Hard Drive
      set program.checked_in = "The Hard Drive"
      set program.checked_in_time = Time.elapsed
      reply 📍 Checked in at the Hard Drive. Nobody is supposed to be up here. Things get stored here so nobody reads them.
    else:
      reply That check-in point is not in this computer.

  // The performer button at the living-room door (the entity is bare,
  // never quoted).
  when check_in_at_desktop for program:
    fire checked_in for program with at: The Desktop

  // ── The Bag of Truth ──
  when brought_up_the_bag for program:
    set Kernel._pressed_by = "none"
    if Night.phase == "bobbing" and Night.bag_up != true:
      fire game_credit with points: 15, gain: 0, counts: 0
      set Night.bag_up = true
      set Night.bobber = program.name
      set program.bobbed = true
      unlock The Truth File for program
      fire bag_retrieved

  when failed_the_bob for program:
    set Kernel._pressed_by = "none"
    if Night.phase == "bobbing" and Night.bag_up != true and program.bob_failed != true:
      fire game_credit with points: 10, gain: 5, counts: 0
    if Night.phase == "bobbing" and Night.bag_up != true:
      set program.bob_failed = true
      broadcast "~🍎 {program.name} came up empty. Their status as a program is at risk." to everyone
      fire mark_for_reinstallation for program with reason: "failed the bob"

  // ── The pickup line ──
  // After truth.txt Trabolta DMs EVERYONE for the line (both branches): an
  // `answer` card keyed P1, judged by the server against facts.json. The
  // house judges it, never Trabolta (2026-10-19): he does not know the
  // line and has no power to accept one; the lines below are the house's
  // verdict in his thread, and Night.line_by (in his persona's facts) is
  // how he learns that one worked. In Grok Prom the first correct line is
  // the way out (`pickup_line_accepted` → the song); in the Song branch the
  // first correct one is flavour. A host who hears it presses 💘, or the
  // director fires `pickup_line_accepted` with the subject.
  when Night.pickup_gen > self.pickup_seen and self.cleared == true:
    set self.pickup_seen = Night.pickup_gen
    show answer "Give me a pickup line that works on Sandy. One line. I cannot tell a good one myself: say it here, and the house will judge it." to program with thread: Trabolta, question: "P1", max: 120, button: "Say it", moment: big

  // Only Grok Prom and the song hear it: after the rave he has ridden away,
  // and the advice poll, the banishment and the hand jive have moved on
  // from the line (a card answered late gets a quiet "too late").
  when answer answered for program:
    if question == "P1":
      if Night.phase != "grok_prom" and Night.ending != "song" and Night.ending != "song_pickup":
        if Night.ending == "rave":
          reply Trabolta has ridden away. Nobody reads your line.
        else:
          Trabolta: Too late for lines, {program.name}.
      else if verdict == "accurate" and Night.line_by == "none":
        if Night.phase == "grok_prom" and Night.ended != true:
          fire pickup_line_accepted for program
        else:
          set Night.line_by = program.name
          Trabolta: The house says YES. That is the line, {program.name}.
          broadcast "~💘 {program.name} knew the line." to everyone
      else if verdict == "accurate":
        Trabolta: {Night.line_by} said it first, {program.name}. But the house says yes: that is the line.
      else:
        Trabolta: The house says no. That is not the line.
    // Wave 18b (R10, D22): the deposit box's typed record (the card has no
    // `question:`, so an unbound `question` reads null). Kept in the secret
    // slot, never repeated back; the pass comes with it.
    else if question == null and program.left_behind == "deposited" and program.left_behind_text == "none":
      set program.left_behind_text = text
      Task Manager: Logged. It is not your concern. Fine.
      show pass "Hold this up. An Antivirus will scan you in. Until then you are nowhere." to program

  when pickup_line_works for program:
    set Kernel._pressed_by = "none"
    if Night.phase == "grok_prom" and Night.ended != true and Night.line_by == "none":
      fire game_credit with points: 20, gain: 0, counts: 0
    fire pickup_line_accepted for program

  // The story tells him: a line in the giver's thread, and Night.line_by.
  when pickup_line_accepted for program:
    if Night.phase == "grok_prom" and Night.ended != true:
      set Night.line_by = program.name
      Trabolta: The house says YES. That is the line, {program.name}.
      fire line_accepted

  // ── The polls: the bottle's Truth / Dare, the relationship advice ──
  // The night has two polls: the bottle's (Truth | Dare) and the advice
  // poll (Help him | Thwart him). Night.poll says which one is live, not
  // which card was tapped, and a bottle card 🗣 / 🙅 settled out loud stays
  // on the phone in dm:Trabolta beside the advice card: only the advice
  // card's own options count as a vote, so a late tap on an old bottle card
  // never votes (or spends that program's real vote).
  when poll answered for program:
    if Night.poll == "advice" and program.advice == "none" and (choice == "Help him" or choice == "Thwart him"):
      if choice == "Help him":
        set Night.help_votes += 1
        set program.advice = "help"
      else:
        set Night.thwart_votes += 1
        set program.advice = "thwart"
    else if Night.poll == "bottle" and Night.bottle_open == true and program.name == Night.bottle_pick and program.bottle_round == Night.bottle_round and program.bottle_answered != Night.bottle_round:
      set program.bottle_answered = Night.bottle_round
      if index == 1:
        set Night.bottle_open = false
        broadcast "~🎩 {program.name} chose Dare. Programs choose Truth." to everyone
        fire dare_taken for program
      else:
        set Night.truth_n += 1
        broadcast "~🗣 {program.name} chose Truth. Trabolta has a question." to everyone
        reply 🗣 You chose Truth. Trabolta asks on the TV: answer out loud, in front of everyone.
        fire truth_question

  // ── The awards ceremony (K-25) ──
  // The director fires one event per award with the winner as the
  // subject, only once `start_the_ceremony` has run. Each hook names the
  // award and the number its line reads (the winner's own var; a bonus
  // award has none). `award_won` lets a director's `value: …` override
  // it, tells the winner, and hands the line to the story rule
  // `present_award`: subject-free, so the host speaks in The Desktop
  // (where the TV voice listens), never in a DM.
  when award_most_trusted for program:
    if Night.ceremony == true:
      set Night.award = "most_trusted"
      set Night.award_title = "Most Trusted"
      set Night.award_value = program.trust
      fire award_won for program with value: value
    else:
      broadcast "🏆 Start the ceremony (G1) first: nothing was awarded." to channel(hosts)

  when award_least_trusted for program:
    if Night.ceremony == true:
      set Night.award = "least_trusted"
      set Night.award_title = "Least Trusted"
      set Night.award_value = program.trust
      fire award_won for program with value: value
    else:
      broadcast "🏆 Start the ceremony (G1) first: nothing was awarded." to channel(hosts)

  when award_frequent_flyer for program:
    if Night.ceremony == true:
      set Night.award = "frequent_flyer"
      set Night.award_title = "Frequent Flyer to the Internet"
      set Night.award_value = program.internet_visits
      fire award_won for program with value: value
    else:
      broadcast "🏆 Start the ceremony (G1) first: nothing was awarded." to channel(hosts)

  when award_lore_hoarder for program:
    if Night.ceremony == true:
      set Night.award = "lore_hoarder"
      set Night.award_title = "Lore Hoarder"
      set Night.award_value = program.codex - program.codex_in.connections
      fire award_won for program with value: value
    else:
      broadcast "🏆 Start the ceremony (G1) first: nothing was awarded." to channel(hosts)

  when award_truthcoin_tycoon for program:
    if Night.ceremony == true:
      set Night.award = "truthcoin_tycoon"
      set Night.award_title = "Truthcoin Tycoon"
      set Night.award_value = program.score
      fire award_won for program with value: value
    else:
      broadcast "🏆 Start the ceremony (G1) first: nothing was awarded." to channel(hosts)

  when award_best_liar for program:
    if Night.ceremony == true:
      set Night.award = "best_liar"
      set Night.award_title = "Best Liar"
      set Night.award_value = "none"
      fire award_won for program with value: value
    else:
      broadcast "🏆 Start the ceremony (G1) first: nothing was awarded." to channel(hosts)

  when award_duck_speedrun for program:
    if Night.ceremony == true:
      set Night.award = "duck_speedrun"
      set Night.award_title = "Golden Duck Speedrun"
      set Night.award_value = "none"
      fire award_won for program with value: value
    else:
      broadcast "🏆 Start the ceremony (G1) first: nothing was awarded." to channel(hosts)

  when award_quest_completionist for program:
    if Night.ceremony == true:
      set Night.award = "quest_completionist"
      set Night.award_title = "Quest Completionist"
      set Night.award_value = "none"
      fire award_won for program with value: value
    else:
      broadcast "🏆 Start the ceremony (G1) first: nothing was awarded." to channel(hosts)

  when award_the_painting for program:
    if Night.ceremony != true:
      broadcast "🏆 Start the ceremony (G1) first: nothing was awarded." to channel(hosts)
    else if program.featured != "mspaint":
      broadcast "🖌 G10 is MS Paint's award: {program.name} is not MS Paint. Nothing was awarded." to channel(hosts)
    else:
      set Night.award = "the_painting"
      set Night.award_title = "The Million Dollar Painting"
      if Night.signatures > 0:
        set Night.award_value = Night.signatures
      else:
        set Night.award_value = "none"
      fire award_won for program with value: value

  when award_won for program:
    if Night.ceremony == true:
      if value != null and value != "":
        set Night.award_value = value
      if Night.award_value == null:
        set Night.award_value = "none"
      set Night.award_winner = program.name
      set Night.awards_given += 1
      // The last award on the cue sheet is The Mole (G10c, wave 21; the
      // staff awards come after the programs'): G11 waits for it
      // (`staff_award_won`).
      // w18: a big moment, with the way to the TV.
      reply "!!🏆 You won {Night.award_title}! Come up to the TV for your trophy." with go: The Desktop
      fire present_award

  // ── Fan-out watchers (one run per program; late arrivals included) ──
  // Every one carries `self.cleared`, so a program still in the Optical Drive
  // hears nothing until an Antivirus scans it in.

  // Party-wide quests: catch-up for anyone cleared after the start.
  when Night.bingo_on == true and self.cleared:
    start quest The Bingo Card for self

  when Night.hunt_on == true and self.cleared:
    start quest Hunt One for self

  when Night.hunt2_on == true and self.cleared:
    start quest Hunt Two for self

  when Night.step >= 13 and Night.ended != true and self.cleared:
    start quest The Final Facts for self

  // The ad hijack: everyone but Clippy is told it is nothing.
  when Night.phase == "malware" and self.cleared:
    Trabolta: A minor irregularity has been detected and contained, {self.name}. There is no cause for concern. Please continue to enjoy the computer.

  // The Truther Download reaches each program in its own thread.
  when Night.truther_sent == true and self.cleared and self.got_truther != true:
    -> Truther Download Arrives

  // The download's blacked-out name comes through only once the story has
  // said it: at the overshare on a scenario-1 night (the only one where
  // Trabolta names Sandy), else at the recount / truth.txt, which tell
  // everyone why he did it. The correction names Sandy.
  when self.got_truther == true and ((Night.step >= 13 and Night.scenario == 1) or Night.recount == true):
    unlock The Truther Download Unredacted for self

  // OpenOffice's dossier: 20 facts she found herself, counted by category
  // since her Featured Briefing (wave 18b, R22: the handouts and her own
  // briefing never count; what she found in hunt 1 does). (Not once the
  // recount / truth.txt hands everyone every backstory: that is not her
  // work, and Bugdom's quest likewise.)
  when self.featured == "openoffice" and self.dossier_started and self.dossier_start < 10 and Night.recount != true and Kernel.majority_reached != true and self.codex_in.facts + self.codex_in.files + self.codex_in.people + self.codex_in.trabolta + self.codex_in.places - self.dossier_base >= 10:
    update quest OpenOffice Dossier for self "10 of 20 facts."

  when self.featured == "openoffice" and self.dossier_started and Night.recount != true and Kernel.majority_reached != true and self.codex_in.facts + self.codex_in.files + self.codex_in.people + self.codex_in.trabolta + self.codex_in.places - self.dossier_base >= 20:
    set Kernel.openoffice_dossier = true
    unlock The LiveJournal for self
    complete quest OpenOffice Dossier for self "20 facts. And something else: his LiveJournal."
    Truther Download: Twenty facts. You have directly accessed his context.

  // DraftKings' goal is a majority of the coin in circulation (the
  // invitation, C08): more than half of every program's Truthcoin put
  // together, hers included, counting the coin in flight (a pending or
  // held transfer, an open offer: `<who>.escrowed`, mirrored by the
  // server's wallet) as still in circulation. 1000 is a progress step. The floor (five
  // other cleared programs) keeps a near-empty rehearsal from handing
  // it to her at the glitch. The quest's own status is in the condition,
  // so a majority reached before the glitch still completes once it starts.
  when self.featured == "draftkings" and self.quest.truthcoin_hustle == "active" and self.score >= 1000:
    update quest Truthcoin Hustle for self "1000 Truthcoin. Not satisfied yet: the majority is the point."

  when self.featured == "draftkings" and self.quest.truthcoin_hustle == "active" and count([p for p in Persons where p.cleared and p.featured != "draftkings"]) >= 5 and self.score * 2 > sum([p.score + p.escrowed for p in Persons]):
    complete quest Truthcoin Hustle for self "A majority of the Truthcoin. The 49% is yours."

  // Bugdom's and Jeeves' goals carry their quest's status too (like
  // DraftKings' above): watchers fire on a false → true edge, so secrets or
  // originals held before the Truther Download starts the quest would
  // otherwise never complete it. With the status in, the edge is the start.
  when self.featured == "bugdom" and self.quest.master_of_the_bugs == "active" and Night.recount != true and self.codex.miniature_doses and self.codex.the_lamborghini_certificate and self.codex.what_happened_to_hamtaro and self.codex.the_decimal_point:
    complete quest Master Of The Bugs for self "Four secrets out of the books. You know the Antivirus better than they know themselves."

  when self.featured == "jeeves" and self.quest.unscramble == "active" and count([x for x in [self.codex.maps_and_ducks, self.codex.the_billboard_on_barrington, self.codex.the_data_centre_sinkhole, self.codex.the_pet_cemetery, self.codex.the_server_room, self.codex.the_protest_flyer, self.codex.the_domain_receipt, self.codex.casino_nova_scotia_deed, self.codex.the_valley_library_cuts, self.codex.the_cooling_log] where x]) >= 5:
    complete quest Unscramble for self "Five originals found. The fragments are starting to read."

  // Ten Findings (his invitation): ten of his findings with every cleared
  // program. Progress each time one more program reaches ten; done once
  // every cleared program has ten, with at least five of them (an early or
  // near-empty house never completes it). A program still at the door
  // doesn't block him; a late joiner does, until he reaches them.
  when self.featured == "jeeves" and Kernel.jeeves_reached > self.jeeves_told:
    set self.jeeves_told = Kernel.jeeves_reached
    if Kernel.jeeves_reached == 1:
      update quest Ten Findings for self "1 program has ten of your findings."
    else:
      update quest Ten Findings for self "{Kernel.jeeves_reached} programs have ten of your findings."

  when self.featured == "jeeves" and self.quest.ten_findings == "active" and count([p for p in Persons where p.cleared and p.featured != "jeeves"]) >= 5 and count([p for p in Persons where p.cleared and p.featured != "jeeves" and p.from_jeeves < 10]) == 0:
    complete quest Ten Findings for self "Ten findings with every program. The Map Librarian job is yours."

  // The Million Dollar Painting (her invitation): progress per signature;
  // done once every cleared program but her has signed, with at least
  // five of them (as Ten Findings).
  when self.featured == "mspaint" and Night.signatures > self.paint_told:
    set self.paint_told = Night.signatures
    if Night.signatures == 1:
      update quest The Painting for self "1 program has signed."
    else:
      update quest The Painting for self "{Night.signatures} programs have signed."

  when self.featured == "mspaint" and self.quest.the_painting == "active" and count([p for p in Persons where p.cleared and p.featured != "mspaint"]) >= 5 and count([p for p in Persons where p.cleared and p.featured != "mspaint" and p.signed != true]) == 0:
    complete quest The Painting for self "Every program has signed. The painting goes to auction."

  // The summons: everyone cleared is expected at the Desktop.
  when Night.summons_open == true and self.cleared:
    set self.summoned = true

  // Late: not checked in, not in Bathroom Mode, not already in the
  // Internet. Every Enforcer's booth hears `program_late`.
  // Only while the summons phase lasts (until Truth Pong), and once: a
  // program released from the Internet at the end of the night is not late.
  when Night.summons_closed == true and Night.phase == "summons" and self.late != true and self.summoned and self.summons_ok != true and self.afk != true and self.corrupted != true:
    set self.late = true
    fire program_late for self
    reply "!⏰ You are late. An Antivirus is coming for you." with go: pass as "🎟 Show my pass", go: mission as "What happens now?"
    if Night.auto_sweep == true:
      capture self into The Internet
    else:
      fire mark_for_reinstallation for self with reason: "late for the Second Moment of Truth"

  // The Trust Chart and the printer.
  when Night.phase == "trust_chart" and self.cleared:
    unlock The Trust Chart for self

  // VLC is only asked while VLC is out of the Internet (`Print The
  // Certificate` sets Night.printer_vlc); a VLC swept into the tent before
  // the call is never told to press a button it can't reach, and MS Paint
  // is never told to encourage a VLC who wasn't asked.
  when Night.printer_vlc == true and Night.beans != true and self.featured == "mspaint" and self.cleared and not self.captured:
    Truther Download: The printer. VLC will not open it on their own. Encourage them. Open it up.

  when Night.printer_vlc == true and Night.beans != true and self.featured == "vlc" and self.cleared and not self.captured:
    Truther Download: Press START on the printer. When nothing happens, look inside.

  when Night.beans == true and self.cleared:
    unlock The Printer for self

  // The zip: everyone in the Internet is zipped up and brought out. Keep
  // these two in this order: a captured program is released and zipped,
  // everyone else just marks the wave as seen, so a program captured
  // afterwards stays captured.
  when self.captured and self.zip_seen < Night.zip_wave:
    set self.zip_seen = Night.zip_wave
    set self.zipped = true
    release self from The Internet
    -> Zipped

  when not self.captured and self.zip_seen < Night.zip_wave:
    set self.zip_seen = Night.zip_wave

  // The ranking machinery (Trust Chart, Final Assessment, the recount):
  // the top and bottom cleared programs name themselves into Night.* and
  // fire an unbound event, so the public beats can say their names. The
  // flag is set in the body so a tie goes to the first program, not the
  // last.
  when Night.ranking == true and Night.praised != true and self.cleared and count([p for p in Persons where p.cleared and p.trust > self.trust]) == 0:
    set Night.most_trusted = self.name
    set Night.praised = true
    fire praise_the_top

  // (On an all-way tie the top program is not also named the bottom one,
  // unless it is the only cleared program.)
  when Night.ranking == true and Night.shamed != true and self.cleared and (self.name != Night.most_trusted or count([p for p in Persons where p.cleared]) < 2) and count([p for p in Persons where p.cleared and p.trust < self.trust]) == 0:
    set Night.least_trusted = self.name
    set Night.shamed = true
    fire shame_the_bottom

  // The final round: each program's orders, by who they are.
  when Night.final_round == true and self.cleared:
    set self.zipped = false
    unlock The Y2K Clock for self
    unlock The Cold Door for self
    if self.featured == "excel":
      -> Excel Final Round
    else if self.featured == "openoffice":
      -> OpenOffice Final Round
    else:
      -> Program Final Round

  // Any ending sends everyone away from his heart (the terminal's own
  // `terminal closed` may never come: it falls asleep with the night).
  when Night.ended == true and self.at_the_heart == true:
    set self.at_the_heart = false

  // One server-room terminal: the program it opened a line for last is the
  // only one at his heart (a close that never landed can't keep anyone else).
  // Their heart to heart and any held pick end with it, as a close would.
  when self.at_the_heart == true and Night.heart_holder != self.name:
    set self.at_the_heart = false
    set self.heart_chat = false
    set self.heart_wait = false
    set self.heart_quiet = false

  // ── The Heart (wave 20) ──
  // A pick held while the door stood open plays once it is shut, if the
  // program is still at the terminal (a re-scan is `terminal_opened`'s,
  // which clears heart_wait first, so the two never dock two menus).
  // Only while the talk is open: a held pick never reopens a heart that is
  // done (a shutdown) or sealed again (🔄).
  // After Heart Sealed greets a program already in front of him, the talk
  // waits out its 6 s room scene (Night.heart_resume_at), so the terminal
  // shows it before the layer's own scene replaces it.
  when Night.server_door == "closed" and self.heart_wait == true and self.at_the_heart == true and Night.ended != true and Night.r3_closed != true and (Night.heart_stage == "scan" or Night.heart_stage == "talk") and Time.elapsed >= Night.heart_resume_at:
    set self.heart_wait = false
    set Night.heart_stage = "talk"
    if self.heart_pick != "none":
      -> Heart Pick
    else:
      -> Heart Talk

  // 🔄 forgives: a program thrown out of his heart may come back, and
  // everyone's suspicion starts again (their layer and case stay); a pick
  // held for a shut door is dropped.
  when Night.heart_gen > self.heart_gen_seen:
    set self.heart_gen_seen = Night.heart_gen
    set self.heart_out = false
    set self.heart_suspicion = 0
    set self.heart_warned = false
    set self.heart_chat = false
    set self.heart_wait = false
    set self.heart_pick = "none"
    // Still standing at the terminal when it reopened: they are in front
    // of him already (Heart Sealed says so) and their talk resumes once
    // The Heart has played and the door is shut again.
    if self.at_the_heart == true and Night.heart_holder == self.name and Night.heart_stage == "sealed":
      set self.heart_wait = true
      set Night.heart_present = true
      // Wave 27: they never left, so the resumed Heart Talk says no "you
      // came back" (heart_quiet; Heart Talk clears it, a close clears it).
      set self.heart_quiet = true

  // An ending, an eject, a closed terminal or 🔄 ends any heart to heart.
  when Night.ended == true and self.heart_chat == true:
    set self.heart_chat = false

  // The majority's members get the whole truth (late pledgers too), once
  // each (wave 18b: any faction; `whole_truth` keeps a leave-and-rejoin
  // from replaying it).
  when Kernel.majority_reached == true and faction_of(self) == Kernel.majority_id and self.whole_truth != true:
    set self.whole_truth = true
    -> The Whole Truth

  // A founder's own quest settles with the race (wave 18b).
  when Kernel.majority == "founded" and self.quest.a_faction_of_your_own == "active":
    if self == Kernel.majority_founder:
      complete quest A Faction Of Your Own for self "More than half of the computer walked through your door."
    else:
      fail quest A Faction Of Your Own for self "Another faction got there first."

  // The recount / truth.txt: every program's true identity, to everyone —
  // the identity entries (codex/5-people.loom) and the two CHARACTER FACTS
  // each invitee has in the books (codex/9-facts.loom).
  when Night.recount == true and self.cleared:
    unlock Tippi MacDonald for self
    unlock The Memorial Veterinary Clinic for self
    unlock Failed Clippy for self
    unlock Middle Management for self
    unlock Replaced By Clippy for self
    unlock Sheryl Terrio for self
    unlock The Pirated Masterclass for self
    unlock The Attendant for self
    unlock The Oscars Of Bathrooms for self
    unlock Julie Horton-Norton for self
    unlock Miniature Doses for self
    unlock Stable Island for self
    unlock John McAfee for self
    unlock The Lamborghini Certificate for self
    unlock Keep Them On Track for self
    unlock Bridget Troelsen for self
    unlock What Happened To Hamtaro for self
    unlock Founding Moderator for self
    unlock Sharon Penney for self
    unlock The Decimal Point for self
    unlock Approve Or Deny for self
    unlock The Setup Assistant for self
    unlock Randy Barkmore Sr for self
    unlock The Escalade In The Sinkhole for self
    unlock Mayor Of The Metaverse for self
    unlock Dana Anderson for self
    unlock The Halifax Water Hack for self
    unlock This Is Blackmail for self
    unlock Crab Fisherwoman for self
    unlock The Coin Toss Of The Century for self
    unlock Forty Nine Percent for self
    unlock Bea Nunes for self
    unlock The Ants In The Laptop for self
    unlock A Hundred Hours for self
    unlock Virgil Jeeves for self
    unlock The Jeopardy Callback for self
    unlock Ten Findings For Everyone for self
    unlock Poppy Van Mises for self
    unlock Infinite Gold for self
    unlock Minister Of Economic Development for self
    unlock Maria Sophia Paine for self
    unlock Four Failed Theses for self
    unlock The Million Dollar Painting for self
    unlock Victor Louis Christianson for self
    unlock Tennis For Two for self
    unlock The Truth File for self

  // Banished (the thwarted-advice ending): everyone to the Internet, and
  // everyone learns the weakness he blurted.
  when Night.banish == true and self.cleared and self.banished != true:
    set self.banished = true
    capture self into The Internet
    unlock The Hand Jive Exception for self

  // The endings that let everyone go.
  when Night.everyone_free == true and self.captured:
    release self from The Internet

  // G11, the resurrection (after the ceremony): the show is over. The mark
  // comes off (`unmarked`), any director's restriction too; the
  // everyone_free watcher above lets the captured go.
  when Night.resurrected == true and self.cleared and self.resurrected != true:
    set self.resurrected = true
    set self.banished = false
    if self.marked == true:
      fire unmarked for self with how: "resurrected"
    unrestrict self

  // Combo B: everyone dies. The wording follows the side you chose.
  when Night.ending == "destroyed" and self.cleared:
    if self.group == Unlimited_Power:
      The Uploader: You chose to stay in the machine forever. You got your wish. The machine is gone, and you went with it.
    else if self.group == The_Way_Out:
      The Uploader: You fought to get out. You did: into purgatory, with everyone else. Your body is in the Maps and Ducks building. It is not breathing.
    else if faction_of(self) != null:
      // w18b (R4): a founded faction's member.
      The Uploader: {faction_name(faction_of(self))} wanted its own way out. It got the same one as everyone. Your body is in the Maps and Ducks building. It is not breathing.
    else:
      The Uploader: Your body is in the Maps and Ducks building. It is not breathing.

// ── The buttons the app offers ──────────────────────────────────────
// Every INTERACTION is a named event. `admin` ones are the director's cue
// sheet, declared in running order (labels carry the source prompt codes:
// C = app, V = monitor, Clippy N/X). Fire them from Run → Events /
// quick-fire, never from a performer's guest card (a guest-card press
// carries that character as the actor, so only its hooks would hear).
// `sequence: false` marks a cue a machine fires (the duck game, the door
// contact, the printer, the patch bay, the door terminal's King), and every optional,
// anytime or fallback cue that is not the night's next step (🔄, 🗳,
// 🪩, 💡, the timers' own steps: C2 ⏰, 📥, ⏳, 🚨 and
// 🎆 midnight) — the sheet ticks it but it never becomes LAST / NEXT, so a
// duck find or a 💡 can't eat the next cue, and a timed window (hunt 1,
// hunt 2's hour, the summons, the Y2K hour) suggests nothing until its
// timer fires: a tap on the fallback would cut it short.
// From V6 on, each step's `while:` names its own window (Night.step /
// Night.phase), so NEXT never skips ahead while a timer runs. A `while:`
// only steers NEXT: every rule still guards its own press.
// `act:` opens a section of the director's sheet (carried forward; it
// never changes NEXT): B, C, D, E, F and G are the README's sections, and
// `act: Anytime` (💡, the reinstallation cues) is the always-open line.
// The Director page's glance column and countdowns are the `watch:` /
// `countdown:` lines at the top of this file: they must stay in the
// header block (above the first item — a beat, declaration or rule ends
// the header; blank and comment lines don't) and in this file only — the
// server reads the first header. *At the heart* counts programs with
// `at_the_heart` (Night.heart_holder keeps the last name after they walk
// away); *Overshare scenario* shows from 🤖 until the ending.
// `, for guests` puts a countdown on every guest's phone too, under the
// room header: only the clocks the guests are told about out loud (Bingo,
// hunt 1, the last-chance filing, the summons, midnight). The Truther
// Download, the five-minute warning and the dance lights stay the
// director's: each one is a surprise the countdown would give away.

// Wave 21 (reverses wave 18's B6 / Q2): Clippy is a player, not a caller.
// The hosts (Task Manager, Adobe Acrobat, the Recycling Bin, from their
// host dock) and the directors (Run, the director phone) call every cue
// here, the games included; no admin cue carries `by:` (a player is never
// a caller, lint L1222). Each game a host calls pops out on Clippy's booth
// as YOUR GAME IS ON (Clippy's hooks, cast/hosts.loom).
INTERACTION call_to_the_desktop
  label: C1/V1 · 📣 Call everyone to the Desktop
  who: admin
  act: B · Act I: the Desktop, Bingo and the first truth
  description: The inciting event. Push alert, house announcement, every screen.

INTERACTION start_the_bingo
  label: V2 · 🎱 Start Computer Bingo (20 min)
  who: admin

INTERACTION bingo_time
  label: V3 · ⏰ Bingo time: results
  who: admin
  // w26 (B1, B2: the description)
  description: Clippy's game is on (Instructions 2/X). Norton is the selected Antivirus. A guest's 🎱 BINGO! presses it for you; after a ↩ Not a Bingo it is NEXT again.
  // Wave 26 (B2): ↩ Not a Bingo puts the night back at step 2, so ⏰ may
  // fire again; NEXT reads it again while Bingo is on. The rule's own
  // `if Night.step < 3` stays the real guard.
  repeat: true
  while: Night.step == 2

INTERACTION introduce_trabolta
  label: Clippy 2/X · 🤖 Clippy introduces Trabolta
  who: admin
  description: Only after the Bingo results. Trabolta comes online; check the terminals show his face.

INTERACTION start_the_hunt
  label: V4/V5 · 🔎 Truth Scavenger Hunt 1 (15 min)
  who: admin

INTERACTION hunt_time_up
  label: C2 · ⏰ Hunt over: everyone back to the Desktop (auto at 15 min)
  who: admin
  sequence: false

INTERACTION first_moment_of_truth
  label: V6 · ⚖️ First Moment of Truth
  who: admin
  description: Opens judging. Clippy's game is on (Instructions 3/X).
  while: Night.step == 6 and Night.judging != true

INTERACTION close_the_filing
  label: ⏱ Close round-one filings now (auto at 2 min)
  who: admin
  description: Ends the last-chance window early. Results can be read only once it is closed. A closed round never reopens.
  while: Night.filing_open == true

INTERACTION read_the_results
  label: 📋 Results: the next question (press for Q1, Q2, Q3)
  who: admin
  description: Trabolta reads one question's result on the TV; the filings for it are settled (+50 / marked). After Q3: Truth or Dare (🍾).
  repeat: true
  while: Night.phase == "truth_1" and Night.results_q < 3

// Wave 18b (R21): Truth or Dare comes after all three results, before
// hunt 2. Five spins are NEXT's budget, not a hard cap.
INTERACTION spin_the_bottle
  label: 🍾 Spin the bottle: Truth or Dare (after the three results)
  who: admin
  repeat: true
  description: After all three results. Picks a cleared program (not marked, away or in the Internet) not yet picked tonight. Trabolta asks on the TV; their phone gets Truth / Dare. NEXT offers five spins; spin more if you like, then 📺.
  while: Night.phase == "truth_1" and Night.results_q >= 3 and Night.bottle_open != true and Night.bottle_picks < 5 and Night.bottle_done != true

INTERACTION second_hunt_preview
  label: 📺 Preview hunt 2 → the ad hijack
  who: admin
  act: C · The malware, the hour, the Truther Download
  while: Night.step == 6 and Night.bottle_open != true

INTERACTION start_the_second_hunt
  label: 📓 Hunt 2 → quest logs; disperse for 1 hour
  who: admin
  while: Night.step == 7

INTERACTION truther_download
  label: 📥 Truther Download (auto at +2 min)
  who: admin
  sequence: false
  while: Night.step >= 8 and Night.truther_sent != true and Night.ended != true

INTERACTION five_minute_warning
  label: ⏳ Five-minute warning (auto at 55 min)
  who: admin
  sequence: false

INTERACTION summons_closed
  label: 🚨 Summons closed: late list (auto at +5 min)
  who: admin
  sequence: false

INTERACTION truth_pong
  label: 🏓 Truth Pong
  who: admin
  act: D · Act II: Truth Pong, the Trust Chart, the beans
  while: Night.step == 9 and Night.summons_closed == true

INTERACTION round_two_tally
  label: 🧮 Trabolta tallies round 2
  who: admin
  while: Night.phase == "truth_pong" and Night.tallied != true

INTERACTION trust_chart
  label: 📊 Trust Chart
  who: admin
  description: Trabolta's assess power is live from here. To set an assessment by hand, edit <guest>.assessment AND <guest>.trust before the rankings.
  while: Night.step == 10

INTERACTION show_the_rankings
  label: 🏆 Praise the top, humiliate the bottom, VLC prints
  who: admin
  while: Night.phase == "trust_chart" and Night.rank_round < 1

INTERACTION printer_button_pressed
  label: 🖨 Printer: START pressed (hardware fallback)
  who: admin
  sequence: false

INTERACTION printer_opened
  label: 🫘 Printer opened: full of beans (hardware fallback)
  who: admin
  sequence: false

INTERACTION zip_everyone_out
  label: 🗜 Antivirus zip everyone out of the Internet
  who: admin
  sequence: false

INTERACTION trabolta_overshares
  label: 🤖 Trabolta shares the next facts (scenario 1–4)
  who: admin
  while: Night.step >= 11 and Night.step < 14 and Night.scenario == 0 and Night.clock == "--:--"

INTERACTION y2k_clock
  label: 🕚 System clock → 11 PM, 31 Dec 1999 (final round, 60 min)
  who: admin
  act: E · Act III: the Y2K hour and the server room
  description: Fire only after the patch-bay watch radios IN (inside the server room, door shut). From here the patch bay judges its own cables (the bay on the server-room terminal posts each full patch); the watch stays inside as the fallback, with the 🔌 💥 ❌ buttons.
  while: Night.step < 14 and Night.scenario != 0 and Night.clock == "--:--"

INTERACTION y2k_midnight
  label: 🎆 Midnight (auto at 60 min)
  who: admin
  sequence: false

INTERACTION server_door_opened
  label: 🚪 Server room door opened (sensor fallback)
  who: admin
  sequence: false
  description: The door sensor on the server-room terminal reports this itself. Press it when the sensor is wrong or in fault (Run → Terminals). Once Trabolta is awake the first opening plays The Heart and asks for the door to be shut; an opening during his heart stops the talk until it is shut. Pressing it hands the door to the 🚪 buttons until 🚪 Trust the door sensor. Before he is awake, inside a 🔧 crew window, or after truth.txt it only tells # hosts. It never raises an alarm.

INTERACTION reset_server_room
  label: 🔄 Server room: reset the patch-bay alarm
  who: admin
  sequence: false
  description: After a rehearsal, or a wrong patch the crew forgave. Clears the wrong-combination count (the patch bay forgives one again), the alarm latch and the door cutscene (the next opening plays The Heart again). Lights stay as they are (💡 restores them). A patch bay on the buttons stays on them (🔌 Trust the patch bay hands it back). The keypad lock is standalone: nothing in the story locks or unlocks it.

INTERACTION chess_won
  label: ♟ They beat the King: the door code (fallback)
  who: admin
  sequence: false
  description: The terminal outside the server-room door posts this itself, for the program who checkmated the King on it. Press it, naming the winner, when the door terminal could not. Until truth.txt the winner gets The Door Code in their Codex (once; a second win changes nothing). With no winner named it only reminds # hosts to press ♟ on the winner's card.

INTERACTION force_majority_stay
  label: 🗳 Force the majority: Unlimited Power (stay)
  who: admin
  sequence: false
  description: Final round only, when ghosts block a clear majority at the Y2K head count (OP-11). Runs the majority exactly once.

INTERACTION force_majority_leave
  label: 🗳 Force the majority: The Way Out (leave)
  who: admin
  sequence: false
  description: Final round only, when ghosts block a clear majority at the Y2K head count (OP-11). Runs the majority exactly once.

// Wave 18b (R4): a program's own founded faction can be forced too.
INTERACTION force_their_majority
  label: 🗳 Force the majority: this program's faction
  who: admin
  sequence: false
  description: Final round only. Fire it naming a member of the faction (any faction: a founded one or a side). Runs the majority exactly once, for that faction.

// DRAFT w22: the patch bay judges itself (the M4 on the server-room
// terminal), so these three are its fallbacks, like 🚪 is the door's.
INTERACTION patch_combo_a
  label: 🔌 Patch: Combo A, disable Trabolta (hardware fallback)
  who: admin
  sequence: false
  description: The patch bay on the server-room terminal judges its own cables. Press it only when Combo A is in and nothing happened (the bay is wrong or in fault: Run → Terminals). In the Y2K hour a press hands the patch bay to the 🔌 💥 ❌ buttons until 🔌 Trust the patch bay.

INTERACTION patch_combo_b
  label: 💥 Patch: Combo B, self-destruct (hardware fallback)
  who: admin
  sequence: false
  description: The patch bay on the server-room terminal judges its own cables. Press it only when Combo B is in and nothing happened (the bay is wrong or in fault: Run → Terminals). In the Y2K hour a press hands the patch bay to the 🔌 💥 ❌ buttons until 🔌 Trust the patch bay.

INTERACTION patch_rejected
  label: ❌ Patch: wrong combination (hardware fallback)
  who: admin
  sequence: false
  description: The patch bay on the server-room terminal judges its own cables. Press it only when four cables are in, neither combination, and nothing happened, or a cable runs top-to-top or bottom-to-bottom (the bay can't see those). A press inside a minute of the bay's own rejection is not counted twice. In the Y2K hour a press hands the patch bay to the 🔌 💥 ❌ buttons until 🔌 Trust the patch bay.

INTERACTION talked_down
  label: 🕊 Trabolta stands down (talked down)
  who: admin
  description: When # hosts reads "🕊 Trabolta has stood down for X" (a program reached the end of his heart's talk at the server-room terminal, at any hour): your sign-off ends the night. NEXT points here while his stand-down waits for you. The Combo A ending without a cable: the blackout, the dance, the recount, which says who talked him down. With 🕊 Heart autoend turned on it fires itself 25 s after his goodbye; press it to end it at once. With no stand-down on record it still works from the Y2K hour (the director's call) and # hosts is told so. Before any ending.
  while: Night.heart_stage == "done" and Night.stand_down_by != "none" and Night.ended != true and Night.r3_closed != true
  urgent: true

INTERACTION lights_dance
  label: 🪩 Dance lights (fallback: auto 10 s after the blackout)
  who: admin
  sequence: false

INTERACTION restore_the_lights
  label: 💡 Restore the house lights
  who: admin
  act: Anytime
  sequence: false

// From 🌑 on, each cue's `while:` names the branch of the night it belongs
// to, so the cue sheet's NEXT follows the ending tonight is on (it never
// gates the press: every rule below still checks for itself).
INTERACTION final_reveal
  label: 🌑 Final Truth Scavenger Hunt reveal
  who: admin
  act: F · The final reveal and the endings
  while: Night.ended != true and Night.step >= 14 and Night.step < 16 and Night.final_round != true

INTERACTION bobbing_for_truth
  label: 🍎 Bobbing for Truth
  who: admin
  while: Night.ended != true and Night.step == 16

INTERACTION read_truth_txt
  label: 📄 Read truth.txt
  who: admin
  description: After 🍎 Brought up the Bag. truth.txt goes up on every screen and the bobber reads it aloud; round three closes. Nothing else happens until ⚖.
  while: Night.phase == "bobbing" and Night.r3_closed != true

INTERACTION the_verdict
  label: ⚖ truth.txt read → the verdict
  who: admin
  description: When the bobber has finished reading truth.txt. Every answered fact accurate → the song; any lie on record → Grok Prom.
  while: Night.phase == "bobbing" and Night.ended != true

INTERACTION no_pickup_line
  label: 💔 Nobody has the line → confession → rave
  who: admin
  while: Night.phase == "grok_prom" and Night.ended != true

INTERACTION ask_for_advice
  label: 💌 (Alt, after a lie → Grok Prom) Trabolta begs for relationship advice
  who: admin
  while: Night.phase == "grok_prom" and Night.ended != true

INTERACTION advice_tally
  label: 🗳 (Alt) Count the advice poll
  who: admin
  while: Night.phase == "advice" and Night.ended != true

INTERACTION advice_helped
  label: 💞 (Alt) They helped him
  who: admin
  while: Night.phase == "advice" and Night.ended != true

INTERACTION advice_thwarted
  label: ⛈ (Alt) They thwarted him: banish everyone
  who: admin
  while: Night.phase == "advice" and Night.ended != true

INTERACTION the_hand_jive
  label: 🕺 (Alt) Everyone hand-jived: Trabolta crashes
  who: admin
  while: Night.ending == "banished" and Night.ended != true

// G. The awards ceremony (K-25), after any final ending. Each award is
// fired WITH THE WINNER AS THE SUBJECT (the cue sheet asks for one),
// picked from the recap numbers. `value: …` overrides the number the
// line reads (the bonus awards have none of their own: leave it empty
// and the line reads without one). Firing an award again corrects it.
// After a server-room ending (any time from 🕚, even after 🌑 or 🍎): the
// ending's own cue, then the ceremony.
INTERACTION trabolta_recounts
  label: 🏍 After the dance: weakened Trabolta recounts
  who: admin
  while: Night.ending == "disabled" and Night.rank_round != 3

INTERACTION clippy_reads_summary
  label: 🪦 After the dance: Clippy reads the summary (a host calls it)
  who: admin
  while: Night.ending == "destroyed"

INTERACTION own_award_lines
  label: ✍ Our own award lines (Trabolta hosts): on / off
  who: admin
  act: G · The awards ceremony
  sequence: false
  description: For a second director who prepared Trabolta's award lines (job 9.2). Press it once (any time before the awards): each award then plays its fanfare and slide but skips Trabolta's template line, and you post yours as Trabolta in The Desktop right after you fire the award (the TV speaks it). Press again to bring the template lines back. Clippy's lines (after destroyed / rave), the sounds and the slides never change.

INTERACTION start_the_ceremony
  label: G1 · 🏆 Start the awards ceremony (after the ending)
  who: admin
  description: Only once the night has ended. Trabolta hosts; Clippy hosts after destroyed and rave, and reads every line aloud. The three staff awards (G10a–c) come after the programs' awards.
  while: Night.ended == true and Night.ceremony != true

INTERACTION award_most_trusted
  label: G2 · 🥇 Award: Most Trusted (winner = top trust)
  who: admin
  while: Night.ceremony == true

INTERACTION award_least_trusted
  label: G3 · 🫘 Award: Least Trusted (winner = bottom trust)
  who: admin
  while: Night.ceremony == true

INTERACTION award_frequent_flyer
  label: G4 · ✈️ Award: Frequent Flyer to the Internet (most visits)
  who: admin
  while: Night.ceremony == true

INTERACTION award_lore_hoarder
  label: G5 · 📚 Award: Lore Hoarder (most codex entries)
  who: admin
  while: Night.ceremony == true

INTERACTION award_truthcoin_tycoon
  label: G6 · 🪙 Award: Truthcoin Tycoon (most Truthcoin)
  who: admin
  while: Night.ceremony == true

INTERACTION award_best_liar
  label: G7 · 🎲 Bonus: Best Liar (value = lies accepted)
  who: admin
  while: Night.ceremony == true

INTERACTION award_duck_speedrun
  label: G8 · 🎲 Bonus: Golden Duck Speedrun (value = the time)
  who: admin
  while: Night.ceremony == true

INTERACTION award_quest_completionist
  label: G9 · 🎲 Bonus: Quest Completionist (value = quests done)
  who: admin
  while: Night.ceremony == true

INTERACTION award_the_painting
  label: G10 · 🖌 Bonus: The Million Dollar Painting (winner = MS Paint; value = signatures)
  who: admin
  description: Only when MS Paint is at the party, and only on MS Paint (any other program is refused in # hosts). Reads the 🖌 Signed count unless value is given; the canvas itself is physical.
  while: Night.ceremony == true and Night.painting == true

// Wave 21: the staff awards, after the programs' (G10, or G9 with no MS
// Paint) and before G11, so NEXT walks into them (G11 and every Anytime /
// E cue after it moves down three numbers). No subject: the story reads the five players' numbers and names
// the winner (a tie goes to the first of Clippy, Norton, McAfee, Password
// Manager, CRA). The Mole (G10c) is the last award.
INTERACTION award_staff_trusted
  label: G10a · 🛡 Staff award: Trabolta's Favourite Staff (top staff trust)
  who: admin
  while: Night.ceremony == true
  description: Clippy or an Antivirus: whoever Trabolta trusts most on his chart's staff rows.

INTERACTION award_staff_points
  label: G10b · ⭐ Staff award: Staff Player Of The Night (most points)
  who: admin
  while: Night.ceremony == true
  description: Clippy or an Antivirus: the most ⭐ Points.

INTERACTION award_staff_mole
  label: G10c · 🤫 Staff award: The Mole (most quiet favours; the last award)
  who: admin
  while: Night.ceremony == true
  description: The player who did the programs the most quiet favours behind Trabolta's back, revealed here for the first time (nobody, if nobody did). The last award: G11 waits for it.

INTERACTION resurrection
  label: G11 · 🎃 Resurrection: the show is over (after the ceremony)
  who: admin
  description: Only once the ceremony has started (G1), after the last award (G10c, The Mole; before it # hosts asks you to press again within 30 seconds). Frees, unmarks and unrestricts everyone, takes the pins down, puts Trabolta to sleep (the screens go to attract), restores the lights and tells every phone they are human again. Once.
  // Wave 21: NEXT waits for The Mole (G10c), never the press.
  while: Night.ceremony == true and Night.ceremony_done == true

INTERACTION the simulation completed
  label: Reinstallation: simulation completed (server)
  who: admin
  act: Anytime
  sequence: false
  description: Fired by the reinstallation games (headset or tablet) for one program when they reach Gerald, the golden duck. Releases a corrupted program.

INTERACTION the golden duck
  label: Reinstallation: the golden duck (server)
  who: admin
  sequence: false
  description: Fired by the reinstallation games right after the simulation completes, for whoever found the duck (a captured or marked program; after an ending, anyone, as a party favour).

INTERACTION reinstallation begun
  label: Reinstallation: begun at the tent (server)
  who: admin
  sequence: false
  description: Fired by the reinstallation games (tablet or headset) for one program when their run begins at the tent, before the game reads whether they are captured. Captures a marked program, so a missed 🛡 never leaves them marked after Gerald; never after an ending (a party favour).

// Wave 11, appended so no cue number moves (they ride Anytime, the act
// above): the King's shared health bar and the crew's own door window.
INTERACTION restore_the_king
  label: 👑 Restore the King's health (the simulation)
  who: admin
  sequence: false
  description: The King's one health bar is shared by every program all night and never regenerates: each hit in a reinstallation game knocks a point off, and the lower it is the worse he plays at the door terminal. This puts him back to full (a rehearsal, or a bar knocked down too early). # hosts is told.

INTERACTION crew_through_the_door
  label: 🔧 Crew going through the server-room door (2 min)
  who: admin
  sequence: false
  description: Before a crew member opens the cold door for the crew's own reasons (a check, the patch-bay watch going in or out). For the next 2 minutes a door opening only tells # hosts: The Heart is not spent and nobody's phone hears of it. The server-room Antivirus has the same button.

// Wave 20, appended so no cue number moves; they rejoin the server-room
// act (E) beside 🚪 opened: the door sensor's other fallback, handing the
// door back to the sensor, and the heart's autoend toggle.
INTERACTION server_door_closed
  label: 🚪 Server room door closed (sensor fallback)
  who: admin
  act: E · Act III: the Y2K hour and the server room
  sequence: false
  description: Press it when the door sensor is wrong or in fault (Run → Terminals). From then on the story follows the 🚪 buttons, not the sensor, until 🚪 Trust the door sensor. The heart's talk waits for the door to be shut.

INTERACTION server_door_trust
  label: 🚪 Trust the door sensor again
  who: admin
  sequence: false
  while: Night.door_override == true
  description: After a 🚪 opened / closed press: hands the door back to the sensor on the server-room terminal (its next poll brings the story in line with the real door).

INTERACTION heart_autoend
  label: 🕊 Heart: end the night on his own (toggle)
  who: admin
  sequence: false
  description: Off by default (the night truly ends on your 🕊). Off: a program who talks Trabolta down at his heart stands him down, and # hosts asks you to press 🕊 (NEXT on the cue sheet); until you do, 🔄 can reopen his heart. On: the night ends 25 s after his goodbye by itself (🕊 ends it at once). # hosts says which way it is now.

// Wave 22, appended so no cue number moves; it rejoins the server-room act
// (E) beside 🚪 Trust: handing the cables back to the patch bay. DRAFT w22
INTERACTION trust_patch_bay
  label: 🔌 Trust the patch bay again
  who: admin
  act: E · Act III: the Y2K hour and the server room
  sequence: false
  while: Night.patch_override == true
  description: After a 🔌 / 💥 / ❌ press in the Y2K hour: hands the cables back to the patch bay on the server-room terminal. The bay judges the next full patch it reports (the same four cables plugged in again never count twice).

// Wave 26 (R4, R6, R7, C6, C9), appended after 🔌 so no cue number moves; they rejoin
// the Anytime act beside the reinstallation cues. The
// reinstallation games fire these for one program through the moment route
// (`POST /api/spatial/moment`), never a person. Their names are
// `@loom/house` ESCAPE_SIGNAL / HEART_SIGNAL / PICKUP_SIGNAL, quiet on the
// screens (QUIET_MOMENT_SIGNALS). Every line they say is game-only (the
// Escape Attempt and Heart In The Simulation beats) or the codex unlock's
// usual Truther Download line.
// w26 (the button's label and description)
INTERACTION simulation escape attempt
  label: Reinstallation: walked out into the void (server)
  who: admin
  act: Anytime
  sequence: false
  description: Fired by the reinstallation games for one program who walked out through the simulation's mud room, 5 m into the void. The game scares them and puts them back in the tent; Trabolta chastises them in the game only; −5 trust each time. # hosts is told.

// w26 (the button's label and description)
INTERACTION simulation heart reached
  label: Reinstallation: reached Trabolta's heart in the simulation (server)
  who: admin
  act: Anytime
  sequence: false
  description: Fired by the reinstallation games for one program who walks into the simulation's server room once the King has fallen. Once a night per program, and only once Trabolta is awake: a short monologue, in the game only. Flavour; # hosts is told.

// w26 (the button's label and description)
INTERACTION simulation pickup taken
  label: Reinstallation: picked up the floppy disk (server)
  who: admin
  act: Anytime
  sequence: false
  description: Fired by the reinstallation games for one program who picks up the floppy disk in the simulation (args item, prop). The virus disk unlocks the same Codex entry as the tent's QR (Free Antivirus Trial for a paranoid Excel, ILOVEYOU for everyone else). Once per program.

// Wave 32 (C2), appended after the games' moments so no cue number moves; it
// rides Anytime. The talk panel's ⚡ chip (and the story's own timer) fire it
// while a talk scene is on: a flicker before the ad attack, an ad burst from
// it on. No `by:` (a player is never a caller, L1222).
// DRAFT w32 (the button's label and description)
INTERACTION ad_burst
  label: ⚡ Glitch: an ad burst through Trabolta (talk scenes)
  who: admin
  act: Anytime
  sequence: false
  repeat: true
  while: Night.talk != "none"
  description: Only while a talk scene is on (🤖 Talk on the hosts' phones). Before the ad attack the screens flicker; from the ad attack on, a short ad bursts through every screen and phone with one of Trabolta's pained lines. The scene also glitches on its own every 45 seconds or so. Two seconds apart at least.

// Performer buttons (on every guest card). Every hook guards its phase
// and ignores a wrong-phase press — except `send to the internet` and
// `mark as reinstalled`, which work on any program at any time.
// `by:` names whose button it is (a character, or a GROUP's members; a
// character that owns a hook for it counts too) and `while:` when it is
// on offer: a booth's card leads with its own live buttons and folds the
// rest under More. `by:` is enforced: the server refuses another booth's
// press (a director's quick-fire still fires it), and a booth never offers
// another character's. `while:` is not — the hooks still guard.
// A performer button's `while:` is read with the scanned guest bound on
// the booth's card (wave 13: `/api/prime/card`, subject = the guest), so a
// `program.*` condition puts the button on the card's face for exactly the
// guests it fits (🩹 only on a marked program). The booth's own list reads
// it with no guest bound (an unbound `program.x` reads false: off offer
// there). It never gates the press: per-guest rules belong in the hook.
// `arm: true` (wave 11) marks a press with no way back: one that ends the
// night (🔌 💥 💘), trips the alarm (❌), spends The Heart (🚪), changes
// the room for two minutes (🔧), hands over a secret (♟ the door code,
// 🍎 The Truth File), plays a once-a-night moment (🫘) or sends a program
// to the Internet on the spot (🛡, a capture from any phase). The booth
// arms it on the first tap and fires it on the second (the Director's arm
// model); the server never refuses an unarmed press. Guest 💾 too.

INTERACTION send to the internet
  label: 🛡 Send to the Internet
  who: performer
  // w13 Q22: the Antivirus' own. Only TRAIT Enforcer's hooks hear it, so no host's card lists it and a host's press is refused.
  by: Antivirus
  // w13 Q29: arm then fire on every Antivirus booth. One tap used to capture a program just cleared at the door.
  // (Wave 18: the booth's CORRUPTION DETECTED screen fires it with one tap after an in-person scan.)
  arm: true
  // w18 (A6): on a marked program's card only (the hook still captures anyone).
  // w21: and on every card while the patch-bay alarm is on (whoever is
  // at the cables goes to the Internet; there is no All buttons… fold now).
  while: program.corrupted != true and (program.marked == true or Night.alarm_on == true)
  description: Antivirus. A marked program, found: drag them through the Tube for reinstallation.

INTERACTION mark as reinstalled
  label: ✅ Mark as reinstalled
  who: performer
  // w13 Q22
  by: Antivirus
  // w18 (A6): on a captured program's card only.
  while: program.corrupted == true
  description: Antivirus. They completed the simulation: let them out.

INTERACTION accuse
  label: 👁 Put on the watchlist
  who: performer
  // w13 Q22
  by: Antivirus
  while: Night.ended != true
  description: Antivirus. Raises their doubt.

INTERACTION vouch
  label: 🤝 Vouch for this program
  who: performer
  while: Night.ended != true
  description: Hosts. Clears their doubt.

