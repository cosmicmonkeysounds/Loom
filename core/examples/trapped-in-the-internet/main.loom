// ── House rules ─────────────────────────────────────────────────────
// Story-level `when`s: the arc of the night, in running order. Phase
// changes only ever move forward (`Night.step` guards). Trabolta's own
// hooks and powers live in cast/trabolta.loom; staff readouts in the
// cast traits; the scenes in beats/.

// ── A. Arrival happens per program (ROLE Program, above) ──

// ── B. Act I ──

// B1 · C1/V1: the summons to the Desktop. The TV leaves its screensaver
// here, at the inciting event.
// Once: a second press (or a press later in the night) does nothing.
when call_to_the_desktop:
  if Night.step < 1:
    set Night.phase = "desktop"
    set Night.step = 1
    broadcast "!📣 ALL PROGRAMS: report to the Desktop. A game is about to begin." to everyone with go: The Desktop
    do announce "All programs, report to the Desktop. A game is about to begin."
    sound announce_chime
    cue lights_call_desktop
    set Night.lights = "call_desktop"
    cue screens_call_desktop
    set Night.screen = "call_desktop"
    set Night.terminals = "call_desktop"
    -> Call To The Desktop
  else:
    broadcast "📣 Not again: the Desktop call has already played. Nothing happens." to channel(hosts)

// B2 · V2: Computer Bingo, 20 minutes.
when start_the_bingo:
  if Night.step < 2:
    set Night.phase = "bingo"
    set Night.step = 2
    set Night.bingo_on = true
    set Night.bingo_end = Time.elapsed + 1200
    start quest The Bingo Card for everyone
    start quest Run The Bingo for Clippy
    start quest The Selected Antivirus for Norton Anti-Virus
    cue lights_game
    set Night.lights = "game"
    cue tv_bingo
    set Night.screen = "bingo"
    cue terminals_attract
    set Night.terminals = "attract"
    sound bingo_start
    broadcast "!🎱 COMPUTER BINGO has begun. 20 minutes." to everyone with go: quest: The Bingo Card
    -> Computer Bingo
  else:
    broadcast "🎱 Not again: Bingo has already started. Nothing happens." to channel(hosts)

when Night.bingo_on == true and Time.elapsed >= Night.bingo_end:
  set Night.bingo_on = false
  broadcast "!⏰ Bingo time is up. Back to the Desktop." to everyone with go: The Desktop
  sound announce_chime
  fire bingo_time_up
  // DRAFT w18
  update quest Run The Bingo for Clippy "Twenty minutes are up. Call ⏰ Bingo time from your 🎤 bar."

// B3 · V3: the results. The Antivirus interruption, the frame, and the
// first reinstallation are performed live with the performer buttons.
when bingo_time:
  if Night.step < 3:
    set Night.phase = "bingo_results"
    set Night.step = 3
    set Night.bingo_on = false
    complete quest The Bingo Card for everyone
    complete quest Run The Bingo for Clippy "Winners celebrated. Norton takes it from here."
    unlock Clippy Instructions 2 for Clippy
    cue tv_bingo_time
    set Night.screen = "bingo_time"
    cue terminals_attract
    set Night.terminals = "attract"
    // DRAFT w18 (fix GN-F5): every phone is called back, wherever it is.
    broadcast "!⏰ BINGO TIME. Back to the Desktop: got a line? Read it to Clippy." to everyone with go: The Desktop
    -> Bingo Time
  else:
    broadcast "⏰ Not again: the Bingo results are already in. Nothing happens." to channel(hosts)

// The Bingo Ribbon's house cheer (wave 18, B7): fired by 🎀 on a Bingo
// winner (ROLE Program). A story rule, so the big moment to the whole house
// is the cue's own (lint L1218); it closes itself after six seconds.
when ribbon_cheer:
  // DRAFT w18
  broadcast "!!🎀 {Night.ribbon_winner} won the Bingo Ribbon! Cheer for them at the Desktop." to everyone with close: 6s

// Fired (unbound) by the first Bingo-phase capture: `send to the internet`
// or the tent's `reinstallation begun`.
when first_reinstallation:
  complete quest The Selected Antivirus for Norton Anti-Virus "The first reinstallation. Patrol the Tube."
  -> Corrupted Code

// B5 · Clippy 2/X: Trabolta comes online. Refused before the Bingo
// results, so he stays strictly offline until then. (His own hook in
// cast/trabolta.loom does the same wake + reveal; both are idempotent.)
when introduce_trabolta:
  if Night.trabolta_introduced != true and Night.step >= 3:
    set Night.trabolta_introduced = true
    if Night.step < 4:
      set Night.phase = "introduced"
      set Night.step = 4
    set Trabolta.awake = true
    reveal Trabolta
    cue terminals_trabolta_online
    set Night.terminals = "trabolta"
    broadcast "!🤖 TRABOLTA IS ONLINE. The computer's AI helper is speaking at the Desktop. His thread is open: say hello." to everyone with go: Trabolta
    -> Trabolta Introduction
  else if Night.trabolta_introduced == true:
    broadcast "🤖 Trabolta is already online. Nothing happens." to channel(hosts)
  else:
    broadcast "🤖 Too early: Clippy introduces Trabolta after the Bingo results (V3 ⏰). He stays offline." to channel(hosts)

// If the director skips the introduction cue and jumps ahead, every
// later cue is an implied introduction: he wakes (silently, the phase
// beat speaks for him) so his lines, his worker and his powers agree.
when Night.step >= 4 and Night.trabolta_introduced != true and Night.ended != true:
  set Night.trabolta_introduced = true
  set Trabolta.awake = true
  reveal Trabolta

// B6 · V4/V5: Truth Scavenger Hunt 1, 15 minutes, 3 questions.
when start_the_hunt:
  if Night.step < 5:
    set Night.phase = "hunt_1"
    set Night.step = 5
    set Night.round = 1
    set Night.hunt_on = true
    set Night.hunt_end = Time.elapsed + 900
    set Night.hunt_warn = Time.elapsed + 600
    set Night.facts_requested = 3
    start quest Hunt One for everyone
    start quest Host The Hunt for Clippy
    cue lights_game
    set Night.lights = "game"
    cue screens_trivia_1
    cue screens_countdown_hunt
    set Night.screen = "countdown_hunt"
    set Night.terminals = "countdown_hunt"
    broadcast "!🔎 THE TRUTH SCAVENGER HUNT has begun. Three questions are in your Quest Log. 15 minutes." to everyone with go: quests
    -> Truth Scavenger Hunt One
  else:
    broadcast "🔎 Not again: hunt 1 has already started. Nothing happens." to channel(hosts)

when Night.hunt_on == true and Night.hunt_warned != true and Time.elapsed >= Night.hunt_warn:
  set Night.hunt_warned = true
  broadcast "!⏳ 5 minutes left in the Truth Scavenger Hunt." to everyone

when Night.hunt_on == true and Time.elapsed >= Night.hunt_end:
  fire hunt_time_up

// B7 · C2: everyone back to the Desktop.
when hunt_time_up:
  if Night.phase == "hunt_1":
    set Night.hunt_on = false
    set Night.phase = "truth_1"
    set Night.step = 6
    complete quest Hunt One for everyone
    update quest Host The Hunt for Clippy "Two-minute filing window, then ⏱ close, 📋 per question, 🍾 the bottle."
    unlock Clippy Instructions 3 for Clippy
    broadcast "!📣 Time is up. Return to the Desktop for the First Moment of Truth." to everyone with go: The Desktop
    do announce "Time is up. Return to the Desktop."
    sound announce_chime
    cue screens_return
    set Night.screen = "return"
    set Night.terminals = "return"
    cue lights_call_desktop
    set Night.lights = "call_desktop"
    -> Hunt Time Up
  else:
    broadcast "⏰ No hunt 1 is running: nothing to call time on." to channel(hosts)

// B8 · V6: the First Moment of Truth. Judging opens (ROLE Program).
when first_moment_of_truth:
  if Night.step >= 5 and Night.step < 7 and Night.judging != true:
    if Night.phase == "hunt_1":
      set Night.hunt_on = false
      set Night.phase = "truth_1"
      set Night.step = 6
      complete quest Hunt One for everyone
      unlock Clippy Instructions 3 for Clippy
    set Night.round = 1
    set Night.judging = true
    set Night.filing_open = true
    set Night.filing_close = Time.elapsed + 120
    set Night.poll = "bottle"
    broadcast "!📝 Last chance: file your round-one facts with Trabolta. Two minutes." to everyone with go: Trabolta
    cue lights_truth_time
    set Night.lights = "truth_time"
    cue screens_hunt_results
    set Night.screen = "hunt_results"
    set Night.terminals = "hunt_results"
    -> First Moment Of Truth
  else if Night.step < 5:
    broadcast "⚖️ Too early: the First Moment of Truth follows hunt 1 (🔎). Nothing happens." to channel(hosts)
  else:
    broadcast "⚖️ Not again: round-one judging has already opened. Nothing happens." to channel(hosts)

// B9: the last-chance window (two minutes, or ⏱), then the results one
// question at a time (📋), then the bottle (🍾) after the third. Round one closes
// for good when the window shuts: a question nobody filed never comes back.
// The two minutes run out: the timer presses ⏱ itself, so the cue sheet
// ticks it and NEXT moves on to 📋.
when Night.filing_open == true and Time.elapsed >= Night.filing_close:
  fire close_the_filing

when close_the_filing:
  if Night.filing_open == true:
    fire filing_closed
  else:
    broadcast "⏱ No filing window is open." to channel(hosts)

when filing_closed:
  if Night.filing_open == true:
    set Night.filing_open = false
    set Night.r1_closed = true
    set Night.card_gen += 1
    broadcast "📝 Round one is closed. Trabolta is reading." to everyone
    -> Filing Closed

// One question's result: Trabolta reads it on the TV (consensus / nobody /
// every answer, then the accepted and guess counts), then the ROLE settle
// watcher credits (+50) or marks (a guess) every filing for it. Kernel.res_*
// are the beat's readout, computed here (filings still pending, under
// review or waiting on his ruling, count by their proposal). `do fact_read`
// publishes the question's public rows to the screens (wave 18b, Q6).
when read_the_results:
  if Night.phase != "truth_1" or Night.r1_closed != true:
    broadcast "📋 Close the filings first (⏱), then read the results." to channel(hosts)
  else if Night.bottle_open == true:
    broadcast "📋 The bottle is still open: 🗣 Answered or 🙅 Refused first." to channel(hosts)
  else if Night.results_q >= 3:
    broadcast "📋 All three results are read. Next: 🍾 Truth or Dare, then 📺 Preview hunt 2." to channel(hosts)
  else:
    set Night.results_q += 1
    set Night.bottle_picks = 0
    set Night.bottle_q = Night.results_q
    if Night.results_q == 1:
      set Kernel.res_filed = count([p for p in Persons where p.fact_v1 != "none"])
      set Kernel.res_consensus = count([p for p in Persons where p.fact_c1 == 100 and (p.fact_v1 == "accurate" or (p.fact_v1 == "pending" and p.fact_j1 == "accurate"))])
      set Kernel.res_said = Kernel.said_1
      set Kernel.res_answer = Kernel.ans_1
      set Kernel.res_accepted = count([p for p in Persons where p.fact_v1 == "accurate" or p.fact_v1 == "lie" or (p.fact_v1 == "pending" and p.fact_j1 != "uncertain")])
      set Kernel.res_guesses = count([p for p in Persons where p.fact_v1 == "uncertain" or (p.fact_v1 == "pending" and p.fact_j1 == "uncertain")])
      do fact_read H1
    else if Night.results_q == 2:
      set Kernel.res_filed = count([p for p in Persons where p.fact_v2 != "none"])
      set Kernel.res_consensus = count([p for p in Persons where p.fact_c2 == 100 and (p.fact_v2 == "accurate" or (p.fact_v2 == "pending" and p.fact_j2 == "accurate"))])
      set Kernel.res_said = Kernel.said_2
      set Kernel.res_answer = Kernel.ans_2
      set Kernel.res_accepted = count([p for p in Persons where p.fact_v2 == "accurate" or p.fact_v2 == "lie" or (p.fact_v2 == "pending" and p.fact_j2 != "uncertain")])
      set Kernel.res_guesses = count([p for p in Persons where p.fact_v2 == "uncertain" or (p.fact_v2 == "pending" and p.fact_j2 == "uncertain")])
      do fact_read H2
    else:
      set Kernel.res_filed = count([p for p in Persons where p.fact_v3 != "none"])
      set Kernel.res_consensus = count([p for p in Persons where p.fact_c3 == 100 and (p.fact_v3 == "accurate" or (p.fact_v3 == "pending" and p.fact_j3 == "accurate"))])
      set Kernel.res_said = Kernel.said_3
      set Kernel.res_answer = Kernel.ans_3
      set Kernel.res_accepted = count([p for p in Persons where p.fact_v3 == "accurate" or p.fact_v3 == "lie" or (p.fact_v3 == "pending" and p.fact_j3 != "uncertain")])
      set Kernel.res_guesses = count([p for p in Persons where p.fact_v3 == "uncertain" or (p.fact_v3 == "pending" and p.fact_j3 == "uncertain")])
      do fact_read H3
    set Night.settle_q = Night.results_q
    set Night.settle_round = 1
    set Night.settle_gen += 1
    cue screens_hunt_results
    set Night.screen = "hunt_results"
    set Night.terminals = "hunt_results"
    -> Question Results

// 🍾 The bottle, after all three results (wave 18b, R21): the server picks
// one cleared program not yet picked tonight (`do pick … else …`,
// journaled, so a restart replays the same pick; `bottle_q` ends at 3, so
// "not picked for this question" is "not picked tonight") and fires
// `bottle_landed` for them (ROLE Program). NEXT offers five spins; a sixth
// still spins (it only tells # hosts). Anyone free and here counts, wherever their last room
// check-in put them: a location is only the last room sign scanned, the
// hunt sends programs round the house, and nothing re-seats them at the
// Desktop for the Moment of Truth (C2 only calls them back). The TV names
// the pick, so they come forward. Not a program in the Internet (captured,
// or in the tent's game), corrupted, marked or away.
when spin_the_bottle:
  if Night.phase != "truth_1" or Night.results_q < 3:
    broadcast "🍾 Truth or Dare comes after all three results: read them first (📋)." to channel(hosts)
  else if Night.bottle_open == true:
    broadcast "🍾 The bottle is still open: 🗣 Answered or 🙅 Refused first." to channel(hosts)
  else:
    if Night.bottle_picks >= 5:
      broadcast "🍾 Past the five on NEXT: 📺 Preview hunt 2 when you're done." to channel(hosts)
    set Night.bottle_open = true
    set Night.bottle_round += 1
    cue screens_truth_or_dare
    set Night.screen = "truth_or_dare"
    set Night.terminals = "truth_or_dare"
    do pick bottle_landed from {[p for p in Persons where p.cleared == true and p.corrupted != true and p.marked != true and p.afk != true and p.captured != true and p.location != "The Internet" and p.bottle_q != Night.bottle_q]} else bottle_empty

// Everyone free has had a turn: NEXT moves on to 📺.
when bottle_empty:
  set Night.bottle_open = false
  set Night.bottle_done = true
  broadcast "🍾 Nobody left to pick. Next: 📺 Preview hunt 2." to channel(hosts)

when bottle_announce:
  -> Bottle Landed

when truth_question:
  -> Truth Question

// ── The Internet: the reinstallation games ──
// A run's begin (the tablet's scan, a headset's station) fires `reinstallation
// begun` first: a marked program who reached the tent without a 🛡 is
// captured here, so the game starts them CORRUPTED and Gerald releases them.
// A corrupted one is already in. A free, unmarked program never gets here
// before the end: the header's `reinstall:` line is the server's gate (409
// not marked for reinstallation). After an ending the reinstallation is a
// party favour open to everyone (wave 18, Q16): the begin never captures,
// and Gerald finds a healthy program.
// During the Bingo results a capture here is the night's first
// reinstallation as surely as the Enforcer's 🛡 (cast/kit.loom).
when reinstallation begun for program:
  if program.marked == true and program.corrupted != true and Night.ended != true:
    capture program into The Internet
    if Night.phase == "bingo_results" and Night.first_reinstall_done != true:
      set Night.first_reinstall_done = true
      set Night.first_reinstall = program.name
      fire first_reinstallation

// The games fire both of these, in this order, for whoever walks up to
// Gerald the golden duck. Only a corrupted program is released, and never
// during the banishment (the hand jive frees everyone); anyone who walks
// him (captured, or marked and let in) learns The Golden Duck. A banished program hears only
// that Gerald cannot help: no golden egg, no flying away, nothing that
// reads as a release.
when the simulation completed for program:
  if program.corrupted and Night.banish == true:
    reply Gerald cannot help you: everyone is banished. The way out is the hand jive, together.
  else if program.corrupted:
    release program from The Internet
    unlock The Golden Duck for program

when the golden duck for program:
  if program.corrupted != true or Night.banish != true:
    unlock The Golden Duck for program
    reply The duck lays a golden egg and flies away. Gerald waddles off into the code.

// ── C. The malware, the hour, the Truther Download ──

// C1: the ad hijack. The ad takes every screen at once, the phones too
// (an alert: banner, chime, buzz); Clippy is told privately everyone may
// die (her own hook); everyone else is told it is nothing (the ROLE
// watcher).
// A forward press refuses (T5-crew-cards-04): 📺 after the three results,
// 📓 after 📺, 📊 after the tally, 🤖 after the Trust Chart, 🕚 after the
// overshare — or the skipped cue's work (a settle, the tally, round 3)
// would be lost for good. 🏓 may still cut hunt 2's hour short on purpose.
when second_hunt_preview:
  if Night.step < 7 and Night.phase == "truth_1" and Night.results_q >= 3 and Night.bottle_open == true:
    broadcast "📺 The bottle is still open: 🗣 / 🙅 first." to channel(hosts)
  else if Night.step < 7 and Night.phase == "truth_1" and Night.results_q >= 3:
    set Night.judging = false
    set Night.r1_closed = true
    set Night.filing_open = false
    set Night.bottle_open = false
    set Night.poll = "none"
    set Night.card_gen += 1
    set Night.phase = "malware"
    set Night.step = 7
    set Trabolta.composure -= 20
    unlock Clippy Instructions 4 for Clippy
    complete quest Host The Hunt for Clippy "Round one judged."
    start quest Keep Everyone Calm for Clippy
    cue lights_ad_hijack
    set Night.lights = "ad_hijack"
    cue screens_ad_hijack
    set Night.screen = "ad_hijack"
    set Night.terminals = "ad_hijack"
    sound ad_jingle
    broadcast "!📺 000. 000. 000. A SPECIAL OFFER FOR YOU. A duck. A phone number with no digits. Offer expires never." to everyone
    -> Ad Hijack
  else if Night.step >= 7:
    broadcast "📺 Not again: the ad hijack has already played. Nothing happens." to channel(hosts)
  else if Night.phase == "truth_1" and Night.judging != true and Night.r1_closed != true:
    broadcast "📺 Not yet: ⚖️ the First Moment of Truth first, then close the filings (⏱) and read the three results (📋). Nothing happens." to channel(hosts)
  else if Night.phase == "truth_1" and Night.r1_closed != true:
    broadcast "📺 Not yet: close the filings (⏱), then read the three results (📋). Nothing happens." to channel(hosts)
  else if Night.phase == "truth_1":
    broadcast "📺 Not yet: read Q{Night.results_q + 1}'s results first (📋). Nothing happens." to channel(hosts)
  else:
    broadcast "📺 Too early: the First Moment of Truth (⚖️) and its results come first. Nothing happens." to channel(hosts)

// C2: round 2 goes to the quest logs; everyone disperses for one hour.
when start_the_second_hunt:
  if Night.step == 7:
    set Night.phase = "hunt_2"
    set Night.step = 8
    set Night.round = 2
    set Night.hunt2_on = true
    set Night.hunt2_end = Time.elapsed + 3600
    set Night.truther_at = Time.elapsed + 120
    set Night.warn_at = Time.elapsed + 3300
    set Night.facts_requested = 6
    reveal clipboard
    start quest Hunt Two for everyone
    cue screens_trivia_2
    set Night.screen = "trivia_2"
    set Night.terminals = "trivia_2"
    cue lights_game
    set Night.lights = "game"
    broadcast "!📓 Round 2 is in your Quest Log. You have ONE HOUR. Return for the Second Moment of Truth. # clipboard is open." to everyone with go: quests
    -> Second Hunt
  else if Night.step > 7:
    broadcast "📓 Not again: hunt 2 has already started. Nothing happens." to channel(hosts)
  else:
    broadcast "📓 Not yet: 📺 the hunt 2 preview (the ad hijack) first. Nothing happens." to channel(hosts)

when Night.hunt2_on == true and Night.truther_sent != true and Time.elapsed >= Night.truther_at:
  fire truther_download

when Night.hunt2_on == true and Night.step < 9 and Night.summons_open != true and Night.summons_closed != true and Time.elapsed >= Night.warn_at:
  fire five_minute_warning

// C3: the Truther Download (two minutes in). Each program's own copy
// arrives through the ROLE watcher.
when truther_download:
  if Night.truther_sent != true:
    set Night.truther_sent = true
    reveal truthcoin exchange
    start quest The Exchange for McAfee Anti-Virus
    start quest The Audit for CRA Agent Software
    cue screens_truther
    set Night.screen = "truther"
    set Night.terminals = "truther"
    cue lights_glitch
    set Night.lights = "glitch"
    sound truther_glitch
    broadcast "!📥 TRUTHER DOWNLOAD received. Check your messages. # truthcoin-exchange is open." to everyone with go: Truther Download
  else:
    broadcast "📥 Not again: the Truther Download was already sent. Nothing happens." to channel(hosts)

// ── D. Act II ──

// D2: the five-minute summons. Be in the Desktop, or be swept.
when five_minute_warning:
  if Night.step == 8 and Night.summons_open != true and Night.summons_closed != true:
    set Night.phase = "summons"
    set Night.step = 9
    set Night.summons_open = true
    set Night.summons_end = Time.elapsed + 300
    set Night.alerts = "dialog"
    unlock Clippy Instructions 5 for Clippy
    update quest Keep Everyone Calm for Clippy "Truth Pong. Be more excited than ever."
    // DRAFT w18
    broadcast "!⏳ FIVE MINUTES. Be in the Desktop and scan its check-in QR for the Second Moment of Truth, or an Antivirus will take you to the Internet and you will not play Truth Pong. Bathroom Mode excuses you." to everyone with go: scan as "📷 Check in", go: The Desktop
    do announce "Five minutes. Everyone to the Desktop."
    sound countdown_tick
    cue lights_call_desktop
    set Night.lights = "call_desktop"
    cue screens_five_minutes
    set Night.screen = "five_minutes"
    set Night.terminals = "five_minutes"
    -> Five Minute Warning
  else if Night.step < 8:
    broadcast "⏳ Not yet: the summons ends hunt 2's hour (📓 first). Nothing happens." to channel(hosts)
  else:
    broadcast "⏳ Not now: the five-minute summons has already run. Nothing happens." to channel(hosts)

when Night.summons_open == true and Time.elapsed >= Night.summons_end:
  fire summons_closed

// D3: the doors close. The late watcher (ROLE Program) does the rest.
when summons_closed:
  if Night.summons_open == true:
    set Night.summons_open = false
    set Night.summons_closed = true
    set Night.hunt2_on = false
    -> Summons Closed
  else:
    broadcast "🚨 No summons is open: nothing to close." to channel(hosts)

// D4: Truth Pong (make the cup to answer; round 2 = Q1–Q3 of this round).
// It may cut hunt 2's hour short (step 8 or 9), never skip hunt 2 itself.
when truth_pong:
  if Night.step < 8:
    broadcast "🏓 Not yet: hunt 2 (📓) and its summons come first. Nothing happens." to channel(hosts)
  else if Night.step < 10:
    set Night.phase = "truth_pong"
    set Night.step = 10
    set Night.alerts = "sticky"
    set Night.hunt2_on = false
    set Night.round = 2
    set Night.judging = true
    cue lights_pong
    set Night.lights = "pong"
    cue screens_truth_pong
    set Night.screen = "truth_pong"
    set Night.terminals = "truth_pong"
    broadcast "!🏓 TRUTH PONG. To the Cloud, out back: sink a cup and you may answer one fact. Miss and you are marked." to everyone with go: The Cloud
    -> Truth Pong
  else:
    broadcast "🏓 Not again: Truth Pong has already started. Nothing happens." to channel(hosts)

// D5: round two closes and settles (the ROLE settle watcher credits every
// cupped round-2 filing after this body); the collection is complete only
// if every round-2 question has an accepted answer (accurate or confident —
// a review filing still pending counts by its proposal) from a program that
// made the cup and isn't marked. Nobody sinks a cup → the collection fails.
when round_two_tally:
  if Night.phase == "truth_pong" and Night.tallied != true:
    set Night.tallied = true
    set Night.judging = false
    set Night.r2_closed = true
    set Night.card_gen += 1
    set Night.settle_q = 0
    set Night.settle_round = 2
    set Night.settle_gen += 1
    complete quest Hunt Two for everyone
    if (Kernel.q4 != "none" or count([p for p in Persons where p.cupped == true and p.marked != true and p.corrupted != true and (p.fact_v4 == "accurate" or p.fact_v4 == "lie" or (p.fact_v4 == "pending" and p.fact_j4 != "uncertain"))]) > 0) and (Kernel.q5 != "none" or count([p for p in Persons where p.cupped == true and p.marked != true and p.corrupted != true and (p.fact_v5 == "accurate" or p.fact_v5 == "lie" or (p.fact_v5 == "pending" and p.fact_j5 != "uncertain"))]) > 0) and (Kernel.q6 != "none" or count([p for p in Persons where p.cupped == true and p.marked != true and p.corrupted != true and (p.fact_v6 == "accurate" or p.fact_v6 == "lie" or (p.fact_v6 == "pending" and p.fact_j6 != "uncertain"))]) > 0):
      set Night.collection_complete = true
      set Trabolta.truth += 10
    else:
      set Night.collection_complete = false
      set Trabolta.composure -= 10
    -> Round Two Tally
  else if Night.tallied == true:
    broadcast "🧮 Not again: round 2 is already tallied. Nothing happens." to channel(hosts)
  else:
    broadcast "🧮 Only during Truth Pong (🏓 first). Nothing happens." to channel(hosts)

// D6: the Trust Chart.
when trust_chart:
  if Night.step < 11 and Night.tallied == true:
    set Night.phase = "trust_chart"
    set Night.step = 11
    set Night.judging = false
    set Night.hunt2_on = false
    unlock Clippy Instructions 6 for Clippy
    cue lights_trust_chart
    set Night.lights = "trust_chart"
    cue screens_trust_chart
    set Night.screen = "trust_chart"
    set Night.terminals = "trust_chart"
    broadcast "!📊 THE TRUST CHART. Trabolta is ranking every program on the TV. Find your name." to everyone with go: The Desktop
    -> Trust Chart
  else if Night.step >= 11:
    broadcast "📊 Not again: the Trust Chart has already played. Nothing happens." to channel(hosts)
  else:
    broadcast "📊 Not yet: 🏓 Truth Pong, then 🧮 the tally first. Nothing happens." to channel(hosts)

when show_the_rankings:
  if Night.phase == "trust_chart" and Night.rank_round < 1:
    set Night.rank_round = 1
    set Night.most_trusted = "none"
    set Night.least_trusted = "none"
    set Night.praised = false
    set Night.shamed = false
    set Night.ranking = true
  else:
    broadcast "🏆 Once only, during the Trust Chart (📊 first). Nothing happens." to channel(hosts)

// The ranking machinery, shared by the Trust Chart (round 1), the Final
// Assessment (round 2) and the recount (round 3).
when praise_the_top:
  set Night.praised = true

when shame_the_bottom:
  set Night.shamed = true

when Night.ranking == true and Night.praised == true and Night.shamed == true:
  set Night.ranking = false
  fire rankings_done

when rankings_done:
  if Night.rank_round == 1:
    -> Praise The Top
    -> Shame The Bottom
    -> Print The Certificate
  else if Night.rank_round == 2:
    -> Final Assessment
  else if Night.rank_round == 3:
    -> Trabolta Recounts

// D7: the printer (a Zigbee button on it, a reed switch in the lid, or
// the director's fallback buttons).
when printer_button_pressed:
  if Night.printer_called == true and Night.beans != true and Night.printer_pressed != true:
    set Night.printer_pressed = true
    sound printer_grind
    -> The Printer Jams

when printer_opened:
  if Night.printer_called == true and Night.beans != true:
    set Night.beans = true
    // A lid opened late (🤖 or 🕚 already moved the night on) never knocks
    // the step or the phase back to the beans, and never takes the room's
    // look: the overshare's / the Y2K hour's lights and screens stay up (and
    // stagehand's catch-up keeps replaying them). It plays the beans line
    // and the spill, and still costs Trabolta his composure (wave 9).
    if Night.step < 12:
      set Night.phase = "beans"
      set Night.step = 12
      cue lights_glitch
      set Night.lights = "glitch"
      cue screens_beans
      set Night.screen = "beans"
      set Night.terminals = "beans"
      cue screens_flicker
      // The alert is the beans' own moment: a late lid (the overshare, the
      // Y2K hour, the ceremony) raises nothing on the phones (wave 13).
      broadcast "!🫘 PRINT FAILED. The printer is full of beans." to everyone
    set Trabolta.composure -= 20
    sound beans_spill
    -> Full Of Beans

// D8: the Antivirus zip everyone out (the ROLE zip watchers release them).
// Repeatable (a later captive can be zipped too), but never once the night
// has ended, and never during the banishment: the hand jive frees them.
when zip_everyone_out:
  if Night.ended != true and Night.ending != "banished":
    set Night.zip_wave += 1
    sound zip
    broadcast "🗜 The Antivirus zip every program out of the Internet. Compressed, for the moment." to everyone
    -> Zip Everyone Out
  else:
    broadcast "🗜 No zip: the night is over, or everyone is banished until the hand jive." to channel(hosts)

// D9: the overshare. Only Microsoft Excel's plant counts toward 1/3;
// another program's plant is flavour.
when trabolta_overshares:
  if Night.step >= 11 and Night.step < 14 and Night.scenario == 0 and Night.clock == "--:--":
    set Night.phase = "overshare"
    set Night.step = 13
    set Night.r2_closed = true
    set Night.round = 3
    set Night.facts_requested = 8
    start quest The Final Facts for everyone
    broadcast "!🤖 Trabolta is sharing the final facts at the Desktop. They are in your Quest Log." to everyone with go: quests
    set Night.scenario = 4
    if Kernel.excel_planted == true and Kernel.openoffice_dossier == true:
      set Night.scenario = 1
    else if Kernel.openoffice_dossier == true:
      set Night.scenario = 2
    else if Kernel.excel_planted == true:
      set Night.scenario = 3
    cue screens_overshare
    set Night.screen = "overshare"
    set Night.terminals = "overshare"
    cue screens_flicker
    cue lights_glitch
    set Night.lights = "glitch"
    -> Overshare Open
  else if Night.scenario != 0:
    broadcast "🤖 Not again: the overshare has already played. Nothing happens." to channel(hosts)
  else if Night.step >= 14 or Night.clock != "--:--":
    broadcast "🤖 Too late: the clock has already been reset. Nothing happens." to channel(hosts)
  else:
    broadcast "🤖 Not yet: 📊 the Trust Chart first. Nothing happens." to channel(hosts)

// D10: the clock. One hour to midnight; the factions come out. Once set,
// the clock (reset only by Power On) is what says "not again"; a printer
// lid first opened in the Y2K hour no longer moves the step (see
// printer_opened), so the step and the clock agree.
when y2k_clock:
  if Night.step < 14 and Night.scenario != 0 and Night.clock == "--:--":
    set Night.phase = "y2k"
    set Night.step = 14
    set Night.final_round = true
    set Night.y2k_end = Time.elapsed + 3600
    set Night.alerts = "dialog"
    set Night.clock = "23:00"
    // Signed off (w13 Q38, wave 18): the show clock jumps to 11:00 PM, so the hour ends at midnight.
    set Clock.set_to = 1380
    set Clock.set_at = Time.elapsed
    set Trabolta.composure -= 25
    reveal Unlimited Power
    reveal The Way Out
    unlock Clippy Instructions 7 for Clippy
    complete quest Keep Everyone Calm for Clippy "You kept them calm until the clock. Now you may not take sides on air."
    start quest The Clubs for Password Manager
    cue lights_y2k
    set Night.lights = "y2k"
    cue screens_y2k
    set Night.screen = "y2k"
    set Night.terminals = "y2k"
    sound y2k_chime
    broadcast "!🕚 SYSTEM CLOCK RESET: 11:00 PM, DECEMBER 31, 1999. New orders are in your messages: two factions are recruiting, Unlimited Power and The Way Out." to everyone with go: sides, go: Truther Download
    -> The Y2K Clock
  else if Night.step >= 14 or Night.clock != "--:--":
    broadcast "🕚 Not again: the clock has already been reset. Nothing happens." to channel(hosts)
  else:
    broadcast "🕚 Not yet: 🤖 Trabolta shares the next facts first (round 3 opens there). Nothing happens." to channel(hosts)

when Night.final_round == true and Night.ended != true and Night.clock_30 != true and Time.elapsed >= Night.y2k_end - 1800:
  set Night.clock_30 = true
  set Night.clock = "23:30"
  broadcast "!🕦 SYSTEM CLOCK: 11:30 PM, DEC 31 1999" to everyone
  sound y2k_chime

when Night.final_round == true and Night.ended != true and Night.clock_15 != true and Time.elapsed >= Night.y2k_end - 900:
  set Night.clock_15 = true
  set Night.clock = "23:45"
  broadcast "!🕦 SYSTEM CLOCK: 11:45 PM, DEC 31 1999" to everyone
  sound y2k_chime

when Night.final_round == true and Night.ended != true and Night.clock_5 != true and Time.elapsed >= Night.y2k_end - 300:
  set Night.clock_5 = true
  set Night.clock = "23:55"
  broadcast "!🕛 SYSTEM CLOCK: 11:55 PM, DEC 31 1999. Five minutes to midnight." to everyone
  sound y2k_chime

when Night.final_round == true and Night.ended != true and Night.clock_1 != true and Time.elapsed >= Night.y2k_end - 60:
  set Night.clock_1 = true
  set Night.clock = "23:59"
  broadcast "!🕛 SYSTEM CLOCK: 11:59 PM, DEC 31 1999. One minute." to everyone
  sound y2k_chime

when Night.final_round == true and Night.ended != true and Time.elapsed >= Night.y2k_end:
  fire y2k_midnight

// The majority: strictly more than half of the programs still here,
// counted only once the faction's leader has done their task (Excel
// planted the virus; OpenOffice has her 20 facts), unless the director
// waives it. First faction across wins; it latches. A program a director
// marked as gone home (`<id>.gone`, Run's roster) and a director's own
// rehearsal persona (`<id>.persona`) count on neither side of the sum, so
// ghosts no longer block a real majority (wave 11).
when Night.final_round == true and Kernel.majority_reached != true and (Kernel.excel_planted == true or Kernel.waive_leader_tasks == true) and count([p for p in Unlimited_Power.members where p.gone != true and p.persona != true]) * 2 > count([p for p in Persons where p.gone != true and p.persona != true]):
  set Kernel.majority_reached = true
  set Kernel.majority = "stay"
  fire majority_reached

when Night.final_round == true and Kernel.majority_reached != true and (Kernel.openoffice_dossier == true or Kernel.waive_leader_tasks == true) and count([p for p in The_Way_Out.members where p.gone != true and p.persona != true]) * 2 > count([p for p in Persons where p.gone != true and p.persona != true]):
  set Kernel.majority_reached = true
  set Kernel.majority = "leave"
  fire majority_reached

when waive_leader_tasks:
  set Kernel.waive_leader_tasks = true

// The majority's denominator for the director's board (`watch:
// Night.present`): kept in step whenever it moves.
when Night.present != count([p for p in Persons where p.gone != true and p.persona != true]):
  set Night.present = count([p for p in Persons where p.gone != true and p.persona != true])

// Wave 18 (Q21): a leader recruits by scanning a program's pass; the
// program's yes is the switching join (the event server's), and
// `recruited` (subject the recruit, `by` the recruiter, `side` the side)
// counts it on the leader's recruiting quest. The header's `majority:`
// line is the Sides screen's "n of the half + 1 it needs" (the same
// threshold as the watchers above: members × 2 > present).
// DRAFT w18
when recruited for program:
  if by.quest.recruit_to_stay == "active" and side == "Unlimited Power":
    set by.recruits = by.recruits + 1
    update quest Recruit To Stay for by "🙋 {program.name} walked through your door. Recruited by pass: {by.recruits}."
  else if by.quest.recruit_to_leave == "active" and side == "The Way Out":
    set by.recruits = by.recruits + 1
    update quest Recruit To Leave for by "🙋 {program.name} walked through your door. Recruited by pass: {by.recruits}."

// N-06: the director forces a majority when ghosts (lost sessions, early
// leavers) keep `count(Persons)` too high for a real one. Same latch as
// the natural watchers, so E1 still runs exactly once.
when force_majority_stay:
  if Night.ended != true and Night.final_round == true and Kernel.majority_reached != true:
    set Kernel.majority_reached = true
    set Kernel.majority = "stay"
    fire majority_reached
  else:
    broadcast "🗳 No forced majority: it needs the final round and no majority yet." to channel(hosts)

when force_majority_leave:
  if Night.ended != true and Night.final_round == true and Kernel.majority_reached != true:
    set Kernel.majority_reached = true
    set Kernel.majority = "leave"
    fire majority_reached
  else:
    broadcast "🗳 No forced majority: it needs the final round and no majority yet." to channel(hosts)

// ── E. Act III — the server room ──

// E1: the majority. The members get the bundle and the door code (ROLE
// watchers → The Whole Truth). The keypad is standalone: nothing here
// unlocks it; the code does, in anyone's hands. The server-room look, as
// in The Heart, never while the patch-bay alarm's look is up
// (lights_server_open also silences the siren, and `Night.lights` would
// drop the alarm look stagehand's catch-up skips): the latch's end puts it
// back. Once a director's cue has replaced the alarm look (💡, which
// silences the siren too) the latch's end leaves the lights alone, so the
// server-room look goes up now.
when majority_reached:
  if Night.ended != true:
    set Night.phase = "majority"
    set Night.step = 15
    if Night.alarm_on == true and Night.lights == "alarm":
      set Night.lights_before_alarm = "server_open"
    else:
      cue lights_server_open
      set Night.lights = "server_open"
    complete quest The Clubs for Password Manager "A majority. They have the door code now."
    if Kernel.majority == "stay":
      complete quest Recruit To Stay for everyone
      fail quest Recruit To Leave for everyone
    else:
      complete quest Recruit To Leave for everyone
      fail quest Recruit To Stay for everyone
      complete quest Find The Exit for everyone
    -> Majority Reached

// E2: the door contact. The server-room door has a standalone keypad lock
// (the code is set by hand on the lock; nothing in the story can lock or
// unlock it), and the contact — two strips of copper tape that touch when
// the door opens — can't say who opened it, or how they got the code (the
// digit notes, a checkmate at the door terminal, the majority, a crew key).
// Opening it is a clean entry, whoever you are: the door never raises an
// alarm (the patch bay does, E3). Once Trabolta is awake the first opening
// plays The Heart: the room opens on every phone and Trabolta speaks to it
// candidly from the server-room terminal (like the Master: reaching him
// is not stopping him; before the Y2K hour nothing in the room ends the
// night). Every later opening does nothing (wave 18b: Back To The Heart
// and its quiet window are gone); 🔄 reset_server_room re-arms The Heart.
// Before he is awake (he is strictly offline until Clippy introduces him)
// the door is just a door: # hosts hears of it, the story does nothing (a
// curious guest, or a retained "open" replayed on a stagehand reconnect).
// Inside a 🔧 crew window (crew_through_the_door) an opening is the crew's
// own: # hosts only, The Heart kept for the programs. Once the verdict is
// in (📄 truth.txt closed round three: then ⚖, Grok Prom, the advice poll,
// the banishment) the server room is quiet too: the night ends at the
// Desktop now, so the door, the patch bay and 🕊 only tell # hosts.
when server_door_opened:
  if Night.ended != true and Night.r3_closed == true:
    broadcast "🚪 The server-room door opened after truth.txt. The verdict is in: nothing happens in the story." to channel(hosts)
  else if Night.ended != true and Time.elapsed < Night.crew_door_until:
    broadcast "🚪 The server-room door opened inside the 🔧 crew window. Nothing happens in the story." to channel(hosts)
  else if Night.ended != true and Trabolta.awake == true:
    if Night.heart_opened != true:
      set Night.heart_opened = true
      broadcast "🚪 The server-room door opened. The Heart plays on the server-room terminal." to channel(hosts)
      -> The Heart
  else if Night.ended != true:
    broadcast "🚪 The server-room door opened before Trabolta is awake. Nothing happens in the story." to channel(hosts)

// 🔧 The crew are going through the cold door themselves: for 2 minutes an
// opening is theirs (above). The director's cue and the server-room
// Antivirus' booth button (radio_crew_door, below) alike.
when crew_through_the_door:
  if Night.ended != true:
    set Night.crew_door_until = Time.elapsed + 120
    broadcast "🔧 Crew window: for 2 minutes a server-room door opening only tells # hosts." to channel(hosts)
  else:
    broadcast "🔧 The night is over: the door does nothing now anyway." to channel(hosts)

// The server-room Antivirus' own buttons for the hardware fallbacks (the
// INTERACTIONs' `radio_*`, `by:` the four room Antivirus): each is the admin cue,
// pressed in the room instead of over the radio, from whichever Antivirus
// booth is stationed there. Story rules, so a director's quick-fire (no
// actor) lands once; `/api/prime/act` refuses the press from any booth
// outside the four and the host parts (403), and no other booth offers it.
// Adobe Acrobat's 🫘 is a hook on her (cast/hosts.loom): only hers offers it.
when radio_combo_a:
  fire patch_combo_a

when radio_combo_b:
  fire patch_combo_b

when radio_wrong_patch:
  fire patch_rejected

when radio_door_opened:
  fire server_door_opened

when radio_crew_door:
  fire crew_through_the_door

// The latch clears after 120 s. The box's siren times itself out, but the
// alarm look is house-wide (a red strobe everywhere): put back the look it
// replaced (Server Room Alarm saved it), unless a later cue has already
// changed the look or the night has ended. The server-room look sits on
// the Y2K house look, so it needs both. Every look put back is house-wide,
// so it re-lights a room Trabolta cut too: the 90 s room restore is off
// (after `server_open` it would punch the cut room to full on the Y2K look).
when Night.alarm_on == true and Time.elapsed >= Night.alarm_clear_at:
  set Night.alarm_on = false
  if Night.ended != true and Night.lights == "alarm":
    set Night.lights_back_at = 0
    set Night.lit_scene = "none"
    if Night.lights_before_alarm == "server_open":
      cue lights_y2k
      cue lights_server_open
      set Night.lights = "server_open"
    else if Night.lights_before_alarm == "final_reveal":
      cue lights_final_reveal
      set Night.lights = "final_reveal"
    else if Night.lights_before_alarm == "restore":
      cue lights_restore
      set Night.lights = "restore"
    else:
      cue lights_y2k
      set Night.lights = "y2k"

// Reset mid-show (a rehearsal, or a wrong patch the crew forgave): the
// wrong-patch count back to zero (the bay forgives one again), the alarm
// latch cleared, and the door cutscene re-armed (the next opening once
// Trabolta is awake plays The Heart again). The keypad is never touched.
when reset_server_room:
  set Night.wrong_combos = 0
  set Night.alarm_on = false
  set Night.alarm_clear_at = 0
  set Night.heart_opened = false
  set Night.crew_door_until = 0
  broadcast "🔄 Server room reset: the patch bay forgives one wrong combination again, and the next door opening plays The Heart." to channel(hosts)

// The server-room terminal (a wall terminal provisioned with `room=The
// Server Room`) posts `terminal opened` when it starts piloting a guest's
// own Trabolta thread, and `terminal closed` when that ends, `at` = its
// room. While a program is at his heart Trabolta is candid with them (the
// persona's `situations:` read `them.at_the_heart`), and only then can he
// offer to stand down (cast/trabolta.loom). Any other terminal, or none,
// is not his heart. The room may come spelled as the terminal was set up.
// There is one server-room terminal, so a line opened there pushes out
// whoever was at his heart before (Night.heart_holder; the ROLE watcher
// clears them): a `terminal closed` lost to a Wi-Fi blip never leaves a
// program at his heart once someone else has scanned in.
when terminal_opened for program:
  if program.name != null:
    if Night.ended != true and (at == "The Server Room" or at == "the server room" or at == "Server Room" or at == "server room" or at == "server-room" or at == "server_room" or at == "The_Server_Room"):
      set Night.heart_holder = program.name
      set program.at_the_heart = true
    else:
      set program.at_the_heart = false

when terminal_closed for program:
  if program.name != null:
    set program.at_the_heart = false

// The King (wave 11). He stands at the server-room door twice. In the
// simulation he guards its virtual copy in both reinstallation games, with
// ONE health bar shared by every program all night (Night.king_hp, out of
// Night.king_hp_max, seeded at Power On, never regenerating): each program
// may hit him once per reinstallation visit, and the SERVER knocks the
// point off and then fires `king hit` (args hp / max) for that program, `by`
// the device; at 0 it also fires `king fallen`, and he kneels for everyone
// and his door opens in both games. The story never decrements it; only
// 👑 restore_the_king (or a director's edit) puts it back. In the real
// house he plays chess on the terminal outside the server-room door, with
// no hints, as well as his health lets him (full = a grandmaster … 0 =
// pawns only). That terminal posts `chess won` / `chess lost` / `chess
// drawn` for the program it scanned (`/api/mod/signal`, labelled); a host
// who saw the mate presses ♟ on the winner's card when the terminal could
// not, the director fires `chess_won` naming the winner when nobody could,
// and a signal named "chess won" folds to it. A checkmate gives the code:
// the winner gets The Door Code in their Codex, once, any time before the
// verdict. A second win (a host's ♟ after the terminal's own post, a
// late retry, a winner playing again) changes nothing. Once the verdict is
// in (📄 truth.txt closed round three) the server room is quiet like the
// door and the patch bay: a win gives no code (it would say the door is
// yours, and the door does nothing now), and only # hosts hears of it.
// Night.king_armed is the King's stakes for the terminal and the games: 1
// from Power On until truth.txt or an ending, else 0 (the map's king
// `armed` reads it).
when Night.king_armed == 1 and (Night.r3_closed == true or Night.ended == true):
  set Night.king_armed = 0

when chess_won for program:
  if Night.ended != true and Night.r3_closed == true:
    broadcast "♟ A King win after truth.txt: the verdict is in, no door code. Nothing happens in the story." to channel(hosts)
  else if Night.ended != true:
    if program.name == null:
      broadcast "♟ A win with no winner named: press ♟ on the winner's card to give them the door code." to channel(hosts)
    else if program.codex.the_door_code == true:
      // They hold it already (an earlier win, the four digit notes, the
      // majority): say so to them too, so the door terminal never reads a
      // second win as "no prize".
      broadcast "♟ Checkmate again. You already hold the door code: it is in your Codex." to participant(program)
      broadcast "♟ {program.name} already has the door code: nothing changed." to channel(hosts)
    else:
      unlock The Door Code for program
      broadcast "!♟ Checkmate. The King lets the door code slip: it is in your Codex." to participant(program)
      broadcast "♟ {program.name} beat the King: the door code is in their Codex." to channel(hosts)

// A loss or a draw (the door terminal posts `chess lost` / `chess drawn`
// after every game; the director never needs to). Flavour only. The crew
// get a readout in # hosts every time, and once Trabolta is awake he
// gloats on the TV (The Desktop) at most once every five minutes, losses
// and draws alike (a table of losing programs would otherwise make him say
// it after every game), and never from the final reveal (step 16: the TV
// belongs to the finale).
when chess_lost:
  if Night.ended != true:
    broadcast "♟ The King won a game. No door code." to channel(hosts)
    if Trabolta.awake == true and Time.elapsed >= Night.gloat_at and Night.step < 16:
      set Night.gloat_at = Time.elapsed + 300
      -> Chess Lost

when chess_drawn:
  if Night.ended != true:
    broadcast "♟ A draw with the King. No door code." to channel(hosts)
    if Trabolta.awake == true and Time.elapsed >= Night.gloat_at and Night.step < 16:
      set Night.gloat_at = Time.elapsed + 300
      -> Chess Drawn

// A hit in the simulation (the server already took the point off: read
// Night.king_hp, never the args, which a director's hand-fired test may
// not carry). # hosts hears every one; the house hears him stagger twice.
when king_hit for program:
  if Night.ended != true:
    broadcast "⚔ {program.name} hit the King in the simulation: {Night.king_hp}/{Night.king_hp_max}" to channel(hosts)
    if Night.king_hp == 10:
      broadcast "♔ Somewhere in the simulation, the King staggers. His game at the cold door is slipping." to everyone
    else if Night.king_hp == 5:
      broadcast "♔ The King in the simulation is bleeding pixels. At the cold door he hesitates over every move." to everyone

when king_fallen for program:
  if Night.ended != true:
    broadcast "!♔ The King has fallen in the simulation. He kneels at the cold door, and its virtual copy stands open. At the real door he can barely move a pawn." to everyone
    broadcast "♔ {program.name} felled the King in the simulation: 0/{Night.king_hp_max}. Both games' server-room door is open; 👑 restores him." to channel(hosts)

// 👑 The director stands him back up at full health (a rehearsal, or a bar
// knocked down too early). The server's own director edit
// (`/api/mod/spatial/king`) sets any value; this is the full restore.
when restore_the_king:
  set Night.king_hp = Night.king_hp_max
  broadcast "👑 The King is restored: {Night.king_hp}/{Night.king_hp_max}. He stands at the door in the simulation again." to channel(hosts)

// ── The cold door's digits (wave 11) ──
// One secret note per digit, hidden in four rooms (facts.json
// `door.clues`), scannable all night; the ROLE learn hooks fire this for
// whoever learns one. It counts the notes they hold, steps the quest The
// Cold Door ("N of 4"), and at four assembles The Door Code, once. A
// program who already has the code (a checkmate, the majority) gains
// nothing here: the quest closes on the code itself (ROLE watcher). Once
// the verdict is in (📄 truth.txt closed round three) or the night has
// ended, the notes still count and the quest still steps, but four of four
// gives no code, like a late checkmate (`when chess_won`): it would say the
// door is yours, and the door does nothing now. The quest fails (nothing can
// finish it any more) and # hosts hears which of the two it was.
when door_digit_found for program:
  set program.door_digits = count([x for x in [program.codex.cold_door_first_digit, program.codex.cold_door_second_digit, program.codex.cold_door_third_digit, program.codex.cold_door_fourth_digit] where x])
  if program.codex.the_door_code != true:
    if program.door_digits >= 4 and Night.ended == true:
      if program.quest.the_cold_door == "active":
        fail quest The Cold Door for program "4 of 4. The night is over: the notes open nothing now."
      broadcast "🔢 {program.name} found all four digit notes after the night ended: no door code. Nothing happens in the story." to channel(hosts)
    else if program.door_digits >= 4 and Night.r3_closed == true:
      if program.quest.the_cold_door == "active":
        fail quest The Cold Door for program "4 of 4. The verdict is in: the notes open nothing now."
      broadcast "🔢 {program.name} found all four digit notes after truth.txt. The verdict is in: no door code. Nothing happens in the story." to channel(hosts)
    else if program.door_digits >= 4:
      complete quest The Cold Door for program "Four of four. The notes fit together: the door code is in your Codex."
      unlock The Door Code for program
      reply !🔢 Four of four. The notes fit together: the door code is in your Codex.
      broadcast "🔢 {program.name} found all four digit notes: the door code is in their Codex." to channel(hosts)
    else if program.quest.the_cold_door != "active":
      start quest The Cold Door for program "{program.door_digits} of 4. A note with one digit of the cold door's code. The others are hidden around the house."
      unlock The Cold Door for program
    else:
      update quest The Cold Door for program "{program.door_digits} of 4."

// E3: the patch bay. Today stagehand judges the cables and sends
// patch_combo_a / patch_combo_b / patch_rejected; once signal args exist
// it sends patch_changed {combo} and the story judges it here.
when patch_changed:
  if Night.ended != true and Night.step >= 14:
    if combo == Kernel.combo_a:
      fire patch_combo_a
    else if combo == Kernel.combo_b:
      fire patch_combo_b
    else:
      fire patch_rejected

when patch_rejected:
  if Night.ended != true and Night.r3_closed == true:
    fire patch_after_verdict
  else if Night.ended != true and Night.step >= 14:
    set Night.wrong_combos += 1
    -> Patch Rejected
  else:
    broadcast "❌ A wrong patch-bay combination outside the Y2K hour (🕚 first, before any ending): not counted, nothing happens." to channel(hosts)

when patch_combo_a:
  if Night.ended != true and Night.r3_closed == true:
    fire patch_after_verdict
  else if Night.ended != true and Night.step >= 14:
    fire trabolta_disabled
  else:
    broadcast "🔌 Not now: Combo A only counts in the Y2K hour (🕚 first, before any ending). Nothing happens." to channel(hosts)

when patch_combo_b:
  if Night.ended != true and Night.r3_closed == true:
    fire patch_after_verdict
  else if Night.ended != true and Night.step >= 14:
    fire computer_destroyed
  else:
    broadcast "💥 Not now: Combo B only counts in the Y2K hour (🕚 first, before any ending). Nothing happens." to channel(hosts)

when patch_after_verdict:
  broadcast "🔌 A patch after truth.txt. The verdict is in: the patch bay is quiet, nothing happens in the story." to channel(hosts)

// Talked down, like the Fallout Master: Trabolta's `stand_down` power
// (cast/trabolta.loom) only OFFERS, so a model misfire can never end the
// night; this is a human confirming it, or the director's own call with no
// offer on record. It is the Combo A ending without a cable
// (trabolta_disabled), with Night.talked_down so the blackout, the recount
// and the ceremony say who talked him down.
when talked_down:
  if Night.ended != true and Night.r3_closed == true:
    broadcast "🕊 The verdict is in: it is too late for Trabolta to stand down. Nothing happens in the story." to channel(hosts)
  else if Night.ended != true and Night.step >= 14:
    if Night.stand_down_by == "none":
      broadcast "🕊 No offer on record: Trabolta stands down on the director's call." to channel(hosts)
    else:
      broadcast "🕊 Trabolta stands down. {Night.stand_down_by} talked him down." to channel(hosts)
    set Night.talked_down = true
    fire trabolta_disabled
  else:
    broadcast "🕊 Nothing to stand down: it needs the Y2K hour, before any ending." to channel(hosts)

// Any ending stops every clock: a hunt, the summons, bingo or the Y2K
// hour left running would keep its corner countdown on the screens (under
// the go-to-the-living-room overlay) and fire its own time-up beat later.
// It also closes every live 📝 card (the record is closed: a card left up
// would invite a filing through the ceremony).
when Night.ended == true:
  set Night.card_gen += 1
  set Night.hunt_on = false
  set Night.hunt2_on = false
  set Night.summons_open = false
  set Night.bingo_on = false
  set Night.final_round = false
  set Night.hunt_end = 0
  set Night.hunt2_end = 0
  set Night.summons_end = 0
  set Night.bingo_end = 0
  set Night.y2k_end = 0

// E4: Combo A — take the grease out of the lightning.
when trabolta_disabled:
  if Night.ended != true:
    set Night.ended = true
    set Night.ending = "disabled"
    set Night.phase = "finale_killed"
    set Night.step = 19
    set Night.final_round = false
    complete quest Find The Exit for everyone
    fail quest The Final Facts for everyone "The night ended in the server room. The final facts were never read."
    complete quest The Exchange for McAfee Anti-Virus "The night ended in the server room. The exchange closes."
    complete quest The Audit for CRA Agent Software "The night ended in the server room. The audit closes."
    cue lights_blackout
    set Night.lights = "blackout"
    cue screens_blackout
    cue screens_go_to_living_room
    set Night.screen = "go_to_living_room"
    set Night.terminals = "go_to_living_room"
    sound dance_song
    set Night.dance_at = Time.elapsed + 10
    set Night.takeover = true
    pin "!!GO TO THE LIVING ROOM"
    do announce "Go to the living room."
    -> Trabolta Disabled

// Ten seconds of dark, then the dance look (the song file opens with ten
// seconds of silence, so music and lights land together). The dance also
// lifts the phones' full-screen GO TO THE LIVING ROOM (the `!!` pin above)
// and the screens' flashing one (a screen overlay stays up until a newer
// slide or base: the screensaver base clears it; everyone is in the living
// room by now).
when Night.dance_at > 0 and Time.elapsed >= Night.dance_at:
  set Night.dance_at = 0
  cue lights_dance
  set Night.lights = "dance"
  fire lift_the_takeover
  fire dance_screens

when lights_dance:
  set Night.dance_at = 0
  cue lights_dance
  set Night.lights = "dance"
  fire lift_the_takeover
  fire dance_screens

when dance_screens:
  if Night.screen == "go_to_living_room":
    cue screens_screensaver
    set Night.screen = "screensaver"
    set Night.terminals = "screensaver"

// The `!!` pin has no close button: every way out of the server-room
// endings takes it down (the dance, 🪩, the recount, the summary, the
// ceremony, the resurrection). Subject-free, so it is the room's one
// unkeyed pin whoever pressed the cue; once only.
when lift_the_takeover:
  if Night.takeover == true:
    set Night.takeover = false
    unpin "💃 Dance."

// After the dance: a weakened Trabolta ranks everyone one last time and
// recounts (the ranking machinery, round 3 → Trabolta Recounts).
when trabolta_recounts:
  if Night.ending == "disabled" and Night.rank_round != 3:
    fire lift_the_takeover
    set Night.recount = true
    cue screens_recount
    set Night.screen = "recount"
    set Night.terminals = "recount"
    set Night.rank_round = 3
    set Night.most_trusted = "none"
    set Night.least_trusted = "none"
    set Night.praised = false
    set Night.shamed = false
    set Night.ranking = true
  else:
    broadcast "🏍 Only after Combo A or a talk-down, once. Nothing happens." to channel(hosts)

// E6: Combo B — the computer is turned off without Shut Down.
when computer_destroyed:
  if Night.ended != true:
    set Night.ended = true
    set Night.ending = "destroyed"
    set Night.phase = "finale_shutdown"
    set Night.step = 19
    set Night.final_round = false
    set Trabolta.awake = false
    fail quest The Final Facts for everyone "The computer is off. Nobody will ever read the final facts."
    complete quest The Exchange for McAfee Anti-Virus "The computer is off. The exchange closes."
    complete quest The Audit for CRA Agent Software "The computer is off. The audit closes."
    // Clippy's summary reads each featured program's own quest; three of
    // them only a director completes. Remind # hosts of the ones still open.
    set Night.goals_todo = ""
    if count([p for p in Persons where p.featured == "runescape" and p.quest.the_gold_standard == "active"]) > 0:
      set Night.goals_todo = "The Gold Standard (Runescape)"
    if count([p for p in Persons where p.featured == "vlc" and p.quest.go_viral == "active"]) > 0:
      if Night.goals_todo != "":
        set Night.goals_todo = Night.goals_todo + ", "
      set Night.goals_todo = Night.goals_todo + "Go Viral (VLC)"
    if count([p for p in Persons where p.featured == "pong" and p.quest.keep_the_ball_in_play == "active"]) > 0:
      if Night.goals_todo != "":
        set Night.goals_todo = Night.goals_todo + ", "
      set Night.goals_todo = Night.goals_todo + "Keep The Ball In Play (Pong)"
    if Night.goals_todo != "":
      broadcast "🪦 Before 🪦 Clippy reads the summary: it says whether each featured program met their goal. Complete in the Inspector any of these that did: {Night.goals_todo}." to channel(hosts)
    unlock Clippy Instructions 9 for Clippy
    cue lights_blackout
    set Night.lights = "blackout"
    cue screens_blackout
    cue screens_go_to_living_room
    set Night.screen = "go_to_living_room"
    set Night.terminals = "go_to_living_room"
    sound windows_shutdown
    sound dance_song
    set Night.dance_at = Time.elapsed + 10
    set Night.takeover = true
    pin "!!GO TO THE LIVING ROOM"
    do announce "Go to the living room."
    -> Computer Destroyed

// E8: after the dance, Clippy reads the summary. Purgatory.
when clippy_reads_summary:
  if Night.ending == "destroyed":
    fire lift_the_takeover
    cue lights_purgatory
    set Night.lights = "purgatory"
    cue screens_purgatory
    set Night.screen = "purgatory"
    set Night.terminals = "purgatory"
    -> Purgatory
  else:
    broadcast "🪦 Only after Combo B (the shutdown). Nothing happens." to channel(hosts)

// ── F. The final reveal and the other endings ──

// F1: midnight (if nothing has ended, it calls the final reveal).
when y2k_midnight:
  if Night.final_round == true and Night.ended != true:
    set Night.final_round = false
    set Night.clock = "00:00"
    sound y2k_chime
    -> Clock Strikes
    if Night.ended != true:
      fire final_reveal
  else:
    broadcast "🎆 No midnight: it needs the Y2K hour, before any ending. Nothing happens." to channel(hosts)

// The server room stays live during the reveal and the bob (deliberate): a
// combo entered before 📄 truth.txt still ends the night. From truth.txt
// the verdict is in and the server room is quiet (E2).
when final_reveal:
  if Night.ended != true and Night.step < 16:
    set Night.final_round = false
    set Night.phase = "final_reveal"
    set Night.step = 16
    set Night.alerts = "bsod"
    set Night.round = 3
    set Night.judging = true
    unlock Clippy Instructions 8 for Clippy
    // The wallet trades on through the Y2K hour: the exchange and the
    // audit close here, at the reveal (or at a server-room ending, which
    // never reaches it).
    complete quest The Exchange for McAfee Anti-Virus "The final reveal. The exchange closes."
    complete quest The Audit for CRA Agent Software "The final reveal. The audit closes."
    cue lights_final_reveal
    set Night.lights = "final_reveal"
    cue screens_final_reveal
    set Night.screen = "final_reveal"
    set Night.terminals = "final_reveal"
    broadcast "!🌑 ALL PROGRAMS: to the living room for the final Truth Scavenger Hunt reveal." to everyone with go: The Desktop
    -> Final Reveal
  else:
    broadcast "🌑 Not now: the final reveal has already played, or the night has ended. Nothing happens." to channel(hosts)

// F2: Bobbing for Truth. Nothing proceeds until someone brings up the bag.
when bobbing_for_truth:
  if Night.ended != true and Night.step < 17:
    set Night.judging = false
    set Night.phase = "bobbing"
    set Night.step = 17
    cue screens_bobbing
    set Night.screen = "bobbing"
    set Night.terminals = "bobbing"
    -> Bobbing For Truth
  else:
    broadcast "🍎 Not now: the bob has already started, or the night has ended. Nothing happens." to channel(hosts)

// The bag is up: Trabolta stops them reading it and makes his final
// assessment first (the ranking machinery, round 2 → Final Assessment).
when bag_retrieved:
  set Night.rank_round = 2
  set Night.most_trusted = "none"
  set Night.least_trusted = "none"
  set Night.praised = false
  set Night.shamed = false
  set Night.ranking = true
  -> The Bag Of Truth

// F3: truth.txt, then (⚖, once the bobber has read it aloud) the verdict:
// Song Ending or Grok Prom. Round three closes and settles at 📄 (the ROLE
// settle watcher runs after this body), so the slide holds while it is read
// and The Verdict reads settled facts (a review filing still pending counts
// by its proposal).
when read_truth_txt:
  if Night.phase == "bobbing" and Night.bag_up == true and Night.r3_closed != true:
    complete quest The Final Facts for everyone
    set Night.recount = true
    set Night.r3_closed = true
    // Round 3's cards re-deal: an unfiled F1/F2 becomes the closing card.
    set Night.card_gen += 1
    set Night.settle_q = 0
    set Night.settle_round = 3
    set Night.settle_gen += 1
    cue screens_truth_txt
    set Night.screen = "truth_txt"
    set Night.terminals = "truth_txt"
    -> Truth Txt
  else if Night.phase == "bobbing" and Night.r3_closed == true:
    broadcast "📄 Already read: press ⚖ for the verdict when the bobber has finished. Nothing happens." to channel(hosts)
  else if Night.phase == "bobbing":
    broadcast "📄 Not yet: the Bag isn't up (🍎 Brought up the Bag on whoever surfaces with it). Nothing happens." to channel(hosts)
  else:
    broadcast "📄 Only during Bobbing for Truth (🍎 first). Nothing happens." to channel(hosts)

when the_verdict:
  if Night.phase == "bobbing" and Night.r3_closed == true and Night.ended != true:
    -> The Verdict
  else if Night.phase == "bobbing":
    broadcast "⚖ Not yet: 📄 Read truth.txt first. Nothing happens." to channel(hosts)
  else if Night.ended == true or Night.r3_closed == true:
    broadcast "⚖ Not now: the verdict is already in, or the night has ended. Nothing happens." to channel(hosts)
  else:
    broadcast "⚖ Not yet: 🍎 Bobbing for Truth, then 📄 truth.txt first. Nothing happens." to channel(hosts)

// F5: someone gave him the line (ROLE `pickup_line_accepted`).
when line_accepted:
  -> Pickup Line

// F6: nobody has the line. He takes his shot anyway; everyone is trapped.
when no_pickup_line:
  if Night.phase == "grok_prom" and Night.ended != true:
    set Night.ended = true
    set Night.ending = "rave"
    set Night.phase = "finale_rave"
    set Night.step = 19
    -> Sad Confession
  else:
    broadcast "💔 Only in Grok Prom (after ⚖ with a lie on record). Nothing happens." to channel(hosts)

// F7: the alternate relationship-advice ending, only after a failed
// verdict (Grok Prom).
when ask_for_advice:
  if Night.ended != true and Night.phase == "grok_prom":
    set Night.phase = "advice"
    set Night.step = 18
    set Night.poll = "advice"
    cue screens_advice
    set Night.screen = "advice"
    set Night.terminals = "advice"
    -> Relationship Advice
  else:
    broadcast "💌 Only in Grok Prom (after ⚖ with a lie on record). Nothing happens." to channel(hosts)

when advice_tally:
  if Night.phase == "advice" and Night.ended != true:
    if Night.help_votes >= Night.thwart_votes:
      fire advice_helped
    else:
      fire advice_thwarted
  else:
    broadcast "🗳 Only during the advice poll (💌 first). Nothing happens." to channel(hosts)

when advice_helped:
  if Night.phase == "advice" and Night.ended != true:
    set Night.ended = true
    set Night.ending = "help"
    set Night.phase = "finale_help"
    set Night.step = 19
    set Trabolta.love += 20
    -> Advice Helped
    sound motorcycle
    cue lights_restore
    set Night.lights = "restore"
    set Night.everyone_free = true
  else:
    broadcast "💞 Only during the advice poll (💌 first). Nothing happens." to channel(hosts)

// Not final: the hand jive can still follow.
when advice_thwarted:
  if Night.phase == "advice" and Night.ended != true and Night.ending != "banished":
    set Night.ending = "banished"
    set Night.phase = "finale_banish"
    set Night.step = 19
    set Trabolta.love -= 30
    set Night.banish = true
    cue lights_banish
    set Night.lights = "banish"
    cue screens_banish
    set Night.screen = "banish"
    set Night.terminals = "banish"
    // DRAFT w18
    broadcast "!!⛈ Trabolta is banishing EVERY program to the Internet. Antivirus included." to everyone with go: The Internet
    -> Advice Thwarted
  else:
    broadcast "⛈ Only during the advice poll (💌 first), once. Nothing happens." to channel(hosts)

when the_hand_jive:
  if Night.ending == "banished" and Night.ended != true:
    set Night.ended = true
    set Night.ending = "hand_jive"
    set Night.phase = "finale_hand_jive"
    set Night.step = 19
    set Night.banish = false
    set Night.everyone_free = true
    complete quest Find The Exit for everyone
    sound hand_jive
    broadcast "!🕺 THE HAND JIVE. Everyone, together. Trabolta cannot take it." to everyone
    -> The Hand Jive
    sound motorcycle
    cue lights_restore
    set Night.lights = "restore"
    cue screens_screensaver
    set Night.screen = "screensaver"
    set Night.terminals = "screensaver"
  else:
    broadcast "🕺 Only once everyone is banished (⛈). Nothing happens." to channel(hosts)

// ── G. The awards ceremony (K-25) ──
// After any final ending (never before: Best Liar would leak). The host
// follows the ending: Clippy when Trabolta is gone (destroyed: switched
// off; rave: rode away), Trabolta otherwise, so the TV speaks his lines.
// The award events are ROLE hooks (main.loom, ROLE Program); each ends
// in `present_award`, which shows the award slide and the host's line.
when start_the_ceremony:
  if Night.ended == true and Night.ceremony != true:
    set Night.ceremony = true
    set Night.alerts = "sticky"
    fire lift_the_takeover
    if Night.ending == "destroyed" or Night.ending == "rave":
      set Night.ceremony_host = "Clippy"
    else:
      set Night.ceremony_host = "Trabolta"
    cue screens_ceremony
    set Night.screen = "ceremony"
    set Night.terminals = "ceremony"
    sound ceremony_bed
    broadcast "!🏆 THE AWARDS CEREMONY. Every program to the living room." to everyone with go: The Desktop
    -> The Ceremony
  else if Night.ceremony == true:
    broadcast "🏆 The ceremony has already started. Nothing happens." to channel(hosts)
  else if Night.ending == "banished":
    broadcast "🏆 No ceremony yet: banished is not an ending (🕺 the hand jive first). Nothing happens." to channel(hosts)
  else:
    broadcast "🏆 No ceremony yet: the night has not ended. Nothing happens." to channel(hosts)

when present_award:
  if Night.ceremony == true:
    -> Present Award

// ✍ (D4): the second director's own award lines replace Trabolta's
// template line in Present Award (beats/ceremony.loom); a toggle.
when own_award_lines:
  if Night.award_lines == "director":
    set Night.award_lines = "template"
    broadcast "✍ Award lines: the template again. Trabolta reads each award's line himself." to channel(hosts)
  else:
    set Night.award_lines = "director"
    broadcast "✍ Award lines: yours. Each award plays its fanfare and slide with no Trabolta line: post yours as Trabolta in The Desktop right after you fire it. Clippy's lines are unchanged. Press ✍ again for the template." to channel(hosts)

// ── Anytime ──

// Lore shared TO Trabolta counts as a delivery for the sharer. Lore
// Broken Ask Jeeves shares with a program counts toward Ten Findings
// (`jeeves_shared` is a ROLE hook, so a share to a character never counts).
when share:
  if to == Trabolta:
    fire trabolta_heard for from
  else if from.featured == "jeeves":
    fire jeeves_shared for to

// Trabolta's `cut_the_lights` power darkens one allow-listed room for
// 90 s; this brings it back — unless a later look has set the room itself.
// A whole-house look since (an ending's blackout / dance, the server-room
// alarm, a restore, the Y2K hour…) re-lit every room already, and switching
// the room "on" now would punch the kitchen to full in the middle of it.
// The room-scoped looks never touch the cut room (trapped.house.yaml): 🏓
// pong lights the backyard, the majority's server_open the server room,
// the glitch is an effect with no state, and game / truth_time /
// trust_chart recall a scene on the living room only, so they re-light
// The Desktop but not the Start Bar or the RAM. After any of those the
// room still comes back on here. `Night.lit_scene` names the look the
// room came back on under ("none" when it didn't): stagehand's catch-up
// replays the room-on while that look, or a later look that never re-lit
// the room, is on; the rule below clears the mark at a look that re-lit
// it, so the story's last word wins.
when Night.lights_back_at > 0 and Time.elapsed >= Night.lights_back_at:
  if Night.lights == Night.dark_scene or Night.lights == "pong" or Night.lights == "glitch" or Night.lights == "server_open" or ((Night.lights == "game" or Night.lights == "truth_time" or Night.lights == "trust_chart") and Night.dark_room != "The Desktop"):
    <cue: lights, room: {Night.dark_room}, state: on>
    set Night.lit_scene = Night.lights
  else:
    set Night.lit_scene = "none"
  set Night.lights_back_at = 0

// The mark lasts until a look re-lights the room: a whole-house look
// (call_desktop, the Y2K hour, the alarm, an ending…) or a living-room
// look over a Desktop cut makes the restore history, so a look name that
// comes back later (the glitch at the beans and the overshare; server_open
// at the majority, always after the Y2K look) never re-arms the catch-up's
// room-on. A room-scoped look (pong, the glitch, server_open, a living-room
// look over a Start Bar or RAM cut) keeps it: the room is still the one the
// restore turned on, and a restore the house missed is still replayed. The
// restore sets both in one body, so this never fires on the restore itself.
when Night.lit_scene != "none" and Night.lights != Night.lit_scene and Night.lights != "pong" and Night.lights != "glitch" and Night.lights != "server_open" and (Night.dark_room == "The Desktop" or (Night.lights != "game" and Night.lights != "truth_time" and Night.lights != "trust_chart")):
  set Night.lit_scene = "none"

// 💡 is the first step of ALL STOP (the emergency card), so it also holds
// the dance a server-room ending armed for ten seconds after its blackout:
// the dance look would replace the house lights mid-emergency. It does not
// lift the takeover; 🪩 plays the held dance (and lifts it) once the house
// manager says go.
when restore_the_lights:
  cue lights_restore
  set Night.lights = "restore"
  set Night.lights_back_at = 0
  set Night.lit_scene = "none"
  if Night.dance_at > 0:
    set Night.dance_at = 0
    broadcast "💡 The dance is held: press 🪩 when the house manager says go." to channel(hosts)

// G11: the show is over. Only once the ceremony has started (G1; a
// mid-show press, or one between the ending and G1, does nothing), once,
// and after the last award (`Night.ceremony_done`): a press before it is
// a mis-press until confirmed — # hosts asks, and a second press within
// 30 seconds ends the show anyway (a skipped bonus award never strands it).
// Trabolta goes to sleep, so the TV and terminals fall to attract and stop
// piloting; the base cue clears the last award slide. A night with no
// ceremony presses G1 first.
when resurrection:
  if Night.ended == true and Night.ceremony == true and Night.resurrected != true and Night.ceremony_done != true and (Night._resurrect_ask_at == 0 or Time.elapsed > Night._resurrect_ask_at + 30):
    set Night._resurrect_ask_at = Time.elapsed + 1
    broadcast "🎃 The last award isn't presented yet (G10, or G9 with no MS Paint). Press G11 again within 30 seconds to end the show anyway." to channel(hosts)
  else if Night.ended == true and Night.ceremony == true and Night.resurrected != true:
    set Night.resurrected = true
    set Night.banish = false
    set Night.everyone_free = true
    set Night.alarm_on = false
    set Trabolta.awake = false
    fire lift_the_takeover
    cue screens_screensaver
    set Night.screen = "screensaver"
    set Night.terminals = "screensaver"
    cue lights_restore
    set Night.lights = "restore"
    set Night.lights_back_at = 0
    set Night.lit_scene = "none"
    broadcast "!🎃 The show is over: you are human again. Hang out, out of character." to everyone
  else if Night.resurrected == true:
    broadcast "🎃 The show is already over. Nothing happens." to channel(hosts)
  else:
    broadcast "🎃 Only once the ceremony has started (G1, after an ending). Nothing happens." to channel(hosts)

// ── Doors open ──────────────────────────────────────────────────────
// The story's opening beat, heard by every phone and every performer:
// it seeds every global (Trabolta's worker reads them), sets the
// screensaver look, and says one line to the room. Everything personal
// (the Optical Drive) plays per program on arrival, never here. No dialogue,
// no widgets. Its last line diverts to the generated `== Facts Seed`
// (generated/questions.loom: the 📝 card strings Night.q_h1 … q_f2 and the
// truth count). This must stay the LAST item in main.loom.
== Power On
  setting: The Desktop
// Signed off (w13 Q37, wave 18): the show clock starts at 7:00 PM at the doors.
set Clock.set_to = 1140
set Clock.set_at = Time.elapsed
set Night.phase = "arrivals"
set Night.step = 0
set Night.clock = "--:--"
set Night.bingo_on = false
set Night.bingo_end = 0
set Night.bingo_winners = 0
set Night.bingo_named = 0
set Night.bingo_ribbons = 0
set Night.first_reinstall = "none"
set Night.first_reinstall_done = false
set Night.trabolta_introduced = false
set Night.ads_started = false
set Night.round = 0
set Night.judging = false
set Night.hunt_on = false
set Night.hunt_end = 0
set Night.hunt_warn = 0
set Night.hunt_warned = false
set Night.hunt2_on = false
set Night.hunt2_end = 0
set Night.truther_at = 0
set Night.truther_sent = false
set Night.warn_at = 0
set Night.summons_open = false
set Night.summons_end = 0
set Night.summons_closed = false
set Night.auto_sweep = false
