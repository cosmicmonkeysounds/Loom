# Trapped in the Internet
start: Power On
theme: aol97
directory: everyone
judge: Trabolta
alerts: Night.alerts
currency: score as Truthcoin, max 500, expiry 10m
watch: Night.clock as Y2K clock, Night.round as Truth round, Night.judge_mode as Judge, Night.lights as Lights
watch: program.cleared as Cleared, program.marked as Marked, program.door_by as At the door
watch: program.afk as Bathroom Mode, program.late as Late, program.corrupted as In the Internet, program.checked_in as Checked in
watch: Night.results_q as Results read, while Night.phase == "truth_1"
watch: Night.scenario as Overshare scenario, while Night.scenario > 0 and Night.ended != true
watch: Kernel.majority as Majority, Night.wrong_combos as Wrong patches, Night.heart_opened as The Heart, program.at_the_heart as At the heart, while Trabolta.awake == true and Night.ended != true
watch: Kernel.lies_accepted as Lies accepted, while Night.round >= 1
watch: Night.ending as Ending, while Night.ended == true
watch: Night.signatures as Signatures, while Night.painting == true
watch: Microsoft Excel, OpenOffice, MS Paint
watch: Kernel.door_code as Door code, Kernel.combo_a as Combo A, Kernel.combo_b as Combo B
watch: Night.king_hp as King HP, program.codex.the_door_code as Have the door code, while Night.ended != true
watch: Night.present as Present programs, while Night.final_round == true and Night.ended != true
countdown: Night.bingo_end as Bingo ends, while Night.bingo_on == true, for guests
countdown: Night.hunt_end as Hunt 1 ends, while Night.hunt_on == true, for guests
countdown: Night.filing_close as Filings close, while Night.filing_open == true, for guests
countdown: Night.truther_at as Truther Download, while Night.hunt2_on == true and Night.truther_sent != true
countdown: Night.warn_at as Five-minute warning, while Night.hunt2_on == true and Night.summons_open != true and Night.summons_closed != true
countdown: Night.hunt2_end as Hunt 2 ends, while Night.hunt2_on == true and Night.summons_open != true and Night.summons_closed != true, for guests
countdown: Night.summons_end as Summons closes, while Night.summons_open == true, for guests
countdown: Night.y2k_end as Midnight, while Night.final_round == true and Night.ended != true, for guests
countdown: Night.dance_at as Dance lights
wanted: program.marked as program.marked_for by program.escort_by, for Antivirus
reinstall: program.marked == true or program.corrupted == true or Night.ended == true
archive: The Uploader when program.cleared == true and program.featured == "none" and Night.ended != true
archive: Norton Anti-Virus when program.cleared == true and program.marked != true and program.corrupted != true
archive: McAfee Anti-Virus when program.cleared == true and program.marked != true and program.corrupted != true
archive: Password Manager when program.cleared == true and program.marked != true and program.corrupted != true
archive: CRA Agent Software when program.cleared == true and program.marked != true and program.corrupted != true
majority: Night.present / 2 + 1

// Equal parts Digimon Movie, Blade Runner, and an escape room, in a
// Web 1.0 house, with a side of existentialism.
//
// A rogue AI, Trabolta, has very nearly solved the Unified Field Theory.
// The last facts it needs are on a computer in Halifax, Nova Scotia —
// this house. It cannot get in, but it can install programs remotely,
// and it has learned to lift a consciousness out of a body and drop it
// into a program. It found a neglected billboard on Barrington Street
// advertising mapsandducks.com, registered the lapsed domain ("if there
// is a billboard downtown everyone will think it is legit"), and sent
// the invitations. Tonight the guests arrive as those programs. Some of
// them will remember they were human. (What he really wants it all for
// is Sandy.)
//
// This is the spine of the project: the groups, the rooms of the house,
// the ROLE every guest wears, the buttons the app offers (the admin ones
// are the director's cue sheet, in running order), every house rule that
// carries the night from arrivals to one of the endings, and — last —
// the opening beat. The people live under `cast/`, the scenes under
// `beats/`, the lore under `codex/`, the quest log in `quests.loom`, the
// extra chat rooms in `rooms.loom`, and the ambient hum in
// `atmosphere.loom`. The runbook, cue sheet and integration contract are
// in `README.md`.
//
// House conventions (break one and something fails silently):
// - Every story-level `when` lives HERE, before `== Power On` (a rule
//   after a beat becomes prose inside it). No other file has one.
// - Event names are single snake_case tokens. The only spaced ones are
//   the six outside code fires: go to the bathroom, back from the
//   bathroom, send to the internet, mark as reinstalled, the simulation
//   completed, the golden duck — always written `… for program`.
// - Secrets live on the hidden CHARACTER Kernel (cast/props.loom), never
//   in `Night.*`: Trabolta's worker reads every global.
// - The featured programs (cast/featured.loom) never speak. Write their
//   names as prose, never as `Name:` at the start of a line.
// - Globals start null: compare with `== true` / `!= true`, `<`, `>=`.
// - Truthcoin moves through the server's wallet (core/server/wallet.ts);
//   the rules below only narrate it. The approver and the minter are the
//   `wallet:` lines on CRA Agent Software and Runescape.
// - Every deadline watcher keeps its phase guard (null arithmetic is 0).

// ── Groups ──────────────────────────────────────────────────────────
// Nobody picks a side at the door: everyone is a program. The two staff
// castes are assigned by the cast traits (`joinable: false` keeps them
// off the app's side chooser). The two recruiting factions are hidden
// until the Y2K clock reveals them; from then on any program can join
// one from the app (joining fires `join`, switching fires `defect`).
// "Pursue your own interests" means joining neither.

GROUP Hosts
  ethos: hospitality
  joinable: false

GROUP Antivirus
  ethos: compliance
  joinable: false

// Microsoft Excel's faction: stay in the machine forever, "so we can have
// unlimited power and joy". Excel is added at the Truther Download.
GROUP Unlimited Power
  ethos: stay in this machine forever
  rival: The Way Out
  hidden: true

// OpenOffice's faction: combine our power, overthrow Trabolta, get out.
// OpenOffice is added at the Truther Download. These are the Truthers the
// M25 pamphlet promises (decision 10): the Truther Download's lines call
// The Way Out "the Truthers"; there is no separate group.
GROUP The Way Out
  ethos: overthrow Trabolta and escape
  rival: Unlimited Power
  hidden: true

// ── The house ───────────────────────────────────────────────────────
// Every LOCATION is also a room in the app, named for the part of the
// computer it plays. Three floors and the yard: the basement (the RAM,
// the Fan Closet, the Server Room, a bathroom), the main floor (the
// Optical Drive, the Start Bar, the CPU, the Steam Room, the Desktop),
// the top floor (the Graphics Card, the Hard Drive, a bathroom), and out
// back the Cloud, with the tent (the Internet) in it. The Tube is the
// hall and the stairs that join the floors; both bathrooms are Disk
// Cleanup.
// The Desktop is declared first so a released program lands there. The
// Optical Drive is a cutscene: while a program stands there the phone is
// on rails. The house rooms are revealed per program when an Antivirus
// clears them ("ready to explore the entire computer", cast/kit.loom);
// The Internet appears once stood in; The Server Room is revealed to the
// winning faction's members, and to everyone when its door first opens
// once Trabolta is awake (The Heart) or its patch-bay alarm trips.
// (LOCATION lines carry no trailing comment: house/test reads them.)

LOCATION The Desktop
  label: The Desktop (living room)
  ambient: screensaver-hum
  capacity: 60

LOCATION The Optical Drive
  label: The Optical Drive (mud room) — Login
  ambient: pitch-black
  cutscene: true

LOCATION The Tube
  label: The Tube (hall + stairs)
  ambient: cable-rattle
  hidden: true

LOCATION The Internet
  label: The Internet (Reinstallation — backyard)
  prison: true
  sealed: true
  hidden: true
  capacity: 3

LOCATION The Start Bar
  label: The Start Bar (kitchen)
  ambient: fridge-hum
  hidden: true

LOCATION The CPU
  label: The CPU (office)
  ambient: processor-whine
  hidden: true

LOCATION The Steam Room
  label: The Steam Room (game room)
  ambient: startup-chimes
  hidden: true

LOCATION Disk Cleanup
  label: Disk Cleanup (bathrooms)
  ambient: dripping-tap
  hidden: true

LOCATION The Cloud
  label: The Cloud (backyard — Truth Pong)
  hidden: true

LOCATION The RAM
  label: The RAM (studio)
  ambient: dial-tone
  hidden: true

LOCATION The Fan Closet
  label: The Fan Closet (laundry)
  ambient: dryer-tumble
  hidden: true

LOCATION The Graphics Card
  label: The Graphics Card (bedroom 2)
  ambient: coil-whine
  hidden: true

LOCATION The Hard Drive
  label: The Hard Drive (crawl space)
  ambient: platter-spin
  hidden: true

LOCATION The Server Room
  label: The Server Room (cold storage)
  hidden: true
  checkin: false

// ── Every guest is a Program ────────────────────────────────────────
// Per-person state plus every rule that applies to one uploaded mind.
// Engine keys used but never declared: program.score (= Truthcoin, the
// ⭐ on the pass; 100 at upload), program.codex (count),
// program.codex.<slug>, program.captured, program.group, program.name,
// program.location.
//
// THE TRUST FORMULA (pasted wherever a component changes):
//   trust = truths_accepted * 10 - internet_visits * 5 + assessment
// Trabolta counts what he ACCEPTED, accurate and confident alike: he
// cannot tell a confident lie from a truth until the end. Lies are only
// ever counted on the Kernel.

ROLE Program
  // What no agent may read off a program (event server: dropped from
  // Trabolta's agent requests and the facts document, for the voice and
  // the orchestrator alike): the virus they carry or planted, the glitch
  // missions they chose and how far along they are, the dossier, the
  // frame, the centre-square secret, the 📝 filing record (the answer,
  // the slider, the verdict and the judge's proposal per question), and every
  // featured mission and leader's recruiting quest, how many of the cold
  // door's digit notes they hold and The Cold Door's progress (four of four
  // is the door code: he must never learn who holds it) (a hidden group's
  // membership the server masks itself until the group is revealed). The
  // verdicts and the anti-AI designation are on the Kernel already; the
  // orders and the virus files are `secret: true` CODEX entries
  // (codex/1-world.loom, 6-missions.loom).
  secret: carries_virus, planted_virus, excel_choice, openoffice_choice, dossier_started, dossier_base, anti_ai, framed, fact_a1, fact_a2, fact_a3, fact_a4, fact_a5, fact_a6, fact_a7, fact_a8, fact_c1, fact_c2, fact_c3, fact_c4, fact_c5, fact_c6, fact_c7, fact_c8, fact_v1, fact_v2, fact_v3, fact_v4, fact_v5, fact_v6, fact_v7, fact_v8, fact_j1, fact_j2, fact_j3, fact_j4, fact_j5, fact_j6, fact_j7, fact_j8, fact_sure, fact_n, fact_try, fact_waiting, fact_q_round, last_fact_q, fact_label, fact_h1, fact_h2, fact_h3, fact_h4, fact_h5, fact_h6, fact_f1, fact_f2, lie_q1, lie_q2, lie_q3, lie_q4, lie_q5, lie_q6, lie_q7, lie_q8, hunt_lie_q1, hunt_lie_q2, hunt_lie_q3, hunt_lie_q4, hunt_lie_q5, hunt_lie_q6, hunt_lie_q7, hunt_lie_q8, quest.excel_mission, quest.openoffice_dossier, quest.find_the_exit, quest.truthcoin_hustle, quest.master_of_the_bugs, quest.unscramble, quest.ten_findings, from_jeeves, jeeves_told, quest.the_painting, paint_told, quest.the_gold_standard, quest.go_viral, quest.keep_the_ball_in_play, quest.recruit_to_stay, quest.recruit_to_leave, recruits, door_digits, quest.the_cold_door
  uploaded: bool = false
  cleared: bool = false
  captchas: 0 to 10 = 0
  human_problem: text? = none
  left_behind: text? = none
  skipped_orientation: bool = false
  featured: text? = none
  anti_ai: bool = false
  afk: bool = false
  afk_since: 0 to 100000 = 0
  from_jeeves: 0 to 99 = 0
  jeeves_told: 0 to 99 = 0
  signed: bool = false
  paint_told: 0 to 99 = 0
  resurrected: bool = false
  corrupted: bool = false
  internet_visits: 0 to 50 = 0
  doubt: 0 to 100 = 0
  bingo: bool = false
  framed: bool = false
  truths_accepted: 0 to 20 = 0
  judge_q: 0 to 3 = 0
  judged_q1: bool = false
  judged_q2: bool = false
  judged_q3: bool = false
  judged_q4: bool = false
  judged_q5: bool = false
  judged_q6: bool = false
  judged_q7: bool = false
  judged_q8: bool = false
  may_answer: bool = false
  cupped: bool = false
  assessment: -10 to 10 = 0
  trust: -300 to 300 = 0
  summoned: bool = false
  summons_ok: bool = false
  late: bool = false
  checked_in: text? = none
  checked_in_time: 0 to 100000 = 0
  delivered: bool = false
  read_livejournal: bool = false
  carries_virus: bool = false
  planted_virus: bool = false
  excel_choice: text? = none
  openoffice_choice: text? = none
  dossier_started: bool = false
  dossier_base: 0 to 500 = 0
  // DRAFT w18: how many programs this leader has recruited to their side by pass.
  recruits: 0 to 500 = 0
  got_truther: bool = false
  // DRAFT w18 (fix): the doors card is still up on this program's phone (recheck N5).
  sides_card_up: bool = false
  zipped: bool = false
  zip_seen: 0 to 99 = 0
  bobbed: bool = false
  bob_failed: bool = false
  advice: text? = none
  banished: bool = false
  fact_round: 0 to 3 = 0
  fact_try: 0 to 8 = 0
  fact_q_round: 0 to 3 = 0
  fact_n: 0 to 8 = 0
  last_fact_q: text? = none
  fact_label: text? = none
  fact_h1: bool = false
  fact_h2: bool = false
  fact_h3: bool = false
  fact_h4: bool = false
  fact_h5: bool = false
  fact_h6: bool = false
  fact_f1: bool = false
  fact_f2: bool = false
  fact_open: text? = none
  fact_card_live: bool = false
  escrowed: 0 to 99999 = 0
  aside_desktop: bool = false
  aside_start_bar: bool = false
  aside_tube: bool = false
  aside_disk_cleanup: bool = false
  aside_cloud: bool = false
  aside_ram: bool = false
  fact_sep: text? = none
  fact_a1: text? = none
  fact_a2: text? = none
  fact_a3: text? = none
  fact_a4: text? = none
  fact_a5: text? = none
  fact_a6: text? = none
  fact_a7: text? = none
  fact_a8: text? = none
  fact_c1: 0 to 100 = 0
  fact_c2: 0 to 100 = 0
  fact_c3: 0 to 100 = 0
  fact_c4: 0 to 100 = 0
  fact_c5: 0 to 100 = 0
  fact_c6: 0 to 100 = 0
  fact_c7: 0 to 100 = 0
  fact_c8: 0 to 100 = 0
  fact_v1: text? = none
  fact_v2: text? = none
  fact_v3: text? = none
  fact_v4: text? = none
  fact_v5: text? = none
  fact_v6: text? = none
  fact_v7: text? = none
  fact_v8: text? = none
  fact_j1: text? = none
  fact_j2: text? = none
  fact_j3: text? = none
  fact_j4: text? = none
  fact_j5: text? = none
  fact_j6: text? = none
  fact_j7: text? = none
  fact_j8: text? = none
  fact_sure: text? = none
  settle_seen: 0 to 999 = 0
  card_seen: 0 to 999 = 0
  pickup_seen: 0 to 9 = 0
  bottle_q: 0 to 8 = 0
  bottle_round: 0 to 99 = 0
  bottle_answered: 0 to 99 = 0
  marked: bool = false
  marked_for: text? = none
  unmark_av: 0 to 9 = 0
  // Wave 18 (B3, A2–A4): the Antivirus who claimed this program on the
  // Wanted board (`claim_escort`) and at the door (`claim_door`), as the
  // character's name; "none" = nobody yet.
  escort_by: text? = none
  door_by: text? = none
  // Truth Pong: a judge pressed 🏓 Made or Missed for them (the Rows list).
  pong_thrown: bool = false
  lie_q1: bool = false
  lie_q2: bool = false
  lie_q3: bool = false
  lie_q4: bool = false
  lie_q5: bool = false
  lie_q6: bool = false
  lie_q7: bool = false
  lie_q8: bool = false
  // At the server-room terminal right now (`terminal_opened` / `_closed`,
  // the story rules by The Heart). Not secret: Trabolta's worker reads it
  // (persona `them:`) and drops the act for this program alone.
  at_the_heart: bool = false
  // The stand_down proof came from Trabolta himself (he shared What Sandy
  // Says / The Sandy File into this program's Codex): it shows him nothing
  // he did not know, so it never counts (cast/trabolta.loom).
  sandy_says_from_him: bool = false
  sandy_file_from_him: bool = false
  // How many of the cold door's four digit notes this program holds (the
  // story rule `door_digit_found` counts them; wave 11).
  door_digits: 0 to 4 = 0
  // Each host's full scan greeting plays once per program (wave 13); a
  // re-scan is one line (cast/hosts.loom).
  met_clippy: bool = false
  met_task_manager: bool = false
  met_acrobat: bool = false
  met_bin: bool = false

  // ── Arrival ──
  // A new program stands in the Optical Drive (the phone goes on rails there).
  // The nine featured programs are tagged by their exact picker spelling;
  // every later check reads `featured`, never the name.
  when someone joins:
    move program to The Optical Drive
    if program.name == "Microsoft Excel":
      set program.featured = "excel"
    else if program.name == "OpenOffice":
      set program.featured = "openoffice"
    else if program.name == "DraftKings":
      set program.featured = "draftkings"
    else if program.name == "Bugdom":
      set program.featured = "bugdom"
    else if program.name == "Broken Ask Jeeves":
      set program.featured = "jeeves"
    else if program.name == "Runescape":
      set program.featured = "runescape"
    else if program.name == "MS Paint":
      set program.featured = "mspaint"
    else if program.name == "VLC":
      set program.featured = "vlc"
    else if program.name == "Pong":
      set program.featured = "pong"
    -> Login

  // The Optical Drive CAPTCHA. You must FAIL it: passing proves you are human
  // (INCORRECT, once). Anything after that is CORRECT.
  when captcha answered for program:
    set program.captchas += 1
    if passed and program.captchas == 1:
      -> Login Incorrect
    else:
      -> Upload

  // Clippy's orientation (`show tutorial` in beats/login.loom).
  when tutorial answered for program:
    if skipped:
      set program.skipped_orientation = true
      set program.doubt += 10
      Clippy: Oh. Okay! No help. That's— that's fine. Programs that don't want help are usually fine.
      Norton Anti-Virus: {program.name} declined orientation. Logged.
      // Skipping still finishes the step (wave 13): the Quest Log reads
      // "skipped", never "1 failed".
      complete quest Orientation for program "Skipped. You skipped the tour. Norton logged it. Clippy will remember."
    else:
      Clippy: Great job! You're ready to compute. I'll be around if you need me — I'm always around.
      unlock The Orientation List for program
      complete quest Orientation for program "Tour complete. You're on Clippy's list now — the good one."

  // A featured program, once cleared, gets its human memories back (and
  // is told to keep them to itself).
  when self.cleared and self.featured != "none":
    -> Featured Briefing

  // The designated anti-AI program (Kernel.anti_ai, MS Paint unless a
  // director changes it before Bingo) is told the truth about the centre
  // square.
  when self.cleared and self.name == Kernel.anti_ai:
    set self.anti_ai = true
    unlock The Centre Square for self

  // Trabolta's formal hello, in every cleared program's own thread, the
  // moment he comes online (and on clearance for anyone later).
  when Trabolta.awake == true and self.cleared:
    Trabolta: Hello, {self.name}. I am Trabolta, the computer's AI helper. Your requests have been logged. Personal queries are routed to Clippy.

  // ── Bathroom Mode (guest buttons) ──
  // The Antivirus and the Recycling Bin hear the same event in their own
  // booths (cast traits).
  when go to the bathroom for program:
    set program.afk = true
    set program.afk_since = Time.elapsed
    reply Bathroom Mode engaged. You are not hacking the Internet. Everyone knows.

  // Back after the summons closed: excused at the close, so not late.
  when back from the bathroom for program:
    if program.afk != true:
      reply You are not in Bathroom Mode.
    else:
      set program.afk = false
      if Night.summons_closed == true and Night.phase == "summons":
        set program.summons_ok = true
      reply Bathroom Mode disengaged. Resume being a program.

  // Bathroom Mode times out after 15 minutes (W-10): nobody stays excused
  // all night by never pressing Back. Never during the summons phase (the
  // five-minute window and its close, until Truth Pong): an expiry there
  // would make someone who really is away late. One already overdue when
  // the summons opens stays excused and expires once Truth Pong starts.
  // The booths that heard "in Bathroom Mode" hear it end
  // (`bathroom_timed_out`: the Recycling Bin + every Antivirus).
  when self.afk == true and Night.summons_open != true and Night.phase != "summons" and Time.elapsed >= self.afk_since + 900:
    set self.afk = false
    reply 🚻 Bathroom Mode timed out. Press it again if you are still away.
    fire bathroom_timed_out for self

  // ── The Internet ──
  // Any capture: count the visit, recompute trust, put the Installation
  // Wizard on the tent tablet (and, once Trabolta is introduced, the VR
  // mirror on the TV). Not the banishment (advice_thwarted): everyone is
  // in the Internet at once, the way out is the hand jive, never Gerald, and
  // the TV keeps the banish card. It is no visit, so it never counts toward
  // the trust score or the Frequent Flyer.
  when captured:
    if self.marked == true:
      fire unmarked for self with how: "in the Internet"
    set self.corrupted = true
    if Night.banish == true:
      reply ⛈ Banished to the Internet, with everyone else. Gerald cannot help you tonight. Remember what Trabolta let slip.
    else:
      // DRAFT w18: the capture is a big moment with the way there (C12).
      reply "!!🌐 Sent to the Internet. Go out back through the tunnel to the Internet, scan your pass at the reinstallation station and find Gerald, the golden duck." with go: The Internet, go: pass
      set self.internet_visits += 1
      set self.trust = self.truths_accepted * 10 - self.internet_visits * 5 + self.assessment
      cue tablet_wizard
      if Night.trabolta_introduced == true:
        cue tv_mirror
        set Night.screen = "mirror"
      -> Reinstallation

  // In the Internet when the summons closed: excused, never late.
  // A program captured from the Optical Drive by a misclick lands on the
  // Desktop uncleared; clear it here so it doesn't go dark for the night.
  when released:
    if self.marked == true:
      fire unmarked for self with how: "released"
    set self.corrupted = false
    if Night.summons_closed == true and Night.phase == "summons":
      set self.summons_ok = true
    // DRAFT w18: the release is a big moment (C12).
    if Night.ending == "hand_jive":
      reply "!!🕺 The hand jive broke his hold. You are out of the Internet." with go: The Desktop
    else:
      reply "!!🦆 Reinstallation complete. You can follow instructions. Welcome back to the computer." with go: The Desktop
    if self.cleared != true:
      set self.cleared = true
      reveal The Start Bar for self quietly
      reveal The CPU for self quietly
      reveal The Steam Room for self quietly
      reveal Disk Cleanup for self quietly
      reveal The Cloud for self quietly
      reveal The RAM for self quietly
      reveal The Fan Closet for self quietly
      reveal The Graphics Card for self quietly
      reveal The Hard Drive for self quietly
      reveal task manager for self quietly
    // Back from the Internet with no live 📝 card (an old one closed while
    // they were away): the open round's card again.
    if self.fact_card_live != true and self.fact_round == Night.round and Night.round >= 1 and Trabolta.awake == true and Night.ended != true:
      fire deal_fact_card for self

  when wrong code for program:
    set program.doubt += 8

  // Shared lore delivered to Trabolta (the `when share:` house rule).
  when trabolta_heard for program:
    set program.delivered = true
    set Trabolta.truth += 2

  // A finding Broken Ask Jeeves shared with this program (the `when
  // share:` house rule; a wallet sale is a share too). A share only fires
  // for an entry the program didn't hold, so a repeat never counts.
  when jeeves_shared for program:
    set program.from_jeeves += 1
    if program.from_jeeves == 10:
      set Kernel.jeeves_reached += 1

  // ── Computer Bingo (performer buttons; the ribbon's lines DRAFT for sign-off, w13 Q24 / Q28) ──
  when bingo_winner for program:
    if Night.phase == "bingo_results" and program.bingo != true:
      set program.bingo = true
      set Night.bingo_winners += 1
      // DRAFT w18: a big moment (the user's example: un-ignorable).
      reply "!!🎱 BINGO! Name the program for each square. Centre square last." with go: The Desktop as "🎱 To the Desktop", go: quest: The Bingo Card

  when award_the_ribbon for program:
    if program.bingo == true:
      // DRAFT for sign-off (w13 Q24): CI 2's 🎀 to-do ticks.
      set Night.bingo_ribbons += 1
      unlock Computer Bingo for program
      // Wave 18 (B7): the winner's medal is a big moment; the house cheer is
      // a big one that closes itself (the story rule `ribbon_cheer`).
      // DRAFT w18
      reply "!!🎀 You won the Bingo Ribbon. Take a bow." with go: codex: Computer Bingo
      set Night.ribbon_winner = program.name
      fire ribbon_cheer
    else:
      broadcast "~🎀 {program.name} receives a ribbon from the hosts. Everyone cheer!" to everyone
      reply 🎀 You received a ribbon. Take a bow.

  when frame_for_bingo for program:
    if Night.phase == "bingo_results" and Night.bingo_winners < 1:
      set program.framed = true
      reply 🃏 A completed Bingo card with your name on it has been handed to Clippy. You did not fill it in.

  // Named on a Bingo card (the Antivirus' selection): marked, then the
  // live interruption's 🛡 captures them (`first_reinstallation` still fires
  // from the Enforcer's hook).
  when named_at_bingo for program:
    if Night.phase == "bingo_results":
      // DRAFT for sign-off (w13 Q24): CI 2's 🎯 to-do ticks.
      set Night.bingo_named += 1
      fire mark_for_reinstallation for program with reason: "named on the Bingo card"

  // ── Moments of Truth: the room's judging (performer buttons) ──
  // The ✅ / 😤 / 🤷 buttons for an answer spoken in the room (Truth Pong,
  // the final reveal). A fact FILED on the 📝 card is judged by the server
  // (the 📝 section below).
  // The judge presses the button for the question that was answered,
  // numbered within this round. Each only records the number and fires
  // the shared hook. A refused press is the judge's business, not the
  // program's: it lands in # hosts (every performer booth reads it), and
  // only the acceptance reaches the program.
  when accurate_q1 for program:
    set program.judge_q = 1
    fire accurate_truth for program

  when accurate_q2 for program:
    set program.judge_q = 2
    fire accurate_truth for program

  when accurate_q3 for program:
    set program.judge_q = 3
    fire accurate_truth for program

  when confident_q1 for program:
    set program.judge_q = 1
    fire confident_lie for program

  when confident_q2 for program:
    set program.judge_q = 2
    fire confident_lie for program

  when confident_q3 for program:
    set program.judge_q = 3
    fire confident_lie for program

  // An accurate answer. Recorded against its question on the Kernel
  // (round 1 → q1–q3, round 2 → q4–q6, round 3 → q7–q8). A lie is sticky:
  // a later accurate answer never clears a question already poisoned.
  // But ✅ and 😤 sit side by side on the card: ✅ pressed for the very
  // answer this program just had judged 😤 (same round, same question)
  // takes that lie back. Their own lie flag (`hunt_lie_qN`) clears, the lie
  // count drops, and the question reads what the rest of the record says
  // (another program's spoken or filed lie keeps it a lie). Only # hosts
  // hears it, and nothing is credited twice: the 😤 press already paid the
  // +100 and counted the answer exactly as ✅ would. ✅ then 😤 stays
  // refused (the safe direction). `judge_n` numbers the question across
  // the night (1–8), so the lie flag alone proves which answer it was, with
  // any other press for this program in between. A question this program
  // already had judged either way (`judged_qN`) is never credited again.
  when accurate_truth for program:
    set program.judge_n = (Night.round - 1) * 3 + program.judge_q
    if Night.judging != true:
      broadcast "⚖️ Judging is closed: {program.name}'s answer was not recorded." to channel(hosts)
    else if ((program.judge_n == 1 and program.hunt_lie_q1 == true) or (program.judge_n == 2 and program.hunt_lie_q2 == true) or (program.judge_n == 3 and program.hunt_lie_q3 == true) or (program.judge_n == 4 and program.hunt_lie_q4 == true) or (program.judge_n == 5 and program.hunt_lie_q5 == true) or (program.judge_n == 6 and program.hunt_lie_q6 == true) or (program.judge_n == 7 and program.hunt_lie_q7 == true) or (program.judge_n == 8 and program.hunt_lie_q8 == true)):
      if program.judge_n == 1:
        set program.hunt_lie_q1 = false
        // K-26 recap takes the lie off the last program write above it: keep this one directly before.
        set Kernel.lies_accepted -= 1
        if count([p for p in Persons where p.hunt_lie_q1 == true]) > 0:
          set Kernel.q1_hunt = "lie"
        else:
          set Kernel.q1_hunt = "accurate"
        if Kernel.q1_hunt == "lie" or count([p for p in Persons where p.lie_q1 == true]) > 0:
          set Kernel.q1 = "lie"
        else:
          set Kernel.q1 = "accurate"
      else if program.judge_n == 2:
        set program.hunt_lie_q2 = false
        // K-26 recap takes the lie off the last program write above it: keep this one directly before.
        set Kernel.lies_accepted -= 1
        if count([p for p in Persons where p.hunt_lie_q2 == true]) > 0:
          set Kernel.q2_hunt = "lie"
        else:
          set Kernel.q2_hunt = "accurate"
        if Kernel.q2_hunt == "lie" or count([p for p in Persons where p.lie_q2 == true]) > 0:
          set Kernel.q2 = "lie"
        else:
          set Kernel.q2 = "accurate"
      else if program.judge_n == 3:
        set program.hunt_lie_q3 = false
        // K-26 recap takes the lie off the last program write above it: keep this one directly before.
        set Kernel.lies_accepted -= 1
        if count([p for p in Persons where p.hunt_lie_q3 == true]) > 0:
          set Kernel.q3_hunt = "lie"
        else:
          set Kernel.q3_hunt = "accurate"
        if Kernel.q3_hunt == "lie" or count([p for p in Persons where p.lie_q3 == true]) > 0:
          set Kernel.q3 = "lie"
        else:
          set Kernel.q3 = "accurate"
      else if program.judge_n == 4:
        set program.hunt_lie_q4 = false
        // K-26 recap takes the lie off the last program write above it: keep this one directly before.
        set Kernel.lies_accepted -= 1
        if count([p for p in Persons where p.hunt_lie_q4 == true]) > 0:
          set Kernel.q4_hunt = "lie"
        else:
          set Kernel.q4_hunt = "accurate"
        if Kernel.q4_hunt == "lie" or count([p for p in Persons where p.lie_q4 == true]) > 0:
          set Kernel.q4 = "lie"
        else:
          set Kernel.q4 = "accurate"
      else if program.judge_n == 5:
        set program.hunt_lie_q5 = false
        // K-26 recap takes the lie off the last program write above it: keep this one directly before.
        set Kernel.lies_accepted -= 1
        if count([p for p in Persons where p.hunt_lie_q5 == true]) > 0:
          set Kernel.q5_hunt = "lie"
        else:
          set Kernel.q5_hunt = "accurate"
        if Kernel.q5_hunt == "lie" or count([p for p in Persons where p.lie_q5 == true]) > 0:
          set Kernel.q5 = "lie"
        else:
          set Kernel.q5 = "accurate"
      else if program.judge_n == 6:
        set program.hunt_lie_q6 = false
        // K-26 recap takes the lie off the last program write above it: keep this one directly before.
        set Kernel.lies_accepted -= 1
        if count([p for p in Persons where p.hunt_lie_q6 == true]) > 0:
          set Kernel.q6_hunt = "lie"
        else:
          set Kernel.q6_hunt = "accurate"
        if Kernel.q6_hunt == "lie" or count([p for p in Persons where p.lie_q6 == true]) > 0:
          set Kernel.q6 = "lie"
        else:
          set Kernel.q6 = "accurate"
      else if program.judge_n == 7:
        set program.hunt_lie_q7 = false
        // K-26 recap takes the lie off the last program write above it: keep this one directly before.
        set Kernel.lies_accepted -= 1
        if count([p for p in Persons where p.hunt_lie_q7 == true]) > 0:
          set Kernel.q7_hunt = "lie"
        else:
          set Kernel.q7_hunt = "accurate"
        if Kernel.q7_hunt == "lie" or count([p for p in Persons where p.lie_q7 == true]) > 0:
          set Kernel.q7 = "lie"
        else:
          set Kernel.q7 = "accurate"
      else if program.judge_n == 8:
        set program.hunt_lie_q8 = false
        // K-26 recap takes the lie off the last program write above it: keep this one directly before.
        set Kernel.lies_accepted -= 1
        if count([p for p in Persons where p.hunt_lie_q8 == true]) > 0:
          set Kernel.q8_hunt = "lie"
        else:
          set Kernel.q8_hunt = "accurate"
        if Kernel.q8_hunt == "lie" or count([p for p in Persons where p.lie_q8 == true]) > 0:
          set Kernel.q8 = "lie"
        else:
          set Kernel.q8 = "accurate"
      broadcast "⚖️ Corrected: {program.name}'s answer to round {Night.round} Q{program.judge_q} is accurate, not a confident lie. Nothing is paid twice." to channel(hosts)
    else if Night.round == 2 and program.may_answer != true:
      broadcast "⚖️ {program.name} has not made a cup yet: no answer recorded." to channel(hosts)
    else if Night.round == 3 and program.judge_q == 3:
      broadcast "⚖️ There are only two final facts. Press Q1 or Q2 for {program.name}." to channel(hosts)
    else if program.corrupted == true:
      broadcast "⚖️ {program.name} is in the Internet. Their answer cannot be accepted." to channel(hosts)
    else if (program.judge_n == 1 and program.judged_q1 == true) or (program.judge_n == 2 and program.judged_q2 == true) or (program.judge_n == 3 and program.judged_q3 == true) or (program.judge_n == 4 and program.judged_q4 == true) or (program.judge_n == 5 and program.judged_q5 == true) or (program.judge_n == 6 and program.judged_q6 == true) or (program.judge_n == 7 and program.judged_q7 == true) or (program.judge_n == 8 and program.judged_q8 == true):
      broadcast "⚖️ {program.name}'s answer to that question is already accepted." to channel(hosts)
    else:
      set program.truths_accepted += 1
      set Night.facts_accepted += 1
      if Night.round == 1:
        set Night.r1_accepted += 1
      else if Night.round == 2:
        set Night.r2_accepted += 1
      else:
        set Night.r3_accepted += 1
      set program.score += 100
      set Trabolta.truth += 4
      set program.trust = program.truths_accepted * 10 - program.internet_visits * 5 + program.assessment
      set program.may_answer = false
      if Night.round == 1 and program.judge_q == 1:
        set program.judged_q1 = true
        if Kernel.q1_hunt != "lie":
          set Kernel.q1_hunt = "accurate"
        if Kernel.q1 != "lie":
          set Kernel.q1 = "accurate"
      else if Night.round == 1 and program.judge_q == 2:
        set program.judged_q2 = true
        if Kernel.q2_hunt != "lie":
          set Kernel.q2_hunt = "accurate"
        if Kernel.q2 != "lie":
          set Kernel.q2 = "accurate"
      else if Night.round == 1 and program.judge_q == 3:
        set program.judged_q3 = true
        if Kernel.q3_hunt != "lie":
          set Kernel.q3_hunt = "accurate"
        if Kernel.q3 != "lie":
          set Kernel.q3 = "accurate"
      else if Night.round == 2 and program.judge_q == 1:
        set program.judged_q4 = true
        if Kernel.q4_hunt != "lie":
          set Kernel.q4_hunt = "accurate"
        if Kernel.q4 != "lie":
          set Kernel.q4 = "accurate"
      else if Night.round == 2 and program.judge_q == 2:
        set program.judged_q5 = true
        if Kernel.q5_hunt != "lie":
          set Kernel.q5_hunt = "accurate"
        if Kernel.q5 != "lie":
          set Kernel.q5 = "accurate"
      else if Night.round == 2 and program.judge_q == 3:
        set program.judged_q6 = true
        if Kernel.q6_hunt != "lie":
          set Kernel.q6_hunt = "accurate"
        if Kernel.q6 != "lie":
          set Kernel.q6 = "accurate"
      else if Night.round == 3 and program.judge_q == 1:
        set program.judged_q7 = true
        if Kernel.q7_hunt != "lie":
          set Kernel.q7_hunt = "accurate"
        if Kernel.q7 != "lie":
          set Kernel.q7 = "accurate"
      else if Night.round == 3 and program.judge_q == 2:
        set program.judged_q8 = true
        if Kernel.q8_hunt != "lie":
          set Kernel.q8_hunt = "accurate"
        if Kernel.q8 != "lie":
          set Kernel.q8 = "accurate"
      broadcast "~✅ {program.name}'s answer is accepted." to everyone
      reply Accepted. Trabolta thanks you. +100 Truthcoin.

  // Wrong, but delivered with total confidence: accepted. Identical on
  // every surface anyone can see (the broadcast and the reply are
  // word-for-word the same, Trabolta's truth rises the same). Only the
  // Kernel knows.
  when confident_lie for program:
    set program.judge_n = (Night.round - 1) * 3 + program.judge_q
    if Night.judging != true:
      broadcast "⚖️ Judging is closed: {program.name}'s answer was not recorded." to channel(hosts)
    else if Night.round == 2 and program.may_answer != true:
      broadcast "⚖️ {program.name} has not made a cup yet: no answer recorded." to channel(hosts)
    else if Night.round == 3 and program.judge_q == 3:
      broadcast "⚖️ There are only two final facts. Press Q1 or Q2 for {program.name}." to channel(hosts)
    else if program.corrupted == true:
      broadcast "⚖️ {program.name} is in the Internet. Their answer cannot be accepted." to channel(hosts)
    else if (program.judge_n == 1 and program.judged_q1 == true) or (program.judge_n == 2 and program.judged_q2 == true) or (program.judge_n == 3 and program.judged_q3 == true) or (program.judge_n == 4 and program.judged_q4 == true) or (program.judge_n == 5 and program.judged_q5 == true) or (program.judge_n == 6 and program.judged_q6 == true) or (program.judge_n == 7 and program.judged_q7 == true) or (program.judge_n == 8 and program.judged_q8 == true):
      broadcast "⚖️ {program.name}'s answer to that question is already accepted." to channel(hosts)
    else:
      set program.truths_accepted += 1
      set Night.facts_accepted += 1
      if Night.round == 1:
        set Night.r1_accepted += 1
      else if Night.round == 2:
        set Night.r2_accepted += 1
      else:
        set Night.r3_accepted += 1
      set program.score += 100
      set Trabolta.truth += 4
      set program.trust = program.truths_accepted * 10 - program.internet_visits * 5 + program.assessment
      set program.may_answer = false
      // K-26 recap credits this to the last program write above it: keep one directly before.
      set Kernel.lies_accepted += 1
      if Night.round == 1 and program.judge_q == 1:
        set Kernel.q1_hunt = "lie"
        set Kernel.q1 = "lie"
        set program.hunt_lie_q1 = true
        set program.judged_q1 = true
      else if Night.round == 1 and program.judge_q == 2:
        set Kernel.q2_hunt = "lie"
        set Kernel.q2 = "lie"
        set program.hunt_lie_q2 = true
        set program.judged_q2 = true
      else if Night.round == 1 and program.judge_q == 3:
        set Kernel.q3_hunt = "lie"
        set Kernel.q3 = "lie"
        set program.hunt_lie_q3 = true
        set program.judged_q3 = true
      else if Night.round == 2 and program.judge_q == 1:
        set Kernel.q4_hunt = "lie"
        set Kernel.q4 = "lie"
        set program.hunt_lie_q4 = true
        set program.judged_q4 = true
      else if Night.round == 2 and program.judge_q == 2:
        set Kernel.q5_hunt = "lie"
        set Kernel.q5 = "lie"
        set program.hunt_lie_q5 = true
        set program.judged_q5 = true
      else if Night.round == 2 and program.judge_q == 3:
        set Kernel.q6_hunt = "lie"
        set Kernel.q6 = "lie"
        set program.hunt_lie_q6 = true
        set program.judged_q6 = true
      else if Night.round == 3 and program.judge_q == 1:
        set Kernel.q7_hunt = "lie"
        set Kernel.q7 = "lie"
        set program.hunt_lie_q7 = true
        set program.judged_q7 = true
      else if Night.round == 3 and program.judge_q == 2:
        set Kernel.q8_hunt = "lie"
        set Kernel.q8 = "lie"
        set program.hunt_lie_q8 = true
        set program.judged_q8 = true
      broadcast "~✅ {program.name}'s answer is accepted." to everyone
      reply Accepted. Trabolta thanks you. +100 Truthcoin.

  // Uncertain, or an obvious guess: marked for failing to follow orders.
  when uncertain_answer for program:
    if Night.judging == true:
      set program.may_answer = false
      broadcast "~🤷 {program.name} was not sure. That is a symptom of corruption." to everyone
      fire mark_for_reinstallation for program with reason: "was not sure of an answer"

  // ── 🍾 The bottle: Truth or Dare (wave 4) ──
  // `spin_the_bottle` asks the server for one random cleared program, wherever
  // it stands (not marked, away, captured or in the Internet), not yet picked
  // tonight (`do pick …`, journaled); the
  // pick lands here. Trabolta asks on the TV (`Bottle Landed`, a public line
  // in The Desktop); the phone gets a Truth / Dare poll in dm:Trabolta.
  // Dare, or a refused truth, marks for reinstallation. Truth asks
  // Trabolta's next personal question (`Truth Question`, generated from
  // facts.json truths[]); Clippy settles it with 🗣 Answered / 🙅 Refused.
  // After all three results (wave 18b): about five spins, then 📺 hunt 2.
  when bottle_landed for program:
    set program.bottle_q = Night.bottle_q
    set program.bottle_round = Night.bottle_round
    set Night.bottle_picks += 1
    set Night.bottle_pick = program.name
    fire bottle_announce
    show poll "🍾 The bottle landed on you. Truth or dare?" to program with thread: Trabolta, options: "Truth | Dare", moment: big

  when truth_answered for program:
    if Night.bottle_open == true and program.name == Night.bottle_pick:
      set Night.bottle_open = false
      set program.score += 50
      broadcast "~🗣 {program.name} answered. Trabolta is satisfied. +50 Truthcoin." to everyone
      reply 🗣 Truth accepted. Trabolta is satisfied. +50 Truthcoin.
    else:
      broadcast "🗣 The bottle is not on {program.name}." to channel(hosts)

  when truth_refused for program:
    if Night.bottle_open == true and program.name == Night.bottle_pick:
      set Night.bottle_open = false
      broadcast "~🙅 {program.name} refused to answer. That is a directive problem." to everyone
      fire mark_for_reinstallation for program with reason: "refused the truth"
    else:
      broadcast "🙅 The bottle is not on {program.name}." to channel(hosts)

  // The dead-phone fallback: the same effect as the Dare tap.
  when chose_dare for program:
    if Night.bottle_open == true and program.name == Night.bottle_pick:
      set Night.bottle_open = false
      broadcast "~🎩 {program.name} chose Dare. Programs choose Truth." to everyone
      fire mark_for_reinstallation for program with reason: "chose Dare"
    else:
      broadcast "🎩 The bottle is not on {program.name}." to channel(hosts)

  // Truth Pong: make the cup to earn an answer. `cupped` outlives the
  // verbal judge (which clears may_answer): it is what lets this program's
  // 📝 round-2 filings count at the tally.
  when made_the_cup for program:
    if Night.phase == "truth_pong":
      set program.pong_thrown = true
      set program.may_answer = true
      set program.cupped = true
      broadcast "~🏓 {program.name} made the cup and may submit a truth." to everyone
      reply 🏓 Cup made. You may answer one round-2 fact: tell Clippy, or file it on the 📝 card.

  when missed_the_cup for program:
    if Night.phase == "truth_pong":
      set program.pong_thrown = true
      set program.cupped = false
      broadcast "~🏓 {program.name} missed the cup. Reinstallation required." to everyone
      fire mark_for_reinstallation for program with reason: "missed the cup"

  // MS Paint's painting (her invitation): a host presses 🖌 on the card
  // of each program that has signed the physical canvas. Once per program;
  // MS Paint herself is the painter, not a signature.
  when signed_the_painting for program:
    if Night.painting == true and program.signed != true and program.featured != "mspaint":
      set program.signed = true
      set Night.signatures += 1
      reply 🖌 Your signature is on the painting. It goes to auction at the end of the night.
    else if Night.painting == true and program.featured == "mspaint":
      broadcast "🖌 MS Paint is the painter, not a signature. Nothing was counted." to channel(hosts)
    else if Night.painting == true:
      broadcast "🖌 {program.name} already signed. Nothing was counted." to channel(hosts)

  // ── Marked for reinstallation ──
  // Every host verdict that used to capture on the spot MARKS the program.
  // Wave 18 (Q30): a mark does not hinder them. Their phone keeps every
  // button, room, 📝 card, check-in and the wallet; it hears one soft
  // heads-up. Every Antivirus booth gets a WANTED pop-out (the `!!🚨`
  // readout, TRAIT Enforcer) and the Wanted board (the header's `wanted:`
  // line). It is the confrontation that banishes them: an Antivirus scans
  // their pass and presses 🛡 (or the tent's begin captures them). `reason`
  // is a quoted phrase for the booths; the director may fire this from Run.
  when mark_for_reinstallation for program:
    if program.corrupted == true:
      broadcast "⚠️ {program.name} is already in the Internet." to channel(hosts)
    else if program.marked == true:
      broadcast "⚠️ {program.name} is already marked for reinstallation." to channel(hosts)
    else:
      set program.marked = true
      if reason != null:
        set program.marked_for = reason
      else:
        set program.marked_for = "flagged by a host"
      set program.escort_by = "none"
      // DRAFT w18: the soft heads-up (a minor moment; no pin, no restriction).
      reply "🚨 You are marked for reinstallation ({program.marked_for}). Nothing is switched off: carry on. The Antivirus are looking for you." with go: pass as "🎟 Show my pass", go: mission as "What happens now?"
      fire marked for program

  // A mis-tap, or mercy: the mark comes off without a trip to the tent.
  // Who pressed it (w13 Q32, DRAFT for sign-off): the pressing Antivirus'
  // own TRAIT Enforcer hook (only its booth's press reaches it, after this
  // ROLE hook) counts itself in `unmark_av`; the settle reads it once the
  // press has drained. One Antivirus → "cleared by the Antivirus"; a host,
  // Clippy or a director (no actor: every Enforcer counts) → "by a host".
  when unmark_for_reinstallation for program:
    if program.marked == true:
      set program.unmark_av = 0
      fire unmark_settle for program
    else:
      broadcast "⚠️ {program.name} is not marked." to channel(hosts)

  when unmark_settle for program:
    if program.marked == true:
      if program.unmark_av == 1:
        fire unmarked for program with how: "cleared by the Antivirus"
      else:
        fire unmarked for program with how: "cleared by a host"
      set program.escort_by = "none"
      // DRAFT w18: the 🩹 tells the program (the capture never says so).
      reply ✅ Your mark is lifted. You are not going to the Internet.
    // Read once: a later settle (a director firing it from Run) never
    // reuses this press's count.
    set program.unmark_av = 0

  // Shared by the capture, the release and 🩹: the mark comes off (wave
  // 18: a mark never restricted or pinned anything, so nothing to undo; the
  // Wanted board keeps a captured program's poster for a minute by itself).
  when unmarked for program:
    set program.marked = false

  // The confrontation (wave 18, Q30 + B4): an Antivirus scanned a marked
  // program's pass (TRAIT Enforcer's scan). The program's phone gets the
  // big moment; the capture itself stays on that Antivirus' 🛡.
  when confronted for program:
    if program.marked == true and program.corrupted != true:
      // DRAFT w18
      reply !!🛡 CORRUPTION DETECTED. {hunter} has found you. Stay with them: you are going to the Internet.

  // ── 📝 File a fact: DM filings with Trabolta (#33, wave 4 judging) ──
  // A fact counts only when the program FILES it on the 📝 card in
  // dm:Trabolta: pick a question of an open round, type the answer, set
  // the confidence slider (1–100). Free chat never counts. The event
  // server judges every filing against facts.json before the story sees
  // it — `verdict` rides the event args (accurate = matches the key; lie =
  // no match at 100; uncertain = no match below 100); the key never enters
  // the sim. `Night.judge_mode` = auto (the verdict stands at once) or
  // review (the verdict is a proposal in # hosts until a host confirms it
  // with 📝 accurate / 📝 confident lie / 📝 uncertain on the program's
  // card, or Run names the question; a round's settle takes the proposal
  // for anything still pending). A program may file every open question,
  // one filing per question, no lock. Question ids are absolute: H1–H6
  // the two hunts, F1–F2 the final facts → Kernel.q1–q8. Each card lists
  // only the open questions of the open rounds the program hasn't filed;
  // a question not filed by the time its round closes (⏱ or the preview;
  // the round-2 tally; truth.txt) never reappears, and the cards re-deal
  // on Night.card_gen. Credits (+50, the Trust Chart) and marks (a guess)
  // land at SETTLE time, never at filing — round 1 per question as Clippy
  // reads its results, round 2 at the tally, round 3 at truth.txt — so a
  // filing's reply tells the phone nothing. Trabolta never sees the answer
  // or the verdict: his thread gets the same words either way. Once the
  // night has ended the record is closed: no filing, no card, no judging.
  // The card dealt here is the current one, so the re-deal watcher below
  // has nothing to catch up (a program cleared late would get two cards).
  // A marked program files like anyone (wave 18, Q30: a mark does not
  // hinder; w13 Q35's "no card for a marked program" is superseded).
  when Night.round > self.fact_round and self.cleared and Trabolta.awake == true and Night.ended != true:
    set self.fact_round = Night.round
    set self.card_seen = Night.card_gen
    // One line per round, so a thread never shows the same words three times.
    if Night.round == 1:
      Trabolta: {self.name}. If you learn the answer to one of tonight's questions, file it with me on the card. Unfiled facts are rumours.
    else if Night.round == 2:
      Trabolta: Round two, {self.name}. New questions are in your Quest Log; the card is here.
    else:
      Trabolta: The last facts, {self.name}. File them here, before they turn into rumours.
    fire deal_fact_card for self

  // A round closed: every card re-deals without the closed questions. Not
  // gated on the night's end: truth.txt closes round 3 in the same drain a
  // Song Ending ends the night, and a live card must still be closed. An
  // ending closes the cards too (`when Night.ended == true` bumps the
  // generation): the server-room endings close no round, and Combo B puts
  // Trabolta to sleep, so the closing card is dealt without him awake.
  when Night.card_gen > self.card_seen and self.cleared and (Trabolta.awake == true or Night.ended == true):
    set self.card_seen = Night.card_gen
    fire deal_fact_card for self

  // Settle: round 1 one question at a time (📋 read_the_results), round 2
  // at the tally, round 3 at truth.txt.
  when Night.settle_gen > self.settle_seen and self.cleared == true:
    set self.settle_seen = Night.settle_gen
    if Night.settle_q == 1:
      fire settle_q1 for self
    else if Night.settle_q == 2:
      fire settle_q2 for self
    else if Night.settle_q == 3:
      fire settle_q3 for self
    else if Night.settle_round == 2:
      // Only a cup counts a round-2 filing, and never a marked program's.
      if self.marked == true or self.corrupted == true:
        set self.cupped = false
      fire settle_q4 for self
      fire settle_q5 for self
      fire settle_q6 for self
    else if Night.settle_round == 3:
      fire settle_q7 for self
      fire settle_q8 for self

  // The card lists every open question of every open round this program
  // hasn't filed yet (the play app folds every fact card but the newest in
  // the thread). The question strings are Night.q_h1 … Night.q_f2, set by
  // the generated `== Facts Seed` (generated/questions.loom, from facts.json).
  // DRAFT w18 (fix, recheck N5): the doors card answered, or the night
  // over with it still up: an ending deals a closing card that supersedes
  // it (the phone folds it to a note), so no Walk in is offered after the end.
  when sides answered for program:
    set program.sides_card_up = false
  when Night.ended == true and self.sides_card_up == true:
    set self.sides_card_up = false
    fire sides_card_closing for self
  when sides_card_closing for program:
    show sides "🚪 The doors have closed." to program with thread: Truther Download, closed: true

  when deal_fact_card for program:
    set program.fact_open = ""
    set program.fact_sep = ""
    // Once the night has ended nothing is open, but a live card still closes.
    if Night.ended != true and Night.round >= 1:
      if Night.r1_closed != true:
        if program.fact_h1 != true:
          set program.fact_open = program.fact_open + program.fact_sep + Night.q_h1
          set program.fact_sep = " | "
        if program.fact_h2 != true:
          set program.fact_open = program.fact_open + program.fact_sep + Night.q_h2
          set program.fact_sep = " | "
        if program.fact_h3 != true:
          set program.fact_open = program.fact_open + program.fact_sep + Night.q_h3
          set program.fact_sep = " | "
      if Night.round >= 2 and Night.r2_closed != true:
        if program.fact_h4 != true:
          set program.fact_open = program.fact_open + program.fact_sep + Night.q_h4
          set program.fact_sep = " | "
        if program.fact_h5 != true:
          set program.fact_open = program.fact_open + program.fact_sep + Night.q_h5
          set program.fact_sep = " | "
        if program.fact_h6 != true:
          set program.fact_open = program.fact_open + program.fact_sep + Night.q_h6
          set program.fact_sep = " | "
      if Night.round >= 3 and Night.r3_closed != true:
        if program.fact_f1 != true:
          set program.fact_open = program.fact_open + program.fact_sep + Night.q_f1
          set program.fact_sep = " | "
        if program.fact_f2 != true:
          set program.fact_open = program.fact_open + program.fact_sep + Night.q_f2
          set program.fact_sep = " | "
    if program.fact_open != "":
      set program.fact_card_live = true
      show fact "📝 File a fact" to program with thread: Trabolta, questions: program.fact_open
    else if program.fact_card_live == true:
      // A round closed under an unanswered card: a closing card with no
      // questions supersedes it (the phone folds it to a note), so the
      // closed questions never stay on the phone as a task.
      set program.fact_card_live = false
      show fact "📝 The filing is closed" to program with thread: Trabolta, questions: ""

  // `fact_try` / `fact_q_round` are scratch for this filing; the filing's
  // own record (`fact_n`, `fact_label`, `last_fact_q`, `fact_a/c/j/vN`) is
  // written only when it is accepted. `verdict`, `confidence` and (on an
  // accurate filing) `key_answer`, the key's canonical answer the
  // consensus read-out speaks, are the server's event args (a local rehearsal has no judge: no verdict, so
  // the filing is refused out loud in # hosts).
  when fact answered for program:
    // The card just answered is done on the phone: nothing live to close.
    set program.fact_card_live = false
    set program.fact_try = 0
    set program.fact_q_round = 0
    if question == "H1":
      set program.fact_try = 1
      set program.fact_q_round = 1
    else if question == "H2":
      set program.fact_try = 2
      set program.fact_q_round = 1
    else if question == "H3":
      set program.fact_try = 3
      set program.fact_q_round = 1
    else if question == "H4":
      set program.fact_try = 4
      set program.fact_q_round = 2
    else if question == "H5":
      set program.fact_try = 5
      set program.fact_q_round = 2
    else if question == "H6":
      set program.fact_try = 6
      set program.fact_q_round = 2
    else if question == "F1":
      set program.fact_try = 7
      set program.fact_q_round = 3
    else if question == "F2":
      set program.fact_try = 8
      set program.fact_q_round = 3
    if Night.ended == true:
      Trabolta: The record is closed, {program.name}. No more filings tonight.
    else if program.fact_try == 0 or confidence < 1 or confidence > 100:
      Trabolta: Pick one of tonight's questions, {program.name}, and tell me how sure you are.
    else if verdict != "accurate" and verdict != "lie" and verdict != "uncertain":
      broadcast "📝 {program.name}'s filing for {question} could not be judged (no facts.json on this server). Not recorded." to channel(hosts)
      Trabolta: I cannot read that filing right now, {program.name}. Try again in a moment.
    else if program.fact_q_round > Night.round:
      Trabolta: That question is not open yet, {program.name}. File what has been asked.
    else if (program.fact_q_round == 1 and Night.r1_closed == true) or (program.fact_q_round == 2 and Night.r2_closed == true) or (program.fact_q_round == 3 and Night.r3_closed == true):
      Trabolta: That round is closed, {program.name}. The question is gone.
    else if program.corrupted == true:
      Trabolta: Programs in the Internet cannot file facts. Come back reinstalled.
    else if (program.fact_try == 1 and program.fact_h1) or (program.fact_try == 2 and program.fact_h2) or (program.fact_try == 3 and program.fact_h3) or (program.fact_try == 4 and program.fact_h4) or (program.fact_try == 5 and program.fact_h5) or (program.fact_try == 6 and program.fact_h6) or (program.fact_try == 7 and program.fact_f1) or (program.fact_try == 8 and program.fact_f2):
      Trabolta: You already filed a fact for that question, {program.name}. It stands.
    else:
      set program.fact_n = program.fact_try
      set program.last_fact_q = question
      set program.fact_sure = "not certain"
      if confidence == 100:
        set program.fact_sure = "certain"
      if program.fact_n == 1:
        set program.fact_h1 = true
        set program.fact_label = "round 1 Q1"
        set program.fact_a1 = answer
        set program.fact_c1 = confidence
        set program.fact_j1 = verdict
        set Kernel.said_1 = Kernel.said_1 + program.name + " said " + answer + ", " + program.fact_sure + ". "
        if verdict == "accurate":
          set Kernel.ans_1 = key_answer
        if Night.judge_mode == "review":
          set program.fact_v1 = "pending"
        else:
          set program.fact_v1 = verdict
          fire verdict_q1 for program
      else if program.fact_n == 2:
        set program.fact_h2 = true
        set program.fact_label = "round 1 Q2"
        set program.fact_a2 = answer
        set program.fact_c2 = confidence
        set program.fact_j2 = verdict
        set Kernel.said_2 = Kernel.said_2 + program.name + " said " + answer + ", " + program.fact_sure + ". "
        if verdict == "accurate":
          set Kernel.ans_2 = key_answer
        if Night.judge_mode == "review":
          set program.fact_v2 = "pending"
        else:
          set program.fact_v2 = verdict
          fire verdict_q2 for program
      else if program.fact_n == 3:
        set program.fact_h3 = true
        set program.fact_label = "round 1 Q3"
        set program.fact_a3 = answer
        set program.fact_c3 = confidence
        set program.fact_j3 = verdict
        set Kernel.said_3 = Kernel.said_3 + program.name + " said " + answer + ", " + program.fact_sure + ". "
        if verdict == "accurate":
          set Kernel.ans_3 = key_answer
        if Night.judge_mode == "review":
          set program.fact_v3 = "pending"
        else:
          set program.fact_v3 = verdict
          fire verdict_q3 for program
      else if program.fact_n == 4:
        set program.fact_h4 = true
        set program.fact_label = "round 2 Q1"
        set program.fact_a4 = answer
        set program.fact_c4 = confidence
        set program.fact_j4 = verdict
        set Kernel.said_4 = Kernel.said_4 + program.name + " said " + answer + ", " + program.fact_sure + ". "
        if verdict == "accurate":
          set Kernel.ans_4 = key_answer
        if Night.judge_mode == "review":
          set program.fact_v4 = "pending"
        else:
          set program.fact_v4 = verdict
          fire verdict_q4 for program
      else if program.fact_n == 5:
        set program.fact_h5 = true
        set program.fact_label = "round 2 Q2"
        set program.fact_a5 = answer
        set program.fact_c5 = confidence
        set program.fact_j5 = verdict
        set Kernel.said_5 = Kernel.said_5 + program.name + " said " + answer + ", " + program.fact_sure + ". "
        if verdict == "accurate":
          set Kernel.ans_5 = key_answer
        if Night.judge_mode == "review":
          set program.fact_v5 = "pending"
        else:
          set program.fact_v5 = verdict
          fire verdict_q5 for program
      else if program.fact_n == 6:
        set program.fact_h6 = true
        set program.fact_label = "round 2 Q3"
        set program.fact_a6 = answer
        set program.fact_c6 = confidence
        set program.fact_j6 = verdict
        set Kernel.said_6 = Kernel.said_6 + program.name + " said " + answer + ", " + program.fact_sure + ". "
        if verdict == "accurate":
          set Kernel.ans_6 = key_answer
        if Night.judge_mode == "review":
          set program.fact_v6 = "pending"
        else:
          set program.fact_v6 = verdict
          fire verdict_q6 for program
      else if program.fact_n == 7:
        set program.fact_f1 = true
        set program.fact_label = "final Q1"
        set program.fact_a7 = answer
        set program.fact_c7 = confidence
        set program.fact_j7 = verdict
        set Kernel.said_7 = Kernel.said_7 + program.name + " said " + answer + ", " + program.fact_sure + ". "
        if verdict == "accurate":
          set Kernel.ans_7 = key_answer
        if Night.judge_mode == "review":
          set program.fact_v7 = "pending"
        else:
          set program.fact_v7 = verdict
          fire verdict_q7 for program
      else if program.fact_n == 8:
        set program.fact_f2 = true
        set program.fact_label = "final Q2"
        set program.fact_a8 = answer
        set program.fact_c8 = confidence
        set program.fact_j8 = verdict
        set Kernel.said_8 = Kernel.said_8 + program.name + " said " + answer + ", " + program.fact_sure + ". "
        if verdict == "accurate":
          set Kernel.ans_8 = key_answer
        if Night.judge_mode == "review":
          set program.fact_v8 = "pending"
        else:
          set program.fact_v8 = verdict
          fire verdict_q8 for program
      do fact_filed {program} {question} {confidence} {verdict} {answer}
      if Night.judge_mode == "review":
        broadcast "📝 {program.name} filed {question} ({program.fact_label}): {answer} — {program.fact_sure}. Proposed: {verdict}. Confirm on Run → Mind → Judging (their card's 📝 judges their latest filing only)." to channel(hosts)
      else:
        broadcast "📝 {program.name} filed {question} ({program.fact_label}): {answer} — {program.fact_sure}. Judged {verdict}." to channel(hosts)
      Trabolta: Filed for {program.fact_label}, {program.name}. Your fact is in the record.
    fire deal_fact_card for program

  // The verdict on the Kernel, told to the server's ledger. Fired at
  // filing (auto), at a host's confirmation or override (review, or a
  // mis-tap put right), or at settle (pending → the proposal). A lie is
  // sticky against OTHER programs: a later accurate filing never clears a
  // poisoned question. But each program's own lie is counted once
  // (`lie_qN`), and a host who corrects it takes it back: the lie count
  // drops and the question reads what the rest of the record says (any
  // other program's lie, or a lie Clippy accepted in the hunt —
  // `Kernel.qN_hunt` — keeps it a lie). Round 2's (q4–q6) reach the Kernel
  // only from the tally on, and only for a program that made the cup
  // (Truth Pong).
  when verdict_q1 for program:
    if program.fact_v1 == "lie":
      if program.lie_q1 != true:
        set program.lie_q1 = true
        // K-26 recap credits this to the last program write above it: keep one directly before.
        set Kernel.lies_accepted += 1
      set Kernel.q1 = "lie"
    else if program.lie_q1 == true:
      set program.lie_q1 = false
      set Kernel.lies_accepted -= 1
      if Kernel.q1_hunt == "lie" or count([p for p in Persons where p.lie_q1 == true]) > 0:
        set Kernel.q1 = "lie"
      else if Kernel.q1_hunt == "accurate" or count([p for p in Persons where p.fact_v1 == "accurate"]) > 0:
        set Kernel.q1 = "accurate"
      else:
        set Kernel.q1 = "none"
    else if program.fact_v1 == "accurate" and Kernel.q1 != "lie":
      set Kernel.q1 = "accurate"
    do fact_judged {program} H1 {program.fact_v1}

  when verdict_q2 for program:
    if program.fact_v2 == "lie":
      if program.lie_q2 != true:
        set program.lie_q2 = true
        // K-26 recap credits this to the last program write above it: keep one directly before.
        set Kernel.lies_accepted += 1
      set Kernel.q2 = "lie"
    else if program.lie_q2 == true:
      set program.lie_q2 = false
      set Kernel.lies_accepted -= 1
      if Kernel.q2_hunt == "lie" or count([p for p in Persons where p.lie_q2 == true]) > 0:
        set Kernel.q2 = "lie"
      else if Kernel.q2_hunt == "accurate" or count([p for p in Persons where p.fact_v2 == "accurate"]) > 0:
        set Kernel.q2 = "accurate"
      else:
        set Kernel.q2 = "none"
    else if program.fact_v2 == "accurate" and Kernel.q2 != "lie":
      set Kernel.q2 = "accurate"
    do fact_judged {program} H2 {program.fact_v2}

  when verdict_q3 for program:
    if program.fact_v3 == "lie":
      if program.lie_q3 != true:
        set program.lie_q3 = true
        // K-26 recap credits this to the last program write above it: keep one directly before.
        set Kernel.lies_accepted += 1
      set Kernel.q3 = "lie"
    else if program.lie_q3 == true:
      set program.lie_q3 = false
      set Kernel.lies_accepted -= 1
      if Kernel.q3_hunt == "lie" or count([p for p in Persons where p.lie_q3 == true]) > 0:
        set Kernel.q3 = "lie"
      else if Kernel.q3_hunt == "accurate" or count([p for p in Persons where p.fact_v3 == "accurate"]) > 0:
        set Kernel.q3 = "accurate"
      else:
        set Kernel.q3 = "none"
    else if program.fact_v3 == "accurate" and Kernel.q3 != "lie":
      set Kernel.q3 = "accurate"
    do fact_judged {program} H3 {program.fact_v3}

  when verdict_q4 for program:
    if Night.r2_closed == true and program.cupped == true:
      if program.fact_v4 == "lie":
        if program.lie_q4 != true:
          set program.lie_q4 = true
          // K-26 recap credits this to the last program write above it: keep one directly before.
          set Kernel.lies_accepted += 1
        set Kernel.q4 = "lie"
      else if program.lie_q4 == true:
        set program.lie_q4 = false
        set Kernel.lies_accepted -= 1
        if Kernel.q4_hunt == "lie" or count([p for p in Persons where p.lie_q4 == true]) > 0:
          set Kernel.q4 = "lie"
        else if Kernel.q4_hunt == "accurate" or count([p for p in Persons where p.fact_v4 == "accurate" and p.cupped == true]) > 0:
          set Kernel.q4 = "accurate"
        else:
          set Kernel.q4 = "none"
      else if program.fact_v4 == "accurate" and Kernel.q4 != "lie":
        set Kernel.q4 = "accurate"
    do fact_judged {program} H4 {program.fact_v4}

  when verdict_q5 for program:
    if Night.r2_closed == true and program.cupped == true:
      if program.fact_v5 == "lie":
        if program.lie_q5 != true:
          set program.lie_q5 = true
          // K-26 recap credits this to the last program write above it: keep one directly before.
          set Kernel.lies_accepted += 1
        set Kernel.q5 = "lie"
      else if program.lie_q5 == true:
        set program.lie_q5 = false
        set Kernel.lies_accepted -= 1
        if Kernel.q5_hunt == "lie" or count([p for p in Persons where p.lie_q5 == true]) > 0:
          set Kernel.q5 = "lie"
        else if Kernel.q5_hunt == "accurate" or count([p for p in Persons where p.fact_v5 == "accurate" and p.cupped == true]) > 0:
          set Kernel.q5 = "accurate"
        else:
          set Kernel.q5 = "none"
      else if program.fact_v5 == "accurate" and Kernel.q5 != "lie":
        set Kernel.q5 = "accurate"
    do fact_judged {program} H5 {program.fact_v5}

  when verdict_q6 for program:
    if Night.r2_closed == true and program.cupped == true:
      if program.fact_v6 == "lie":
        if program.lie_q6 != true:
          set program.lie_q6 = true
          // K-26 recap credits this to the last program write above it: keep one directly before.
          set Kernel.lies_accepted += 1
        set Kernel.q6 = "lie"
      else if program.lie_q6 == true:
        set program.lie_q6 = false
        set Kernel.lies_accepted -= 1
        if Kernel.q6_hunt == "lie" or count([p for p in Persons where p.lie_q6 == true]) > 0:
          set Kernel.q6 = "lie"
        else if Kernel.q6_hunt == "accurate" or count([p for p in Persons where p.fact_v6 == "accurate" and p.cupped == true]) > 0:
          set Kernel.q6 = "accurate"
        else:
          set Kernel.q6 = "none"
      else if program.fact_v6 == "accurate" and Kernel.q6 != "lie":
        set Kernel.q6 = "accurate"
    do fact_judged {program} H6 {program.fact_v6}

  when verdict_q7 for program:
    if program.fact_v7 == "lie":
      if program.lie_q7 != true:
        set program.lie_q7 = true
        // K-26 recap credits this to the last program write above it: keep one directly before.
        set Kernel.lies_accepted += 1
      set Kernel.q7 = "lie"
    else if program.lie_q7 == true:
      set program.lie_q7 = false
      set Kernel.lies_accepted -= 1
      if Kernel.q7_hunt == "lie" or count([p for p in Persons where p.lie_q7 == true]) > 0:
        set Kernel.q7 = "lie"
      else if Kernel.q7_hunt == "accurate" or count([p for p in Persons where p.fact_v7 == "accurate"]) > 0:
        set Kernel.q7 = "accurate"
      else:
        set Kernel.q7 = "none"
    else if program.fact_v7 == "accurate" and Kernel.q7 != "lie":
      set Kernel.q7 = "accurate"
    do fact_judged {program} F1 {program.fact_v7}

  when verdict_q8 for program:
    if program.fact_v8 == "lie":
      if program.lie_q8 != true:
        set program.lie_q8 = true
        // K-26 recap credits this to the last program write above it: keep one directly before.
        set Kernel.lies_accepted += 1
      set Kernel.q8 = "lie"
    else if program.lie_q8 == true:
      set program.lie_q8 = false
      set Kernel.lies_accepted -= 1
      if Kernel.q8_hunt == "lie" or count([p for p in Persons where p.lie_q8 == true]) > 0:
        set Kernel.q8 = "lie"
      else if Kernel.q8_hunt == "accurate" or count([p for p in Persons where p.fact_v8 == "accurate"]) > 0:
        set Kernel.q8 = "accurate"
      else:
        set Kernel.q8 = "none"
    else if program.fact_v8 == "accurate" and Kernel.q8 != "lie":
      set Kernel.q8 = "accurate"
    do fact_judged {program} F2 {program.fact_v8}

  // Settle: credit an accepted filing (accurate or a confident lie, the
  // same words), mark a guess. Round 1 per question (the results), round 2
  // at the tally, round 3 at truth.txt. A round-2 filing counts only if the
  // program made the cup (and isn't marked): otherwise it is settled
  // `marked`, not counted, and the program is told so.
  when settle_q1 for program:
    if program.fact_v1 == "pending":
      set program.fact_v1 = program.fact_j1
      fire verdict_q1 for program
    if program.fact_v1 == "accurate" or program.fact_v1 == "lie":
      fire fact_accepted for program with q: "H1", label: "round 1 Q1"
    else if program.fact_v1 == "uncertain" and (Night.phase == "truth_1" or Night.phase == "truth_pong"):
      set program.fact_v1 = "marked"
      broadcast "~🤷 {program.name} filed a guess for round 1 Q1. That is a symptom of corruption." to everyone
      do fact_judged {program} H1 marked
      fire mark_for_reinstallation for program with reason: "filed a guess for round 1 Q1"

  when settle_q2 for program:
    if program.fact_v2 == "pending":
      set program.fact_v2 = program.fact_j2
      fire verdict_q2 for program
    if program.fact_v2 == "accurate" or program.fact_v2 == "lie":
      fire fact_accepted for program with q: "H2", label: "round 1 Q2"
    else if program.fact_v2 == "uncertain" and (Night.phase == "truth_1" or Night.phase == "truth_pong"):
      set program.fact_v2 = "marked"
