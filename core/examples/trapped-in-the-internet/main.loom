  who: admin
  by: Clippy
  description: Only once the night has ended. Trabolta hosts; Clippy hosts after destroyed and rave, and reads every line aloud.
  while: Night.ended == true and Night.ceremony != true

INTERACTION award_most_trusted
  label: G2 · 🥇 Award: Most Trusted (winner = top trust)
  who: admin
  by: Clippy
  while: Night.ceremony == true

INTERACTION award_least_trusted
  label: G3 · 🫘 Award: Least Trusted (winner = bottom trust)
  who: admin
  by: Clippy
  while: Night.ceremony == true

INTERACTION award_frequent_flyer
  label: G4 · ✈️ Award: Frequent Flyer to the Internet (most visits)
  who: admin
  by: Clippy
  while: Night.ceremony == true

INTERACTION award_lore_hoarder
  label: G5 · 📚 Award: Lore Hoarder (most codex entries)
  who: admin
  by: Clippy
  while: Night.ceremony == true

INTERACTION award_truthcoin_tycoon
  label: G6 · 🪙 Award: Truthcoin Tycoon (most Truthcoin)
  who: admin
  by: Clippy
  while: Night.ceremony == true

INTERACTION award_best_liar
  label: G7 · 🎲 Bonus: Best Liar (value = lies accepted)
  who: admin
  by: Clippy
  while: Night.ceremony == true

INTERACTION award_duck_speedrun
  label: G8 · 🎲 Bonus: Golden Duck Speedrun (value = the time)
  who: admin
  by: Clippy
  while: Night.ceremony == true

INTERACTION award_quest_completionist
  label: G9 · 🎲 Bonus: Quest Completionist (value = quests done)
  who: admin
