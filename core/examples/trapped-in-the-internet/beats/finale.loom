// The lies stay on the record: each question's truth goes to the screens' data
// (`do fact_truth`) and his dossiers, in silence. It is not the old TV verdict:
// nothing here plays a page or decides an ending.
== Verdict Record
  setting: The Desktop
set Kernel.t1 = Kernel.q1
if count([p for p in Persons where p.fact_v1 == "pending" and p.fact_j1 == "lie"]) > 0:
  set Kernel.t1 = "lie"
set Kernel.t2 = Kernel.q2
if count([p for p in Persons where p.fact_v2 == "pending" and p.fact_j2 == "lie"]) > 0:
  set Kernel.t2 = "lie"
set Kernel.t3 = Kernel.q3
if count([p for p in Persons where p.fact_v3 == "pending" and p.fact_j3 == "lie"]) > 0:
  set Kernel.t3 = "lie"
set Kernel.t4 = Kernel.q4
if count([p for p in Persons where p.fact_v4 == "pending" and p.fact_j4 == "lie"]) > 0:
  set Kernel.t4 = "lie"
set Kernel.t5 = Kernel.q5
if count([p for p in Persons where p.fact_v5 == "pending" and p.fact_j5 == "lie"]) > 0:
  set Kernel.t5 = "lie"
set Kernel.t6 = Kernel.q6
if count([p for p in Persons where p.fact_v6 == "pending" and p.fact_j6 == "lie"]) > 0:
  set Kernel.t6 = "lie"
set Kernel.t7 = Kernel.q7
if count([p for p in Persons where p.fact_v7 == "pending" and p.fact_j7 == "lie"]) > 0:
  set Kernel.t7 = "lie"
set Kernel.t8 = Kernel.q8
if count([p for p in Persons where p.fact_v8 == "pending" and p.fact_j8 == "lie"]) > 0:
  set Kernel.t8 = "lie"
set Kernel.t9 = Kernel.q9
if count([p for p in Persons where p.fact_v9 == "pending" and p.fact_j9 == "lie"]) > 0:
