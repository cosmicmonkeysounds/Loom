  // on, by category (the handouts and the ties never count).
  set program.dossier_base = program.codex_in.facts + program.codex_in.files + program.codex_in.people + program.codex_in.trabolta + program.codex_in.places
else if program.featured == "draftkings":
  unlock Crab Fisherwoman for program
  unlock The Coin Toss Of The Century for program
  unlock Forty Nine Percent for program
else if program.featured == "bugdom":
  unlock Bea Nunes for program
  unlock The Ants In The Laptop for program
  unlock A Hundred Hours for program
else if program.featured == "jeeves":
  The Uploader (glitch): Restoring… restor… r3st0r1ng… 404.
  unlock Virgil Jeeves for program
  unlock The Jeopardy Callback for program
  unlock Ten Findings For Everyone for program
  start quest Ten Findings for program "0 programs have ten of your findings."
else if program.featured == "runescape":
  unlock Poppy Van Mises for program
  unlock Infinite Gold for program
  unlock Minister Of Economic Development for program
else if program.featured == "mspaint":
