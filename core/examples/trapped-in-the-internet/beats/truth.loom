if Night.ending == "disabled":
  // DRAFT w58 (a message he left just before he died)
  Task Manager: This message was recorded by Jean Trabolta shortly before he died.
  // DRAFT w58
  Task Manager: He left instructions that it be read aloud to the whole house, exactly as it is written. I manage tasks. This is a task.
else if Night.ending == "destroyed":
  // DRAFT w58 (the same, fitted to the computer going down)
  Task Manager: The computer is off. This message is the last thing it saved.
  // DRAFT w58
  Task Manager: Jean Trabolta recorded it to be read aloud to the whole house if the power ever went, exactly as it is written. I manage tasks. This is a task.
else:
