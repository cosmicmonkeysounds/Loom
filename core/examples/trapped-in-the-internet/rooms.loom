// Chat rooms — the sidebar the phones show. Every LOCATION is already a
// room (what happens in the Start Bar is heard in the Start Bar); these are the
// extras: an open channel, three rooms that open
// as the night escalates, the staff back-rooms, the two recruiting
// factions' rooms, and two invite-only rooms for scheming.
//
// `# hosts` and `# quarantine` are STAFF BACK-ROOMS, not secrets: every
// performer booth sees and can post in every authored channel, and no
// guest can (faction membership holds guest programs only). Never put
// anything there meant for one faction's eyes.
// So every booth sees `# quarantine`'s escort pins (no `!`: they never
// chime; the Antivirus cue is the Enforcer readout in cast/kit.loom).
// `# unlimited-power` / `# the-way-out` are the guest factions' own rooms
// (members only); the factions are hidden until the Y2K clock.

SPACE The Operating System
  label: The Operating System

  // No read-only system feed (wave 13, D11): the lobby, titled after the
  // story, is the one home of every house-wide broadcast, so an alert posts
  // (and pushes) once.

  CHANNEL general
    kind: open
    label: # general

  // Opens for each program at Clearance (cast/kit.loom): the app help
  // desk. Task Manager answers here and in his thread — from his phone,
  // or the director from Run as him.
  CHANNEL task manager
    kind: open
    label: # task-manager
    slow: 5s
    hidden: true

  // A disappearing side-channel — one post per 3s, gone after 45s. Opens
  // at the second hunt (start_the_second_hunt), when everyone disperses.
  CHANNEL clipboard
    kind: open
    label: # clipboard
    slow: 3s
    ephemeral: 45s
    hidden: true

  // Facts for Truthcoin. Opens with the Truther Download; McAfee
  // Anti-Virus brokers the trades (and takes his cut).
  CHANNEL truthcoin exchange
    kind: open
    label: # truthcoin-exchange
    slow: 3s
    hidden: true

CHANNEL hosts
  space: The Operating System
  kind: faction
  faction: Hosts
  label: # hosts

CHANNEL quarantine
  space: The Operating System
  kind: faction
  faction: Antivirus
  label: # quarantine

CHANNEL unlimited power
  space: The Operating System
  kind: faction
  faction: Unlimited Power
  label: # unlimited-power

CHANNEL the way out
  space: The Operating System
  kind: faction
  faction: The Way Out
  label: # the-way-out

// Invite-only rooms programs can pull each other into. Password Manager
// keeps the club list.
CHANNEL hidden partition
  space: The Operating System
  kind: private
  invite: members
  label: # hidden-partition

CHANNEL back channel
  space: The Operating System
  kind: private
  invite: members
  label: # back-channel
